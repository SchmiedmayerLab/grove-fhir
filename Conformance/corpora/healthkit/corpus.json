{
  "schemaVersion": 1,
  "bases": [
    {"id": "healthkit-heart-rate", "path": "bases/heart-rate.json"},
    {"id": "healthkit-heart-rate-conversion-provenance", "path": "bases/heart-rate-conversion-provenance.json"}
  ],
  "cases": [
    {
      "id": "healthkit-object-id-lowercase-uuid",
      "base": "healthkit-heart-rate",
      "patch": [{"op": "replace", "path": "/identifier/0/value", "value": "1E091E2A-9F3E-49CD-B237-2EF5A3D0F213"}],
      "expectedRule": {
        "code": "healthkit-object-id-1",
        "reason": "A HealthKit object identifier value is lowercase UUID text in 8-4-4-4-12 hyphenated form.",
        "location": "Observation.identifier[0]",
        "severity": "error"
      }
    },
    {
      "id": "healthkit-primary-result-required",
      "base": "healthkit-heart-rate",
      "patch": [{"op": "remove", "path": "/valueQuantity"}],
      "expectedRule": {
        "code": "healthkit-primary-result-1",
        "reason": "A HealthKit Observation has a primary quantity result or a reason why that result is absent. Metadata components do not satisfy this rule.",
        "location": "Observation",
        "severity": "error"
      }
    },
    {
      "id": "healthkit-motion-context-heart-rate-only",
      "base": "healthkit-heart-rate",
      "patch": [{"op": "replace", "path": "/code/coding/0/code", "value": "29463-7"}],
      "expectedRule": {
        "code": "healthkit-motion-context-1",
        "reason": "Heart-rate motion context is present only on an Observation coded with LOINC 8867-4.",
        "location": "Observation",
        "severity": "error"
      }
    },
    {
      "id": "healthkit-object-identifier-required",
      "base": "healthkit-heart-rate",
      "patch": [{"op": "remove", "path": "/identifier"}],
      "expectedRule": {
        "code": "healthkit-observation.identifier",
        "reason": "A HealthKit Observation carries exactly one HealthKit object identifier slice.",
        "location": "Observation.identifier",
        "severity": "error"
      }
    },
    {
      "id": "healthkit-object-identifier-limit",
      "base": "healthkit-heart-rate",
      "patch": [{"op": "copy", "from": "/identifier/0", "path": "/identifier/-"}],
      "expectedRule": {
        "code": "healthkit-observation.identifier.max",
        "reason": "A HealthKit Observation carries exactly one HealthKit object identifier slice.",
        "location": "Observation.identifier",
        "severity": "error"
      }
    },
    {
      "id": "healthkit-object-identifier-system",
      "base": "healthkit-heart-rate",
      "patch": [{"op": "replace", "path": "/identifier/0/system", "value": "https://example.org/wrong-system"}],
      "expectedRule": {
        "code": "healthkit-observation.identifier.system",
        "reason": "The required HealthKit object identifier uses the HealthKit object-id NamingSystem URI.",
        "location": "Observation.identifier",
        "severity": "error"
      }
    },
    {
      "id": "healthkit-object-identifier-value-required",
      "base": "healthkit-heart-rate",
      "patch": [{"op": "remove", "path": "/identifier/0/value"}],
      "expectedRule": {
        "code": "healthkit-object-identifier.value",
        "reason": "The required HealthKit object identifier carries its UUID value.",
        "location": "Observation.identifier[0].value",
        "severity": "error"
      }
    },
    {
      "id": "healthkit-value-quantity-only",
      "base": "healthkit-heart-rate",
      "patch": [{"op": "move", "from": "/valueQuantity", "path": "/valueString"}],
      "expectedRule": {
        "code": "healthkit-observation.value.quantity",
        "reason": "A HealthKit Observation represents its primary result as a Quantity.",
        "location": "Observation.value[x]",
        "severity": "error"
      }
    },
    {
      "id": "healthkit-motion-code-fixed",
      "base": "healthkit-heart-rate",
      "patch": [{"op": "replace", "path": "/component/0/code/coding/0/code", "value": "OtherMetadataKey"}],
      "expectedRule": {
        "code": "healthkit-metadata-key.code",
        "reason": "A code asserted in the HealthKit metadata-key CodeSystem is defined by that CodeSystem.",
        "location": "Observation.component[0].code",
        "severity": "error"
      }
    },
    {
      "id": "healthkit-motion-value-required",
      "base": "healthkit-heart-rate",
      "patch": [{"op": "remove", "path": "/component/0/valueCodeableConcept"}],
      "expectedRule": {
        "code": "healthkit-observation.motion-context.value",
        "reason": "The motion-context component carries exactly one CodeableConcept value.",
        "location": "Observation.component[0].value[x]",
        "severity": "error"
      }
    },
    {
      "id": "healthkit-motion-value-code-required-binding",
      "base": "healthkit-heart-rate",
      "patch": [{"op": "replace", "path": "/component/0/valueCodeableConcept/coding/0/code", "value": "unknown"}],
      "expectedRule": {
        "code": "healthkit-observation.motion-context.binding",
        "reason": "The motion-context value is drawn from the required HealthKit heart-rate motion-context value set.",
        "location": "Observation.component[0].valueCodeableConcept",
        "severity": "error"
      }
    },
    {
      "id": "healthkit-motion-value-codeable-concept-only",
      "base": "healthkit-heart-rate",
      "patch": [{"op": "replace", "path": "/component/0", "value": {"code": {"coding": [{"system": "https://schmiedmayerlab.github.io/grove-fhir/fhir/healthkit/CodeSystem/healthkit-metadata-key", "code": "HKMetadataKeyHeartRateMotionContext"}]}, "valueString": "sedentary"}}],
      "expectedRule": {
        "code": "healthkit-observation.motion-context.value.type",
        "reason": "The motion-context component value is a CodeableConcept.",
        "location": "Observation.component[0].value[x]",
        "severity": "error"
      }
    },
    {
      "id": "healthkit-motion-data-absent-prohibited",
      "base": "healthkit-heart-rate",
      "patch": [{"op": "add", "path": "/component/0/dataAbsentReason", "value": {"coding": [{"system": "http://terminology.hl7.org/CodeSystem/data-absent-reason", "code": "unknown"}]}}],
      "expectedRule": {
        "code": "healthkit-observation.motion-context.data-absent-reason",
        "reason": "A present HealthKit motion-context component does not carry dataAbsentReason.",
        "location": "Observation.component[0].dataAbsentReason",
        "severity": "error"
      }
    },
    {
      "id": "healthkit-motion-context-limit",
      "base": "healthkit-heart-rate",
      "patch": [{"op": "copy", "from": "/component/0", "path": "/component/-"}],
      "expectedRule": {
        "code": "healthkit-observation.motion-context.max",
        "reason": "A HealthKit Observation carries at most one heart-rate motion-context component.",
        "location": "Observation.component",
        "severity": "error"
      }
    }
  ]
}
