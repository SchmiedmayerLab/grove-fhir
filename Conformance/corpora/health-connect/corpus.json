        "location": "Observation.identifier",
        "severity": "error"
      }
    },
    {
      "id": "health-connect-record-identifier-limit",
      "base": "health-connect-heart-rate",
      "patch": [{"op": "copy", "from": "/identifier/0", "path": "/identifier/-"}],
