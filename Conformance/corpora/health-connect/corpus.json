      "base": "health-connect-heart-rate",
      "patch": [{"op": "add", "path": "/dataAbsentReason", "value": {"coding": [{"system": "http://terminology.hl7.org/CodeSystem/data-absent-reason", "code": "unknown"}]}}],
      "expectedRule": {
        "code": "health-connect-observation.data-absent-reason",
