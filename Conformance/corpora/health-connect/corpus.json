  "cases": [
    {
      "id": "health-connect-output-id-format",
      "base": "health-connect-heart-rate",
      "patch": [{"op": "replace", "path": "/identifier/1/value", "value": "a88b6d9b3483f39ff951423556714f70ecb62c28a26aa75432aa2f81f7e3377b"}],
      "expectedRule": {
        "code": "health-connect-output-id-1",
        "reason": "The Health Connect output identifier uses the versioned lowercase SHA-256 form defined by this guide.",
        "location": "Observation",
        "severity": "error"
      }
    },
    {
      "id": "health-connect-record-id-format",
      "base": "health-connect-heart-rate",
      "patch": [{"op": "replace", "path": "/identifier/0/value", "value": "v1:5D81FD22DF74BCB7D9571B201CADF87B3935072C126DFFBC2AF908D994D054A2"}],
      "expectedRule": {
        "code": "health-connect-record-id-value-1",
        "reason": "The Health Connect record identifier uses the repository-scoped lowercase SHA-256 form defined by this guide.",
        "location": "Observation.identifier[0].value",
        "severity": "error"
      }
    },
    {
      "id": "health-connect-record-identifier-required",
      "base": "health-connect-heart-rate",
      "patch": [{"op": "remove", "path": "/identifier/0"}],
      "expectedRule": {
        "code": "health-connect-observation.record-id",
        "reason": "A Health Connect Observation carries exactly one source Record Identifier slice.",
        "location": "Observation.identifier",
        "severity": "error"
      }
    },
    {
      "id": "health-connect-output-identifier-required",
      "base": "health-connect-heart-rate",
      "patch": [{"op": "remove", "path": "/identifier/1"}],
      "expectedRule": {
        "code": "health-connect-observation.output-id",
