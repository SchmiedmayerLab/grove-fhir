{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schmiedmayerlab.github.io/grove-fhir/Conformance/evidence.schema.json",
  "title": "Grove FHIR conformance evidence contracts",
  "oneOf": [
    {"$ref": "#/$defs/evidenceManifest"},
    {"$ref": "#/$defs/toolchainManifest"},
    {"$ref": "#/$defs/evidenceLock"},
    {"$ref": "#/$defs/semanticBaseline"}
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "fullCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "httpsUrl": {
      "type": "string",
      "pattern": "^https://[^\\s]+$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[A-Za-z0-9._/-]+$"
    },
    "pathPattern": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[A-Za-z0-9._*/?-]+$"
    },
    "pathPatternList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/pathPattern"}
    },
    "nonemptyString": {
      "type": "string",
      "minLength": 1
    },
    "packageDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packageId", "version"],
      "properties": {
        "packageId": {"type": "string", "pattern": "^[A-Za-z0-9.-]+$"},
        "version": {"$ref": "#/$defs/nonemptyString"}
      }
    },
    "guide": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source",
        "package",
        "packageId",
        "version",
        "fhirVersion",
        "canonical",
        "structureDefinitions",
        "dependencies"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "source": {"$ref": "#/$defs/relativePath"},
        "package": {"$ref": "#/$defs/relativePath"},
        "packageId": {"type": "string", "pattern": "^[A-Za-z0-9.-]+$"},
        "version": {"$ref": "#/$defs/nonemptyString"},
        "fhirVersion": {"$ref": "#/$defs/nonemptyString"},
        "canonical": {"$ref": "#/$defs/httpsUrl"},
        "structureDefinitions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/httpsUrl"}
        },
        "dependencies": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/packageDependency"}
        }
      }
    },
    "corpus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "root", "manifest", "format", "packageIds", "purpose"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "root": {"$ref": "#/$defs/relativePath"},
        "manifest": {"$ref": "#/$defs/relativePath"},
        "format": {"$ref": "#/$defs/identifier"},
        "packageIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Za-z0-9.-]+$"}
        },
        "purpose": {"$ref": "#/$defs/nonemptyString"}
      }
    },
    "validationReport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "mediaType", "format", "producer", "purpose"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "path": {"$ref": "#/$defs/relativePath"},
        "mediaType": {"const": "application/json"},
        "format": {"const": "domain-fhir-validation-v1"},
        "producer": {"$ref": "#/$defs/relativePath"},
        "purpose": {"$ref": "#/$defs/nonemptyString"}
      }
    },
    "externalEvidenceFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "mediaType", "format"],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"},
        "mediaType": {
          "enum": ["application/fhir+json", "application/json"]
        },
        "format": {
          "enum": ["fhir-json", "test-attestation-v1"]
        },
        "testGroup": {"$ref": "#/$defs/identifier"},
        "attestationInputs": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/externalEvidenceInput"}
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"format": {"const": "test-attestation-v1"}},
            "required": ["format"]
          },
          "then": {
            "properties": {
              "mediaType": {"const": "application/json"},
              "testGroup": {"type": "string"},
              "attestationInputs": {"type": "array"}
            },
            "required": ["testGroup", "attestationInputs"]
          },
          "else": {
            "properties": {"mediaType": {"const": "application/fhir+json"}},
            "not": {
              "anyOf": [
                {"required": ["testGroup"]},
                {"required": ["attestationInputs"]}
              ]
            }
          }
        }
      ]
    },
    "externalEvidenceInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "evidenceSet", "path"],
      "properties": {
        "name": {"$ref": "#/$defs/identifier"},
        "evidenceSet": {"$ref": "#/$defs/identifier"},
        "path": {"$ref": "#/$defs/relativePath"}
      }
    },
    "expectedUnknownExtension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "expression", "url", "valueField"],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"},
        "expression": {"$ref": "#/$defs/nonemptyString"},
        "url": {"$ref": "#/$defs/httpsUrl"},
        "valueField": {
          "type": "string",
          "pattern": "^(extension|value[A-Z][A-Za-z0-9]*)$"
        }
      }
    },
    "externalEvidenceSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "implementation",
        "source",
        "proposals",
        "classification",
        "kind",
        "files",
        "purpose"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "implementation": {"$ref": "#/$defs/identifier"},
        "source": {"$ref": "#/$defs/identifier"},
        "proposals": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        },
        "classification": {
          "enum": ["accepted-contract", "historical-writer", "legacy-candidate"]
        },
        "kind": {"enum": ["file", "directory"]},
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/externalEvidenceFile"}
        },
        "expectedUnknownExtensions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/expectedUnknownExtension"}
        },
        "purpose": {"$ref": "#/$defs/nonemptyString"}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "file"}}},
          "then": {"properties": {"files": {"type": "array", "maxItems": 1}}}
        },
        {
          "if": {
            "properties": {
              "classification": {
                "enum": ["historical-writer", "legacy-candidate"]
              }
            },
            "required": ["classification"]
          },
          "then": {
            "properties": {"expectedUnknownExtensions": {"type": "array"}},
            "required": ["expectedUnknownExtensions"]
          },
          "else": {"properties": {"expectedUnknownExtensions": false}}
        }
      ]
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "proposal", "entrypoint"],
      "properties": {
        "type": {"const": "integration-proposal"},
        "proposal": {"$ref": "#/$defs/identifier"},
        "entrypoint": {"$ref": "#/$defs/relativePath"}
      }
    },
    "normalization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "deterministic", "volatileFields"],
      "properties": {
        "policy": {"$ref": "#/$defs/nonemptyString"},
        "deterministic": {"type": "boolean"},
        "volatileFields": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/nonemptyString"}
        }
      }
    },
    "nestedGitlink": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "repository", "commit", "purpose"],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"},
        "repository": {"$ref": "#/$defs/httpsUrl"},
        "commit": {"$ref": "#/$defs/fullCommit"},
        "purpose": {"$ref": "#/$defs/nonemptyString"}
      }
    },
    "resolvedPackage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest", "identity", "repository", "version", "revision"],
      "properties": {
        "manifest": {"$ref": "#/$defs/relativePath"},
        "identity": {"$ref": "#/$defs/nonemptyString"},
        "repository": {"$ref": "#/$defs/httpsUrl"},
        "version": {"$ref": "#/$defs/nonemptyString"},
        "revision": {"$ref": "#/$defs/fullCommit"}
      }
    },
    "implementationProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nestedGitlinks", "resolvedPackages"],
      "properties": {
        "nestedGitlinks": {
          "type": "array",
          "items": {"$ref": "#/$defs/nestedGitlink"}
        },
        "resolvedPackages": {
          "type": "array",
          "items": {"$ref": "#/$defs/resolvedPackage"}
        }
      }
    },
    "implementationEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source",
        "repository",
        "commit",
        "status",
        "classification",
        "direction",
        "packages",
        "profiles",
        "generator",
        "normalization",
        "provenance",
        "purpose"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "source": {"$ref": "#/$defs/identifier"},
        "repository": {"$ref": "#/$defs/httpsUrl"},
        "commit": {"$ref": "#/$defs/fullCommit"},
        "status": {"enum": ["active", "pinned-reference", "inactive-reference"]},
        "classification": {
          "enum": [
            "accepted-contract",
            "historical-writer",
            "legacy-candidate",
            "inactive-reference",
            "dependency-pin"
          ]
        },
        "direction": {"enum": ["produce", "consume", "round-trip", "reference"]},
        "packages": {
          "description": "For produce and round-trip evidence only, the exact set of guides owning the exercised StructureDefinition closure; consume and reference entries must be empty.",
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        },
        "profiles": {
          "description": "For produce and round-trip evidence only, the exact owned StructureDefinition closure exercised through meta.profile, owned Extension URLs, and transitive owned baseDefinition links; consume and reference entries must be empty.",
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/httpsUrl"}
        },
        "generator": {
          "oneOf": [
            {"$ref": "#/$defs/generator"},
            {"type": "null"}
          ]
        },
        "normalization": {"$ref": "#/$defs/normalization"},
        "provenance": {"$ref": "#/$defs/implementationProvenance"},
        "studyRevision": {"type": "integer", "minimum": 0},
        "purpose": {"$ref": "#/$defs/nonemptyString"}
      }
    },
    "evidenceManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "schemaVersion",
        "repository",
        "toolchain",
        "integrationSources",
        "publicationConfig",
        "artifactAllowlist",
        "semanticBaseline",
        "trackedInputs",
        "trackedInputRoots",
        "guides",
        "corpora",
        "validationReports",
        "externalEvidence",
        "implementations",
        "pathMatrix",
        "pathMatrixIgnored"
      ],
      "properties": {
        "kind": {"const": "grove-fhir-conformance-evidence"},
        "schemaVersion": {"const": 1},
        "repository": {"$ref": "#/$defs/httpsUrl"},
        "toolchain": {"$ref": "#/$defs/relativePath"},
        "integrationSources": {"$ref": "#/$defs/relativePath"},
        "publicationConfig": {"$ref": "#/$defs/relativePath"},
        "artifactAllowlist": {"$ref": "#/$defs/relativePath"},
        "semanticBaseline": {"$ref": "#/$defs/relativePath"},
        "trackedInputs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/relativePath"}
        },
        "trackedInputRoots": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/relativePath"}
        },
        "guides": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/guide"}
        },
        "corpora": {
          "type": "array",
          "items": {"$ref": "#/$defs/corpus"}
        },
        "validationReports": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/validationReport"}
        },
        "externalEvidence": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/externalEvidenceSet"}
        },
        "implementations": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/implementationEvidence"}
        },
        "pathMatrix": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "grove_questionnaire",
            "grove_mobile",
            "mhc_ios_study",
            "android",
            "firebase",
            "evidence_common"
          ],
          "properties": {
            "grove_questionnaire": {"$ref": "#/$defs/pathPatternList"},
            "grove_mobile": {"$ref": "#/$defs/pathPatternList"},
            "mhc_ios_study": {"$ref": "#/$defs/pathPatternList"},
            "android": {"$ref": "#/$defs/pathPatternList"},
            "firebase": {"$ref": "#/$defs/pathPatternList"},
            "evidence_common": {"$ref": "#/$defs/pathPatternList"}
          }
        },
        "pathMatrixIgnored": {
          "$ref": "#/$defs/pathPatternList"
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "precision"],
      "properties": {
        "version": {"$ref": "#/$defs/nonemptyString"},
        "setupVersion": {"$ref": "#/$defs/nonemptyString"},
        "precision": {"enum": ["exact", "major-minor"]},
        "distribution": {"$ref": "#/$defs/nonemptyString"}
      }
    },
    "toolArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "version", "url", "sha256"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
        "kind": {"enum": ["jar", "fhir-package", "fhir-template"]},
        "version": {"$ref": "#/$defs/nonemptyString"},
        "url": {"$ref": "#/$defs/httpsUrl"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "languagePackage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"$ref": "#/$defs/nonemptyString"},
        "version": {"$ref": "#/$defs/nonemptyString"}
      }
    },
    "toolchainManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "schemaVersion",
        "runtimes",
        "npmPackages",
        "rubyPackages",
        "artifacts"
      ],
      "properties": {
        "kind": {"const": "grove-fhir-toolchain"},
        "schemaVersion": {"const": 1},
        "runtimes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["node", "npm", "python", "java", "ruby", "bundler"],
          "properties": {
            "node": {"$ref": "#/$defs/runtime"},
            "npm": {"$ref": "#/$defs/runtime"},
            "python": {"$ref": "#/$defs/runtime"},
            "java": {
              "allOf": [
                {"$ref": "#/$defs/runtime"},
                {
                  "type": "object",
                  "properties": {
                    "setupVersion": {"$ref": "#/$defs/nonemptyString"},
                    "distribution": {"$ref": "#/$defs/nonemptyString"}
                  },
                  "required": ["setupVersion", "distribution"]
                }
              ]
            },
            "ruby": {"$ref": "#/$defs/runtime"},
            "bundler": {"$ref": "#/$defs/runtime"}
          }
        },
        "npmPackages": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/languagePackage"}
        },
        "rubyPackages": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/languagePackage"}
        },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/toolArtifact"}
        }
      }
    },
    "hashedPath": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size": {"type": "integer", "minimum": 0}
      }
    },
    "lockedProposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source",
        "path",
        "expectedSha256",
        "sha256",
        "dependsOn",
        "appliesAfter",
        "transitiveSha256"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "source": {"$ref": "#/$defs/identifier"},
        "path": {"$ref": "#/$defs/relativePath"},
        "expectedSha256": {"$ref": "#/$defs/sha256"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "dependsOn": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        },
        "appliesAfter": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        },
        "transitiveSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "lockedGitlink": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "repository",
        "expectedCommit",
        "indexCommit",
        "transitiveSha256"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "path": {"$ref": "#/$defs/relativePath"},
        "repository": {"$ref": "#/$defs/httpsUrl"},
        "expectedCommit": {"$ref": "#/$defs/fullCommit"},
        "indexCommit": {"$ref": "#/$defs/fullCommit"},
        "transitiveSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "lockedResolvedPackage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implementation",
        "source",
        "path",
        "identity",
        "repository",
        "version",
        "revision",
        "sha256",
        "transitiveSha256"
      ],
      "properties": {
        "implementation": {"$ref": "#/$defs/identifier"},
        "source": {"$ref": "#/$defs/identifier"},
        "path": {"$ref": "#/$defs/relativePath"},
        "identity": {"$ref": "#/$defs/nonemptyString"},
        "repository": {"$ref": "#/$defs/httpsUrl"},
        "version": {"$ref": "#/$defs/nonemptyString"},
        "revision": {"$ref": "#/$defs/fullCommit"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "transitiveSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "lockedDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packageId",
        "version",
        "kind",
        "sha256",
        "transitiveSha256"
      ],
      "properties": {
        "packageId": {"type": "string", "pattern": "^[A-Za-z0-9.-]+$"},
        "version": {"$ref": "#/$defs/nonemptyString"},
        "kind": {"enum": ["internal", "external"]},
        "sha256": {"$ref": "#/$defs/sha256"},
        "transitiveSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "lockedPackage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source",
        "declaredPath",
        "inputMode",
        "path",
        "packageId",
        "version",
        "canonical",
        "fhirVersion",
        "sha256",
        "size",
        "semanticSnapshot",
        "semanticSha256",
        "dependencies",
        "transitiveSha256"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "source": {"$ref": "#/$defs/relativePath"},
        "declaredPath": {"$ref": "#/$defs/relativePath"},
        "inputMode": {"enum": ["declared", "override"]},
        "path": {"$ref": "#/$defs/relativePath"},
        "packageId": {"type": "string", "pattern": "^[A-Za-z0-9.-]+$"},
        "version": {"$ref": "#/$defs/nonemptyString"},
        "canonical": {"$ref": "#/$defs/httpsUrl"},
        "fhirVersion": {"$ref": "#/$defs/nonemptyString"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size": {"type": "integer", "minimum": 1},
        "semanticSnapshot": {"$ref": "#/$defs/relativePath"},
        "semanticSha256": {"$ref": "#/$defs/sha256"},
        "dependencies": {
          "type": "array",
          "items": {"$ref": "#/$defs/lockedDependency"}
        },
        "transitiveSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "lockedCorpus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "format",
        "packageIds",
        "files",
        "sha256",
        "transitiveSha256"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "path": {"$ref": "#/$defs/relativePath"},
        "format": {"$ref": "#/$defs/identifier"},
        "packageIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Za-z0-9.-]+$"}
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/hashedPath"}
        },
        "sha256": {"$ref": "#/$defs/sha256"},
        "transitiveSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "lockedRuntime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "command",
        "declaredVersion",
        "precision",
        "version",
        "canonicalOutput",
        "transitiveSha256"
      ],
      "properties": {
        "id": {"enum": ["node", "npm", "python", "java", "ruby", "bundler"]},
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/nonemptyString"}
        },
        "declaredVersion": {"$ref": "#/$defs/nonemptyString"},
        "setupVersion": {"$ref": "#/$defs/nonemptyString"},
        "precision": {"enum": ["exact", "major-minor"]},
        "version": {"$ref": "#/$defs/nonemptyString"},
        "distribution": {"$ref": "#/$defs/nonemptyString"},
        "vendor": {"$ref": "#/$defs/nonemptyString"},
        "zlibVersion": {"$ref": "#/$defs/nonemptyString"},
        "canonicalOutput": {"$ref": "#/$defs/nonemptyString"},
        "transitiveSha256": {"$ref": "#/$defs/sha256"}
      },
      "allOf": [
        {
          "if": {"properties": {"id": {"const": "python"}}, "required": ["id"]},
          "then": {
            "properties": {"zlibVersion": {"$ref": "#/$defs/nonemptyString"}},
            "required": ["zlibVersion"]
          },
          "else": {"not": {"required": ["zlibVersion"]}}
        },
        {
          "if": {"properties": {"id": {"const": "java"}}, "required": ["id"]},
          "then": {
            "properties": {"setupVersion": {"$ref": "#/$defs/nonemptyString"}},
            "required": ["setupVersion"]
          },
          "else": {"not": {"required": ["setupVersion"]}}
        }
      ]
    },
    "lockedToolArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "version",
        "url",
        "path",
        "declaredSha256",
        "sha256",
        "size",
        "transitiveSha256"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
        "kind": {"enum": ["jar", "fhir-package", "fhir-template"]},
        "version": {"$ref": "#/$defs/nonemptyString"},
        "url": {"$ref": "#/$defs/httpsUrl"},
        "path": {"$ref": "#/$defs/relativePath"},
        "declaredSha256": {"$ref": "#/$defs/sha256"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size": {"type": "integer", "minimum": 1},
        "packageId": {"type": "string", "pattern": "^[A-Za-z0-9.-]+$"},
        "packageVersion": {"$ref": "#/$defs/nonemptyString"},
        "packageType": {"const": "fhir.template"},
        "transitiveSha256": {"$ref": "#/$defs/sha256"}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {"enum": ["fhir-package", "fhir-template"]}
            }
          },
          "then": {
            "properties": {
              "packageId": {"type": "string"},
              "packageVersion": {"type": "string"}
            },
            "required": ["packageId", "packageVersion"]
          },
          "else": {
            "not": {
              "anyOf": [
                {"required": ["packageId"]},
                {"required": ["packageVersion"]}
              ]
            }
          }
        },
        {
          "if": {"properties": {"kind": {"const": "fhir-template"}}},
          "then": {
            "properties": {"packageType": {"const": "fhir.template"}},
            "required": ["packageType"]
          },
          "else": {"not": {"required": ["packageType"]}}
        }
      ]
    },
    "lockedLanguagePackage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ecosystem",
        "name",
        "declaredVersion",
        "resolvedVersion",
        "integrity",
        "lockfileSha256",
        "transitiveSha256"
      ],
      "properties": {
        "ecosystem": {"enum": ["npm", "rubygems"]},
        "name": {"$ref": "#/$defs/nonemptyString"},
        "declaredVersion": {"$ref": "#/$defs/nonemptyString"},
        "resolvedVersion": {"$ref": "#/$defs/nonemptyString"},
        "integrity": {"$ref": "#/$defs/nonemptyString"},
        "lockfileSha256": {"$ref": "#/$defs/sha256"},
        "executableVersion": {"$ref": "#/$defs/nonemptyString"},
        "transitiveSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "semanticBaselinePackage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "packageId", "version", "snapshot"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "packageId": {"type": "string", "pattern": "^[A-Za-z0-9.-]+$"},
        "version": {"$ref": "#/$defs/nonemptyString"},
        "snapshot": {"type": "object"}
      }
    },
    "semanticBaseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "schemaVersion", "packages"],
      "properties": {
        "kind": {"const": "grove-fhir-semantic-baseline"},
        "schemaVersion": {"const": 1},
        "packages": {
          "type": "array",
          "items": {"$ref": "#/$defs/semanticBaselinePackage"}
        }
      }
    },
    "semanticReportFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "sha256", "size"],
      "properties": {
        "kind": {"enum": ["json", "markdown"]},
        "path": {"$ref": "#/$defs/relativePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size": {"type": "integer", "minimum": 1}
      }
    },
    "semanticComparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseRevision",
        "baseBaselinePresent",
        "baselinePath",
        "baselineSha256",
        "reports",
        "transitiveSha256"
      ],
      "properties": {
        "baseRevision": {"$ref": "#/$defs/fullCommit"},
        "baseBaselinePresent": {"type": "boolean"},
        "baselinePath": {"$ref": "#/$defs/relativePath"},
        "baselineSha256": {"$ref": "#/$defs/sha256"},
        "reports": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"$ref": "#/$defs/semanticReportFile"}
        },
        "transitiveSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "lockedExternalEvidenceFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "mediaType", "format", "sha256", "size"],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"},
        "mediaType": {
          "enum": ["application/fhir+json", "application/json"]
        },
        "format": {
          "enum": ["fhir-json", "test-attestation-v1"]
        },
        "testGroup": {"$ref": "#/$defs/identifier"},
        "attestationInputs": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/externalEvidenceInput"}
        },
        "sha256": {"$ref": "#/$defs/sha256"},
        "size": {"type": "integer", "minimum": 1}
      }
    },
    "lockedExternalEvidenceSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "implementation",
        "source",
        "proposals",
        "classification",
        "kind",
        "path",
        "files",
        "setDigest",
        "transitiveSha256"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "implementation": {"$ref": "#/$defs/identifier"},
        "source": {"$ref": "#/$defs/identifier"},
        "proposals": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        },
        "classification": {
          "enum": ["accepted-contract", "historical-writer", "legacy-candidate"]
        },
        "kind": {"enum": ["file", "directory"]},
        "path": {"$ref": "#/$defs/relativePath"},
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/lockedExternalEvidenceFile"}
        },
        "expectedUnknownExtensions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/expectedUnknownExtension"}
        },
        "setDigest": {"$ref": "#/$defs/sha256"},
        "transitiveSha256": {"$ref": "#/$defs/sha256"}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "classification": {
                "enum": ["historical-writer", "legacy-candidate"]
              }
            },
            "required": ["classification"]
          },
          "then": {
            "properties": {"expectedUnknownExtensions": {"type": "array"}},
            "required": ["expectedUnknownExtensions"]
          },
          "else": {"properties": {"expectedUnknownExtensions": false}}
        }
      ]
    },
    "lockedValidationReport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "mediaType",
        "format",
        "producer",
        "sha256",
        "size",
        "inputClosureSha256",
        "transitiveSha256"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "path": {"$ref": "#/$defs/relativePath"},
        "mediaType": {"const": "application/json"},
        "format": {"const": "domain-fhir-validation-v1"},
        "producer": {"$ref": "#/$defs/relativePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size": {"type": "integer", "minimum": 1},
        "inputClosureSha256": {"$ref": "#/$defs/sha256"},
        "transitiveSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "evidenceLock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "schemaVersion",
        "sourceRevision",
        "sourceDateEpoch",
        "inputs",
        "runtimes",
        "runtimeTransitiveSha256",
        "languagePackages",
        "languagePackagesTransitiveSha256",
        "toolArtifacts",
        "toolArtifactsTransitiveSha256",
        "toolchainTransitiveSha256",
        "pathMatrixSha256",
        "semanticComparison",
        "externalEvidence",
        "validationReports",
        "proposals",
        "gitlinks",
        "resolvedPackages",
        "packages",
        "corpora",
        "files",
        "lockDigest"
      ],
      "properties": {
        "kind": {"const": "grove-fhir-conformance-evidence-lock"},
        "schemaVersion": {"const": 1},
        "sourceRevision": {"$ref": "#/$defs/fullCommit"},
        "sourceDateEpoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/hashedPath"}
        },
        "runtimes": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {"$ref": "#/$defs/lockedRuntime"}
        },
        "runtimeTransitiveSha256": {"$ref": "#/$defs/sha256"},
        "languagePackages": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/lockedLanguagePackage"}
        },
        "languagePackagesTransitiveSha256": {"$ref": "#/$defs/sha256"},
        "toolArtifacts": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/lockedToolArtifact"}
        },
        "toolArtifactsTransitiveSha256": {"$ref": "#/$defs/sha256"},
        "toolchainTransitiveSha256": {"$ref": "#/$defs/sha256"},
        "pathMatrixSha256": {"$ref": "#/$defs/sha256"},
        "semanticComparison": {"$ref": "#/$defs/semanticComparison"},
        "externalEvidence": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/lockedExternalEvidenceSet"}
        },
        "validationReports": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/lockedValidationReport"}
        },
        "proposals": {
          "type": "array",
          "items": {"$ref": "#/$defs/lockedProposal"}
        },
        "gitlinks": {
          "type": "array",
          "items": {"$ref": "#/$defs/lockedGitlink"}
        },
        "resolvedPackages": {
          "type": "array",
          "items": {"$ref": "#/$defs/lockedResolvedPackage"}
        },
        "packages": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/lockedPackage"}
        },
        "corpora": {
          "type": "array",
          "items": {"$ref": "#/$defs/lockedCorpus"}
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/hashedPath"}
        },
        "lockDigest": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
