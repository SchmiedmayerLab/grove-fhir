{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schmiedmayerlab.github.io/grove-fhir/schema/health-connect-receiver-envelope.schema.json",
  "title": "Grove Health Connect Receiver Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation",
    "sourceIdentifier",
    "sourceVersion",
    "eventSequence",
    "bundleJson"
  ],
  "properties": {
    "operation": {
      "type": "string",
      "enum": ["upsert", "delete"]
    },
    "sourceIdentifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system", "value"],
      "properties": {
        "system": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    },
    "sourceVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,127})$"
    },
    "eventSequence": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,127}$"
    },
    "bundleJson": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16777216
    }
  }
}
