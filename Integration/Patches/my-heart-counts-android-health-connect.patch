+    private fun fhirContext(
+        recordingFullUrl: (Device) -> String = {
+            "urn:uuid:00000000-0000-4000-8000-000000000005"
+        },
+    ): HealthConnectFhirContext = HealthConnectFhirContext(
+        subject = HealthConnectBundleResource(
+            "urn:uuid:00000000-0000-4000-8000-000000000001",
+            Patient().apply { id = "participant-001" },
+        ),
+        assembler = application(
+            "urn:uuid:00000000-0000-4000-8000-000000000002",
+            "My Heart Counts Android FHIR Converter",
+            "edu.stanford.myheartcounts.fhir",
+            "1.0.0",
+        ),
+        researchStudies = listOf(
+            HealthConnectBundleResource(
+                "urn:uuid:00000000-0000-4000-8000-000000000003",
+                ResearchStudy().apply {
+                    id = "my-heart-counts"
+                    status = ResearchStudy.ResearchStudyStatus.ACTIVE
+                },
+            ),
+        ),
+        sourceApplication = { packageName ->
+            HealthConnectBundleResource(
+                "urn:uuid:00000000-0000-4000-8000-000000000004",
+                FhirDevice().apply {
+                    addIdentifier(
+                        Identifier()
+                            .setSystem(HealthConnectFhirContract.ANDROID_PACKAGE_IDENTIFIER)
+                            .setValue(packageName),
+                    )
+                },
+            )
+        },
+        recordingDevice = { source ->
+            HealthConnectBundleResource(
+                recordingFullUrl(source),
+                FhirDevice().apply {
+                    id = "source-recorder"
+                    meta.addProfile(HealthConnectFhirContract.MOBILE_RECORDING_DEVICE_PROFILE)
+                    manufacturer = source.manufacturer
+                    modelNumber = source.model
+                },
+            )
+        },
+    )
+
+    private fun application(
+        fullUrl: String,
+        name: String,
+        packageName: String,
+        version: String? = null,
+    ): HealthConnectBundleResource<FhirDevice> = HealthConnectBundleResource(
+        fullUrl,
+        FhirDevice().apply {
+            meta.addProfile(HealthConnectFhirContract.MOBILE_APPLICATION_DEVICE_PROFILE)
+            addIdentifier(
+                Identifier()
+                    .setSystem(HealthConnectFhirContract.ANDROID_PACKAGE_IDENTIFIER)
+                    .setValue(packageName),
+            )
+            addDeviceName().setName(name).setType(FhirDevice.DeviceNameType.USERFRIENDLYNAME)
+            version?.let {
+                addVersion()
+                    .setType(
+                        CodeableConcept(
+                            Coding(
+                                HealthConnectFhirContract.MDC,
+                                HealthConnectFhirContract.APPLICATION_SOFTWARE_VERSION,
+                                "MDC_ID_PROD_SPEC_SW",
+                            ),
+                        ),
+                    )
+                    .setValue(it)
+            }
+        },
+    )
+
+    private fun Bundle.observations(): List<Observation> = entry.mapNotNull { it.resource as? Observation }
+
+    private fun sourceIdentifierValue(observation: Observation): String = observation.identifier.single {
+        it.system == HealthConnectFhirContract.HEALTH_CONNECT_RECORD_IDENTIFIER
+    }.value
+
+    private fun HealthConnectR4Converter.convert(record: androidx.health.connect.client.records.Record, at: Instant) =
+        convert(record, at, "1")
+
+    private companion object {
+        const val EXAMPLE_REPOSITORY_SCOPE = "1f5c58aa-6ec6-4e79-a682-829a9debd3f5"
+        const val LARGE_CONTEXT_PADDING_BYTES = 8_387_000
+    }
