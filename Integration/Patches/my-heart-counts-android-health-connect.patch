+        assertThat(sink.batches.last().bundleJson.encodeToByteArray().size)
+            .isAtMost(HealthConnectWireFormat.MAX_BUNDLE_UTF8_BYTES)
+        // Each accepted half is larger than half the receiver byte envelope. Their unique recorder
