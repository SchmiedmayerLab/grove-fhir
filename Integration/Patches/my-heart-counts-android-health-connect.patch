+//
+// This source file belongs to the My Heart Counts Android project
+//
+// SPDX-FileCopyrightText: 2026 Stanford University and the project authors (see CONTRIBUTORS.md)
+//
+// SPDX-License-Identifier: MIT
+
+package edu.stanford.spezi.health.fhir
+
+import androidx.health.connect.client.records.HeartRateRecord
+import androidx.health.connect.client.records.Record
+import androidx.health.connect.client.records.StepsRecord
+import androidx.health.connect.client.records.WeightRecord
+import androidx.health.connect.client.records.metadata.Metadata
+import org.hl7.fhir.r4.model.Bundle
+import org.hl7.fhir.r4.model.CodeableConcept
+import org.hl7.fhir.r4.model.Coding
+import org.hl7.fhir.r4.model.DateTimeType
+import org.hl7.fhir.r4.model.Extension
+import org.hl7.fhir.r4.model.Identifier
+import org.hl7.fhir.r4.model.InstantType
+import org.hl7.fhir.r4.model.Observation
+import org.hl7.fhir.r4.model.Period
+import org.hl7.fhir.r4.model.Provenance
+import org.hl7.fhir.r4.model.Quantity
+import org.hl7.fhir.r4.model.Reference
+import java.math.BigDecimal
+import java.nio.charset.StandardCharsets
+import java.security.MessageDigest
+import java.time.Instant
+import java.time.ZoneOffset
+import java.time.format.DateTimeFormatter
+import java.time.format.DateTimeFormatterBuilder
+import java.time.temporal.ChronoField
+import java.util.Base64
+import java.util.UUID
+
+/** Converts the explicitly supported Health Connect records into the Grove Mobile R4 contract. */
+@Suppress("TooManyFunctions")
+class HealthConnectR4Converter(
+    private val context: HealthConnectFhirContext,
+    internal val synchronizationScope: HealthConnectSynchronizationScope,
+) {
+    fun convert(record: Record, convertedAt: Instant, eventSequence: String): HealthConnectConversion {
+        require(eventSequence.matches(Regex("[1-9][0-9]*"))) {
+            "A conversion event requires its durable positive decimal event sequence."
+        }
+        return convertWithEventToken(record, convertedAt, eventSequence)
+    }
+
+    internal fun preview(record: Record, convertedAt: Instant): HealthConnectConversion =
+        convertWithEventToken(record, convertedAt, PREVIEW_EVENT_SEQUENCE)
+
+    internal fun bundleId(sourceIdentifier: Identifier, eventSequence: String): String =
+        technicalUuid("bundle", sourceIdentifier, eventSequence).toString()
+
+    private fun convertWithEventToken(
+        record: Record,
+        convertedAt: Instant,
+        eventSequence: String,
+    ): HealthConnectConversion {
+        HealthConnectWireFormat.requireFhirInstant(convertedAt, "Conversion event time")
+        return when (record) {
+            is HeartRateRecord -> convertHeartRate(record, convertedAt, eventSequence)
+            is StepsRecord -> convertSteps(record, convertedAt, eventSequence)
+            is WeightRecord -> convertWeight(record, convertedAt, eventSequence)
+            else -> throw UnsupportedHealthConnectRecord(record::class.qualifiedName ?: record::class.java.name)
+        }
+    }
+
+    private fun convertHeartRate(
+        record: HeartRateRecord,
+        convertedAt: Instant,
+        eventSequence: String,
+    ): HealthConnectConversion {
+        val source = sourceIdentity(record.metadata, HEART_RATE_IDENTITY_TOKEN)
+        val resolvedContext = context.resolve(record.metadata)
+        validate(record)
+
+        val occurrences = mutableMapOf<Pair<Instant, Long>, Int>()
+        val observations = record.samples
+            .sortedWith(compareBy<HeartRateRecord.Sample>({ it.time }, { it.beatsPerMinute }))
+            .map { sample ->
+                HealthConnectWireFormat.requireFhirInstant(sample.time, "Heart-rate sample time")
+                val occurrenceKey = sample.time to sample.beatsPerMinute
+                val occurrence = occurrences.getOrDefault(occurrenceKey, 0)
+                occurrences[occurrenceKey] = occurrence + 1
+                val output = sampleIdentifier(source, sample, occurrence)
+                baseObservation(record.metadata, source, output, resolvedContext).apply {
+                    meta.addProfile(HealthConnectFhirContract.HEART_RATE_PROFILE)
+                    addCategory(concept(HealthConnectFhirContract.OBSERVATION_CATEGORY, "vital-signs", "Vital Signs"))
+                    code = concept(HealthConnectFhirContract.LOINC, "8867-4", "Heart rate")
+                    // Health Connect supplies offsets for the containing Record, not for each Sample.
+                    effective = DateTimeType(sample.time.toString())
+                    value = quantity(sample.beatsPerMinute.toBigDecimal(), "/min", "beats/minute")
+                }
+            }
+        return conversion(
+            record.metadata,
+            HEART_RATE_RECORD,
+            source,
+            observations,
+            convertedAt,
+            eventSequence,
+            resolvedContext,
+        )
+    }
+
+    private fun convertSteps(record: StepsRecord, convertedAt: Instant, eventSequence: String): HealthConnectConversion {
+        val source = sourceIdentity(record.metadata, STEPS_IDENTITY_TOKEN)
+        val resolvedContext = context.resolve(record.metadata)
+        if (!record.startTime.isBefore(record.endTime)) {
+            throw InvalidHealthConnectRecord("StepsRecord must have a positive interval.")
+        }
+        if (record.count !in 1..MAX_STEP_COUNT) {
+            throw InvalidHealthConnectRecord("StepsRecord count must be between 1 and 1,000,000.")
+        }
+        val observation = baseObservation(
+            record.metadata,
+            source,
+            singleResultIdentifier(source),
+            resolvedContext,
+        ).apply {
+            meta.addProfile(HealthConnectFhirContract.MOBILE_STEP_COUNT_PROFILE)
+            addCategory(concept(HealthConnectFhirContract.OBSERVATION_CATEGORY, "activity", "Activity"))
+            code = concept(
+                HealthConnectFhirContract.GROVE_MOBILE_MEASUREMENT,
+                "step-count-total",
+                "Step count total",
+            )
+            effective = Period().apply {
+                startElement = DateTimeType(record.startTime.fhirDateTime(record.startZoneOffset, "Steps start time"))
+                endElement = DateTimeType(record.endTime.fhirDateTime(record.endZoneOffset, "Steps end time"))
+            }
+            value = quantity(record.count.toBigDecimal(), "{steps}", "steps")
+        }
+        return conversion(
+            record.metadata,
+            STEPS_RECORD,
+            source,
+            listOf(observation),
+            convertedAt,
+            eventSequence,
+            resolvedContext,
+        )
+    }
+
+    private fun convertWeight(record: WeightRecord, convertedAt: Instant, eventSequence: String): HealthConnectConversion {
+        val source = sourceIdentity(record.metadata, WEIGHT_IDENTITY_TOKEN)
+        val resolvedContext = context.resolve(record.metadata)
+        val kilograms = record.weight.inKilograms
+        if (!kilograms.isFinite() || kilograms < 0.0 || kilograms > MAX_WEIGHT_KILOGRAMS) {
+            throw InvalidHealthConnectRecord("WeightRecord must contain a finite weight in [0, 1000] kg.")
+        }
+        val observation = baseObservation(
+            record.metadata,
+            source,
+            singleResultIdentifier(source),
+            resolvedContext,
+        ).apply {
+            meta.addProfile(HealthConnectFhirContract.BODY_WEIGHT_PROFILE)
+            addCategory(concept(HealthConnectFhirContract.OBSERVATION_CATEGORY, "vital-signs", "Vital Signs"))
+            code = concept(HealthConnectFhirContract.LOINC, "29463-7", "Body weight")
+            effective = DateTimeType(record.time.fhirDateTime(record.zoneOffset, "Weight time"))
+            value = quantity(BigDecimal.valueOf(kilograms), "kg", "kg")
+        }
+        return conversion(
+            record.metadata,
+            WEIGHT_RECORD,
+            source,
+            listOf(observation),
+            convertedAt,
+            eventSequence,
+            resolvedContext,
+        )
+    }
+
+    private fun baseObservation(
+        metadata: Metadata,
+        sourceIdentifier: Identifier,
+        outputIdentifier: Identifier,
+        resolvedContext: ResolvedFhirContext,
+    ): Observation =
+        Observation().apply {
+            id = technicalUuid("observation", outputIdentifier).toString()
+            meta.addProfile(HealthConnectFhirContract.MOBILE_OBSERVATION_PROFILE)
+            meta.addProfile(HealthConnectFhirContract.HEALTH_CONNECT_OBSERVATION_PROFILE)
+            addIdentifier(sourceIdentifier.copy())
+            addIdentifier(outputIdentifier)
+            status = Observation.ObservationStatus.FINAL
+            subject = context.subject.reference()
+            // For a Health Connect read-back record, lastModifiedTime is the source version's
+            // availability timestamp. The conversion event itself is recorded on Provenance.
+            issuedElement = InstantType(metadata.lastModifiedTime.toString())
+
+            recordingMethod(metadata)?.let { addExtension(it) }
+            resolvedContext.recordingDevice?.let { device = it.reference() }
+            context.researchStudies.forEach { study ->
+                addExtension(
+                    Extension(
+                        HealthConnectFhirContract.RESEARCH_STUDY_EXTENSION,
+                        study.reference(),
+                    ),
+                )
+            }
+        }
+
+    @Suppress("LongParameterList")
+    private fun conversion(
+        metadata: Metadata,
+        recordType: String,
+        source: Identifier,
+        observations: List<Observation>,
+        convertedAt: Instant,
+        eventSequence: String,
+        resolvedContext: ResolvedFhirContext,
+    ): HealthConnectConversion {
+        if (convertedAt < metadata.lastModifiedTime) {
+            throw InvalidHealthConnectRecord(
+                "The conversion event cannot precede the source version's lastModifiedTime.",
+            )
+        }
+        val provenance = observations.takeIf { it.isNotEmpty() }?.let { outputs ->
+            Provenance().apply {
+                id = technicalUuid("provenance", source, eventSequence).toString()
+                meta.addProfile(HealthConnectFhirContract.MOBILE_PROVENANCE_PROFILE)
+                meta.addProfile(HealthConnectFhirContract.HEALTH_CONNECT_PROVENANCE_PROFILE)
+                occurred = DateTimeType(convertedAt.toString())
+                recordedElement = InstantType(convertedAt.toString())
+                activity = concept(
+                    HealthConnectFhirContract.RECORD_LIFECYCLE,
+                    "transform",
+                    "Transform/Translate Record Lifecycle Event",
+                )
+                addAgent().apply {
+                    type = concept(HealthConnectFhirContract.PROVENANCE_PARTICIPANT, "assembler", "Assembler")
+                    who = context.assembler.reference()
+                }
+                outputs.forEach { observation ->
+                    addTarget(
+                        Reference().apply {
+                            reference = "urn:uuid:${observation.id}"
+                            type = "Observation"
+                            identifier = outputIdentifier(observation).copy()
+                        },
+                    )
+                }
+                addEntity().apply {
+                    role = Provenance.ProvenanceEntityRole.SOURCE
+                    what = Reference().apply { identifier = source.copy() }
+                    addAgent().apply {
+                        type = concept(HealthConnectFhirContract.PROVENANCE_PARTICIPANT, "enterer", "Enterer")
+                        who = resolvedContext.sourceApplication.reference()
+                    }
+                }
+            }
+        }
+        val bundle = bundle(source, observations, provenance, convertedAt, eventSequence, resolvedContext)
+        return HealthConnectConversion(
+            conversionContractVersion = synchronizationScope.conversionContractVersion,
+            sourceRecordIdentifier = source,
+            sourceRecordType = recordType,
+            sourceLastModified = metadata.lastModifiedTime,
+            observations = observations,
+            provenance = provenance,
+            bundle = bundle,
+        )
+    }
+
+    private fun bundle(
+        source: Identifier,
+        observations: List<Observation>,
+        provenance: Provenance?,
+        convertedAt: Instant,
+        eventSequence: String,
+        resolvedContext: ResolvedFhirContext,
+    ): Bundle = Bundle().apply {
+        id = bundleId(source, eventSequence)
+        type = Bundle.BundleType.COLLECTION
+        timestampElement = InstantType(convertedAt.toString())
+        resolvedContext.resources.forEach { resolved ->
+            addEntry().apply {
+                fullUrl = resolved.fullUrl
+                resource = resolved.resource.copy()
+            }
+        }
+        observations.sortedBy { outputIdentifier(it).value }.forEach { observation ->
+            addEntry().apply {
+                fullUrl = "urn:uuid:${observation.id}"
+                resource = observation.copy()
+            }
+        }
+        provenance?.let {
+            addEntry().apply {
+                fullUrl = "urn:uuid:${it.id}"
+                resource = it.copy()
+            }
+        }
+    }
+
+    private fun sourceIdentity(
+        metadata: Metadata,
+        recordTypeToken: String,
+    ): Identifier {
+        val packageName = metadata.dataOrigin.packageName
+        val invalidReason = when {
+            metadata.id.isBlank() ->
+                "Health Connect metadata.id is absent; convert records only after reading them."
+            packageName.isBlank() ->
+                "Health Connect dataOrigin.packageName is absent."
+            !metadata.lastModifiedTime.isAfter(Instant.EPOCH) ->
+                "Health Connect lastModifiedTime must be a post-insertion instant after the Unix epoch."
+            metadata.lastModifiedTime > HealthConnectWireFormat.MAX_FHIR_INSTANT ->
+                "Health Connect lastModifiedTime must have a four-digit FHIR year no later than 9999."
+            else -> null
+        }
+        invalidReason?.let { throw InvalidHealthConnectRecord(it) }
+        return Identifier().apply {
+            system = HealthConnectFhirContract.HEALTH_CONNECT_RECORD_IDENTIFIER
+            value = synchronizationScope.sourceRecordIdentifierValue(recordTypeToken, metadata.id)
+        }
+    }
+
+    private fun validate(record: HeartRateRecord) {
+        val invalidReason = when {
+            record.startTime.isAfter(record.endTime) ->
+                "HeartRateRecord startTime must not be after endTime."
+            record.samples.any { it.time < record.startTime || it.time > record.endTime } ->
+                "Heart-rate sample lies outside its source record interval."
+            else -> null
+        }
+        invalidReason?.let { throw InvalidHealthConnectRecord(it) }
+    }
+
+    private fun singleResultIdentifier(sourceIdentifier: Identifier): Identifier =
+        Identifier().apply {
+            system = HealthConnectFhirContract.HEALTH_CONNECT_OUTPUT_IDENTIFIER
+            val sourceTuple = synchronizationScope.canonicalIdentifierTuple(sourceIdentifier)
+            value = opaqueOutputIdentifier("single\u0000${sourceTuple.sized()}")
+        }
+
+    private fun sampleIdentifier(
+        sourceIdentifier: Identifier,
+        sample: HeartRateRecord.Sample,
+        occurrence: Int,
+    ): Identifier = Identifier().apply {
+        system = HealthConnectFhirContract.HEALTH_CONNECT_OUTPUT_IDENTIFIER
+        val sourceTuple = synchronizationScope.canonicalIdentifierTuple(sourceIdentifier)
+        val canonicalPreimage = buildString {
+            append("sample\u0000")
+            append(sourceTuple.sized())
+            append('\u0000')
+            append(HEALTH_CONNECT_SAMPLE_INSTANT.format(sample.time))
+            append('\u0000')
+            append(sample.beatsPerMinute)
+            append('\u0000')
+            append(occurrence)
+        }
+        value = opaqueOutputIdentifier(canonicalPreimage)
+    }
+
+    private fun recordingMethod(metadata: Metadata): Extension? {
+        val code = when (metadata.recordingMethod) {
+            Metadata.RECORDING_METHOD_UNKNOWN -> return null
+            Metadata.RECORDING_METHOD_ACTIVELY_RECORDED -> "actively-recorded"
+            Metadata.RECORDING_METHOD_AUTOMATICALLY_RECORDED -> "automatically-recorded"
+            Metadata.RECORDING_METHOD_MANUAL_ENTRY -> "manual-entry"
+            else -> throw InvalidHealthConnectRecord("Unsupported Health Connect recording method: ${metadata.recordingMethod}")
+        }
+        return Extension(
+            HealthConnectFhirContract.RECORDING_METHOD_EXTENSION,
+            Coding(HealthConnectFhirContract.GROVE_RECORDING_METHOD, code, null),
+        )
+    }
+
+    private fun quantity(value: BigDecimal, code: String, unit: String): Quantity =
+        Quantity().setValue(value).setSystem(HealthConnectFhirContract.UCUM).setCode(code).setUnit(unit)
+
+    private fun Instant.fhirDateTime(zoneOffset: ZoneOffset?, field: String): String {
+        HealthConnectWireFormat.requireFhirInstant(this, field)
+        if (zoneOffset == null) return toString()
+        if (
+            zoneOffset.totalSeconds % SECONDS_PER_MINUTE != 0 ||
+            zoneOffset.totalSeconds !in -MAX_FHIR_OFFSET_SECONDS..MAX_FHIR_OFFSET_SECONDS
+        ) {
+            throw InvalidHealthConnectRecord(
+                "$field offset must use whole minutes in the FHIR range -14:00 through +14:00.",
+            )
+        }
+        val local = atOffset(zoneOffset)
+        if (local.year !in MIN_FHIR_YEAR..MAX_FHIR_YEAR) {
+            throw InvalidHealthConnectRecord("$field must retain a four-digit FHIR year after applying its offset.")
+        }
+        return FHIR_OFFSET_DATE_TIME.format(local)
+    }
+
+    private companion object {
+        val FHIR_OFFSET_DATE_TIME: DateTimeFormatter = DateTimeFormatterBuilder()
+            .appendPattern("uuuu-MM-dd'T'HH:mm:ss")
+            .appendFraction(ChronoField.NANO_OF_SECOND, 0, 9, true)
+            .appendOffsetId()
+            .toFormatter()
+
+        val HEALTH_CONNECT_SAMPLE_INSTANT: DateTimeFormatter = DateTimeFormatterBuilder()
+            .appendInstant(9)
+            .toFormatter()
+
+        const val HEART_RATE_RECORD = "HeartRateRecord"
+        const val MAX_STEP_COUNT = 1_000_000L
+        const val MAX_WEIGHT_KILOGRAMS = 1_000.0
+        const val STEPS_RECORD = "StepsRecord"
+        const val WEIGHT_RECORD = "WeightRecord"
+
+        const val PREVIEW_EVENT_SEQUENCE = "preview"
+
+        const val SECONDS_PER_MINUTE = 60
+        const val MAX_FHIR_OFFSET_SECONDS = 14 * 60 * SECONDS_PER_MINUTE
+        const val MIN_FHIR_YEAR = 1
+        const val MAX_FHIR_YEAR = 9999
+
+        private const val HEART_RATE_IDENTITY_TOKEN = "heart-rate"
+        private const val STEPS_IDENTITY_TOKEN = "steps"
+        private const val WEIGHT_IDENTITY_TOKEN = "weight"
+    }
+}
+
+private fun outputIdentifier(observation: Observation): Identifier = observation.identifier.single {
+    it.system == HealthConnectFhirContract.HEALTH_CONNECT_OUTPUT_IDENTIFIER
+}
+
+/**
+ * Produces the contract's opaque, deterministic output identifier.
+ *
+ * The digest reduces disclosure when identifiers appear in indexes and logs. It is an identity
+ * mechanism, not an authorization or secrecy boundary.
+ */
+private fun opaqueOutputIdentifier(canonicalPreimage: String): String =
+    MessageDigest.getInstance("SHA-256")
+        .digest(canonicalPreimage.toByteArray(StandardCharsets.UTF_8))
+        .let { digest ->
+            buildString(capacity = OUTPUT_IDENTIFIER_PREFIX.length + digest.size * HEX_CHARS_PER_BYTE) {
+                append(OUTPUT_IDENTIFIER_PREFIX)
+                digest.forEach { byte ->
+                    val unsigned = byte.toInt() and BYTE_MASK
+                    append(LOWERCASE_HEX[unsigned ushr HEX_NIBBLE_BITS])
+                    append(LOWERCASE_HEX[unsigned and HEX_NIBBLE_MASK])
+                }
+            }
+        }
+
+private fun String.sized(): String = "${toByteArray(StandardCharsets.UTF_8).size}:$this"
+
+/**
+ * Produces an RFC 9562 UUIDv5 in the standard URL namespace.
+ *
+ * The absolute name is domain-separated by resource role. Its final path segment is unpadded
+ * base64url of the complete, length-prefixed business Identifier tuple and, for conversion-event
+ * resources, the durable event sequence. These UUIDs are technical Bundle references only; the
+ * complete FHIR Identifier remains the business identity.
+ */
+private fun technicalUuid(role: String, identifier: Identifier, eventSequence: String? = null): UUID {
+    val identifierTuple = "${identifier.system.sized()}\u0000${identifier.value.sized()}"
+    val semanticName = listOfNotNull(identifierTuple, eventSequence).joinToString("\u0000")
+    val encodedName = Base64.getUrlEncoder().withoutPadding()
+        .encodeToString(semanticName.toByteArray(StandardCharsets.UTF_8))
+    return uuidV5(URL_NAMESPACE, "$TECHNICAL_ID_BASE_URL/$role/$encodedName")
+}
+
+private fun uuidV5(namespace: UUID, name: String): UUID {
+    val namespaceBytes = java.nio.ByteBuffer.allocate(UUID_BYTE_COUNT)
+        .putLong(namespace.mostSignificantBits)
+        .putLong(namespace.leastSignificantBits)
+        .array()
+    val digest = MessageDigest.getInstance("SHA-1").apply {
+        update(namespaceBytes)
+        update(name.toByteArray(StandardCharsets.UTF_8))
+    }.digest()
+    digest[UUID_VERSION_BYTE_INDEX] = (
+        digest[UUID_VERSION_BYTE_INDEX].toInt() and UUID_VERSION_CLEAR_MASK or UUID_VERSION_FIVE_BITS
+        ).toByte()
+    digest[UUID_VARIANT_BYTE_INDEX] = (
+        digest[UUID_VARIANT_BYTE_INDEX].toInt() and UUID_VARIANT_CLEAR_MASK or UUID_IETF_VARIANT_BITS
+        ).toByte()
+    val buffer = java.nio.ByteBuffer.wrap(digest, 0, UUID_BYTE_COUNT)
+    return UUID(buffer.long, buffer.long)
+}
+
+private fun concept(system: String, code: String, display: String): CodeableConcept =
+    CodeableConcept(Coding(system, code, display))
+
+private const val UUID_VERSION_BYTE_INDEX = 6
+private const val UUID_VARIANT_BYTE_INDEX = 8
+private const val UUID_VERSION_CLEAR_MASK = 0x0f
+private const val UUID_VERSION_FIVE_BITS = 0x50
+private const val UUID_VARIANT_CLEAR_MASK = 0x3f
+private const val UUID_IETF_VARIANT_BITS = 0x80
+private const val UUID_BYTE_COUNT = 16
+private const val TECHNICAL_ID_BASE_URL = "https://grovealliance.org/fhir/health-connect/technical-id/v1"
+private val URL_NAMESPACE: UUID = UUID.fromString("6ba7b811-9dad-11d1-80b4-00c04fd430c8")
+private const val OUTPUT_IDENTIFIER_PREFIX = "v1:"
+private const val LOWERCASE_HEX = "0123456789abcdef"
+private const val HEX_CHARS_PER_BYTE = 2
+private const val HEX_NIBBLE_BITS = 4
+private const val HEX_NIBBLE_MASK = 0x0f
+private const val BYTE_MASK = 0xff
