+//
+// This source file belongs to the My Heart Counts Android project
+//
+// SPDX-FileCopyrightText: 2026 Stanford University and the project authors (see CONTRIBUTORS.md)
+//
+// SPDX-License-Identifier: MIT
+
+package edu.stanford.spezi.health.fhir
+
+import org.hl7.fhir.r4.model.Bundle
+import org.hl7.fhir.r4.model.Identifier
+import org.hl7.fhir.r4.model.Observation
+import org.hl7.fhir.r4.model.Provenance
+import java.time.Instant
+
+/** The resources and synchronization facts derived from one Health Connect record. */
+data class HealthConnectConversion(
+    val conversionContractVersion: String,
+    val sourceRecordIdentifier: Identifier,
+    val sourceRecordType: String,
+    val sourceLastModified: Instant,
+    val observations: List<Observation>,
+    val provenance: Provenance?,
+    val bundle: Bundle,
+) {
+    init {
+        require(conversionContractVersion.isNotBlank()) {
+            "The conversion-contract version must not be blank."
+        }
+        require(sourceRecordIdentifier.hasSystem() && sourceRecordIdentifier.hasValue()) {
+            "The source record identifier must contain a system and value."
+        }
+        require(sourceRecordType.isNotBlank()) { "The source record type must not be blank." }
+        require(observations.isNotEmpty() || sourceRecordType == "HeartRateRecord") {
+            "Only a HeartRateRecord may have a successful zero-output conversion."
+        }
+        require((observations.isEmpty()) == (provenance == null)) {
+            "Zero-output conversions omit Provenance; conversions with outputs require it."
+        }
+        require(
+            observations.all { observation ->
+                observation.identifier.count {
+                    it.system == HealthConnectFhirContract.HEALTH_CONNECT_RECORD_IDENTIFIER &&
+                        it.hasValue()
+                } == 1 &&
+                    observation.identifier.count {
+                        it.system == HealthConnectFhirContract.HEALTH_CONNECT_OUTPUT_IDENTIFIER &&
+                            it.hasValue()
+                    } == 1
+            },
+        ) { "Every converted Observation must contain one exact source and output identifier." }
+        require(
+            observations.all { observation ->
+                observation.identifier.single {
+                    it.system == HealthConnectFhirContract.HEALTH_CONNECT_RECORD_IDENTIFIER
+                }.let {
+                    it.system == sourceRecordIdentifier.system && it.value == sourceRecordIdentifier.value
+                }
+            },
+        ) { "Every converted Observation must identify its exact source Record." }
+        require(observationIdentifiers.map { "${it.system}|${it.value}" }.distinct().size == observations.size) {
+            "Every converted Observation must have a distinct output identifier."
+        }
+        require(bundle.type == Bundle.BundleType.COLLECTION && bundle.entry.isNotEmpty()) {
+            "A conversion must contain a non-empty collection Bundle."
+        }
+        require(bundle.entry.all { it.hasFullUrl() && it.hasResource() }) {
+            "Every collection Bundle entry must contain a fullUrl and resource."
+        }
+        require(bundle.entry.map { it.fullUrl }.distinct().size == bundle.entry.size) {
+            "Bundle fullUrl values must be unique."
+        }
+        val bundledObservations = bundle.entry.mapNotNull { it.resource as? Observation }
+        require(
+            bundledObservations.size == observations.size &&
+                bundledObservations.sortedBy(::completeOutputIdentifierKey)
+                    .zip(observations.sortedBy(::completeOutputIdentifierKey))
+                    .all { (bundled, converted) -> bundled.equalsDeep(converted) },
+        ) { "The Bundle Observation set must exactly match the converted output set." }
+        val outputKeys = observationIdentifiers.map { "${it.system}|${it.value}" }.toSet()
+        require(
+            provenance?.target.orEmpty().map { target ->
+                "${target.identifier.system}|${target.identifier.value}"
+            }.toSet() == outputKeys,
+        ) { "Conversion Provenance must target every exact output identifier." }
+    }
+
+    val observationIdentifiers: List<Identifier>
+        get() = observations.map { observation ->
+            observation.identifier.single {
+                it.system == HealthConnectFhirContract.HEALTH_CONNECT_OUTPUT_IDENTIFIER
+            }.copy()
+        }
+}
+
+class UnsupportedHealthConnectRecord(recordType: String) :
+    IllegalArgumentException("Unsupported Health Connect record type: $recordType")
+
+open class InvalidHealthConnectRecord(message: String) : IllegalArgumentException(message)
+
+class HealthConnectReceiverEnvelopeExceeded(message: String) : InvalidHealthConnectRecord(message)
+
+private fun completeOutputIdentifierKey(observation: Observation): String = observation.identifier.single {
+    it.system == HealthConnectFhirContract.HEALTH_CONNECT_OUTPUT_IDENTIFIER
+}.let { "${it.system.length}:${it.system}\u0000${it.value.length}:${it.value}" }
