@@ -0,0 +1,179 @@
+#!/usr/bin/env bash
+
+# This source file belongs to the My Heart Counts Android project
+#
+# SPDX-FileCopyrightText: 2026 Stanford University and the project authors (see CONTRIBUTORS.md)
+#
+# SPDX-License-Identifier: MIT
+
+set -euo pipefail
+
+usage() {
+    cat <<'EOF'
+Usage: Scripts/validate-health-connect-fhir-conformance.sh [options]
+
+Required inputs (option or matching environment variable):
+  --mobile-package PATH          GROVE_MOBILE_PACKAGE
+  --health-connect-package PATH  GROVE_HEALTH_CONNECT_PACKAGE
+  --validator-jar PATH           FHIR_VALIDATOR_JAR
+
+Optional inputs:
+  --terminology-server URL       FHIR_TERMINOLOGY_SERVER (default: n/a)
+  --export DIRECTORY             GROVE_CONFORMANCE_EXPORT
+  --help
+
+With the default terminology server, the validator runs with all HTTP access
+disabled. Its exact dependency packages must therefore already be available in
+the local FHIR package cache.
+EOF
+}
+
+mobile_package="${GROVE_MOBILE_PACKAGE:-}"
+health_connect_package="${GROVE_HEALTH_CONNECT_PACKAGE:-}"
+validator_jar="${FHIR_VALIDATOR_JAR:-}"
+terminology_server="${FHIR_TERMINOLOGY_SERVER:-n/a}"
+export_directory="${GROVE_CONFORMANCE_EXPORT:-}"
+
+while (( $# > 0 )); do
+    case "$1" in
+        --mobile-package)
+            [[ $# -ge 2 ]] || { usage >&2; exit 2; }
+            mobile_package="$2"
+            shift 2
+            ;;
+        --health-connect-package)
+            [[ $# -ge 2 ]] || { usage >&2; exit 2; }
+            health_connect_package="$2"
+            shift 2
+            ;;
+        --validator-jar)
+            [[ $# -ge 2 ]] || { usage >&2; exit 2; }
+            validator_jar="$2"
+            shift 2
+            ;;
+        --terminology-server)
+            [[ $# -ge 2 ]] || { usage >&2; exit 2; }
+            terminology_server="$2"
+            shift 2
+            ;;
+        --export)
+            [[ $# -ge 2 ]] || { usage >&2; exit 2; }
+            export_directory="$2"
+            shift 2
+            ;;
+        --help)
+            usage
+            exit 0
+            ;;
+        *)
+            echo "Unknown argument: $1" >&2
+            usage >&2
+            exit 2
+            ;;
+    esac
+done
+
+require_file() {
+    local label="$1"
+    local path="$2"
+    if [[ -z "$path" || ! -f "$path" ]]; then
+        echo "$label must name an existing regular file: ${path:-<unset>}" >&2
+        exit 2
+    fi
+}
+
+require_file "Grove Mobile package" "$mobile_package"
+require_file "Grove Health Connect package" "$health_connect_package"
+require_file "FHIR Validator jar" "$validator_jar"
+
+script_directory="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+repository_root="$(cd "$script_directory/.." && pwd)"
+temporary_root="$(mktemp -d "${TMPDIR:-/tmp}/mhc-health-connect-fhir.XXXXXX")"
+trap 'rm -rf -- "$temporary_root"' EXIT
+
+generated_root="$temporary_root/generated"
+conformance_root="$generated_root/conformance-fixtures"
+wire_root="$generated_root/wire-fixtures"
+
+(
+    cd "$repository_root"
+    GROVE_CONFORMANCE_EXPORT="$conformance_root" \
+        GROVE_WIRE_EXPORT="$wire_root" \
+        ./gradlew :health-fhir:testDebugUnitTest --rerun-tasks --console=plain
+)
+
+conformance_names=(
+    health-connect-heart-rate-bundle.json
+    health-connect-heart-rate-observation-1.json
+    health-connect-heart-rate-observation-2.json
+    health-connect-heart-rate-provenance.json
+    health-connect-heart-rate-update-bundle.json
+    health-connect-step-deletion-bundle.json
+    health-connect-steps-bundle.json
+    health-connect-steps-observation-1.json
+    health-connect-steps-provenance.json
+    health-connect-weight-bundle.json
+    health-connect-weight-observation-1.json
+    health-connect-weight-provenance.json
+)
+wire_names=(
+    health-connect-heart-rate-update-bundle.json
+    health-connect-heart-rate-upsert-bundle.json
+    health-connect-heart-rate-zero-output-upsert-bundle.json
+    health-connect-step-deletion-bundle.json
+)
+
+fixture_paths=()
+for name in "${conformance_names[@]}"; do
+    path="$conformance_root/$name"
+    require_file "Generated conformance fixture" "$path"
+    fixture_paths+=("$path")
+done
+for name in "${wire_names[@]}"; do
+    path="$wire_root/$name"
+    require_file "Generated wire fixture" "$path"
+    fixture_paths+=("$path")
+done
+
+if [[ -n "$export_directory" ]]; then
+    validation_root="$export_directory"
+    mkdir -p "$validation_root/conformance-fixtures" "$validation_root/wire-fixtures"
+    for name in "${conformance_names[@]}"; do
+        cp "$conformance_root/$name" "$validation_root/conformance-fixtures/$name"
+    done
+    for name in "${wire_names[@]}"; do
+        cp "$wire_root/$name" "$validation_root/wire-fixtures/$name"
+    done
+else
+    validation_root="$repository_root/health-fhir/build/fhir-validation"
+    mkdir -p "$validation_root"
+fi
+validation_log="$validation_root/validation.txt"
+
+validator_arguments=(
+    -jar "$validator_jar"
+    -version 4.0.1
+    -tx "$terminology_server"
+    -ig "$mobile_package"
+    -ig "$health_connect_package"
+)
+if [[ "$terminology_server" == "n/a" ]]; then
+    validator_arguments+=( -txCache n/a -no-http-access )
+fi
+
+java "${validator_arguments[@]}" "${fixture_paths[@]}" 2>&1 \
+    | sed $'s/\033\\[[0-9;]*m//g' \
+    | tee "$validation_log"
+
+successful_resources="$(grep -c '^Success: 0 errors,' "$validation_log" || true)"
+if [[ "$successful_resources" -ne "${#fixture_paths[@]}" ]]; then
+    echo "Expected ${#fixture_paths[@]} resources with zero errors; found $successful_resources." >&2
+    exit 1
+fi
+if grep -Eq '^Success: [1-9][0-9]* errors,' "$validation_log"; then
+    echo "FHIR validation reported one or more errors." >&2
+    exit 1
+fi
+
+echo "Validated ${#fixture_paths[@]} deterministic FHIR R4 resources with zero errors."
+echo "Validation report: $validation_log"
