+//
+// This source file belongs to the My Heart Counts iOS open-source project
+//
+// SPDX-FileCopyrightText: 2026 Stanford University and the project authors (see CONTRIBUTORS.md)
+//
+// SPDX-License-Identifier: MIT
+//
+
+import FHIRModelsExtensions
+import Foundation
+import ModelsR4
+@testable import MyHeartCounts
+import Testing
+
+
+/// Freezes the exact study-enrollment extension bytes emitted by the app at the evidenced revision.
+/// This is legacy-candidate provenance; it does not declare the URL canonical or migrate its shape.
+@Suite
+struct StudyEnrollmentEvidenceTests {
+    private static let fixtureName = "my-heart-counts-ios-e7ae-study-enrollment.json"
+
+    private static var vitalSignsCategory: CodeableConcept {
+        CodeableConcept(coding: [
+            Coding(
+                code: "vital-signs".asFHIRStringPrimitive(),
+                display: "Vital Signs".asFHIRStringPrimitive(),
+                system: "http://terminology.hl7.org/CodeSystem/observation-category".asFHIRURIPrimitive()
+            )
+        ])
+    }
+
+    private var repositoryRoot: URL {
+        URL(fileURLWithPath: #filePath)
+            .deletingLastPathComponent()
+            .deletingLastPathComponent()
+    }
+
+    private var fixtureURL: URL {
+        repositoryRoot
+            .appending(component: "Compatibility", directoryHint: .isDirectory)
+            .appending(component: "Fixtures", directoryHint: .isDirectory)
+            .appending(component: Self.fixtureName, directoryHint: .notDirectory)
+    }
+
+    private var exportURL: URL {
+        repositoryRoot
+            .appending(component: ".build", directoryHint: .isDirectory)
+            .appending(component: "compatibility-evidence", directoryHint: .isDirectory)
+            .appending(component: "my-heart-counts-ios-e7ae", directoryHint: .isDirectory)
+            .appending(component: "study-enrollment.json", directoryHint: .notDirectory)
+    }
+
+    @Test
+    func exactCurrentWriterBytes() throws {
+        var observation = Observation(
+            code: CodeableConcept(coding: [
+                Coding(
+                    code: "8867-4".asFHIRStringPrimitive(),
+                    display: "Heart rate".asFHIRStringPrimitive(),
+                    system: "http://loinc.org".asFHIRURIPrimitive()
+                )
+            ]),
+            status: .init(.final)
+        )
+        observation.id = "mhc-ios-e7ae-study-enrollment-evidence".asFHIRStringPrimitive()
+        observation.category = [Self.vitalSignsCategory]
+        observation.subject = Reference(
+            reference: "Patient/mhc-compatibility-participant".asFHIRStringPrimitive()
+        )
+        observation.effective = try .dateTime(FHIRPrimitive(DateTime(
+            date: Date(timeIntervalSince1970: 1_609_459_200),
+            timeZone: .gmt
+        )))
+        observation.value = .quantity(Quantity(
+            code: "/min".asFHIRStringPrimitive(),
+            system: "http://unitsofmeasure.org".asFHIRURIPrimitive(),
+            unit: "beats/minute".asFHIRStringPrimitive(),
+            value: 72.asFHIRDecimalPrimitive()
+        ))
+        try observation.apply(.mhcStudyRevision(
+            studyId: "11111111-2222-3333-4444-555555555555",
+            studyRevision: 42
+        ))
+
+        #expect(observation.code.coding?.isEmpty == false)
+        #expect(observation.category?.first?.coding?.first?.code?.value?.string == "vital-signs")
+        #expect(observation.subject?.reference?.value?.string == "Patient/mhc-compatibility-participant")
+        #expect(observation.effective != nil)
+        #expect(observation.value != nil)
+
+        let encoder = JSONEncoder()
+        encoder.outputFormatting = [.prettyPrinted, .sortedKeys, .withoutEscapingSlashes]
+        var bytes = try encoder.encode(observation)
+        bytes.append(0x0A)
+
+        try FileManager.default.createDirectory(
+            at: exportURL.deletingLastPathComponent(),
+            withIntermediateDirectories: true
+        )
+        try bytes.write(to: exportURL, options: .atomic)
+        #expect(bytes == (try Data(contentsOf: fixtureURL)))
+    }
+}
