+#!/usr/bin/env bash
+#
+# This source file belongs to the My Heart Counts iOS open-source project
+#
+# SPDX-FileCopyrightText: 2026 Stanford University and the project authors (see CONTRIBUTORS.md)
+#
+# SPDX-License-Identifier: MIT
+#
+
+set -euo pipefail
+cd "$(dirname "$0")/.."
+
+readonly fixture="Compatibility/Fixtures/my-heart-counts-ios-e7ae-study-enrollment.json"
+readonly output=".build/compatibility-evidence/my-heart-counts-ios-e7ae/study-enrollment.json"
+readonly export_name="my-heart-counts-ios-e7ae-study-enrollment.json"
+
+xcodebuild test \
+    -project MyHeartCounts.xcodeproj \
+    -scheme MyHeartCounts \
+    -testPlan "MyHeartCounts Unit Tests" \
+    -destination "platform=iOS Simulator,name=iPhone 17 Pro,OS=26.5" \
+    -only-testing:MyHeartCountsTests/StudyEnrollmentEvidenceTests \
+    -parallel-testing-enabled NO \
+    -enableCodeCoverage NO \
+    -skipPackagePluginValidation \
+    -skipMacroValidation \
+    -derivedDataPath .build/compatibility-evidence/DerivedData \
+    CODE_SIGNING_ALLOWED=NO
+cmp "$fixture" "$output"
+
+if [ -n "${MHC_COMPATIBILITY_EXPORT:-}" ]; then
+    case "$MHC_COMPATIBILITY_EXPORT" in
+        /*) ;;
+        *)
+            echo "error: MHC_COMPATIBILITY_EXPORT must be an absolute directory" >&2
+            exit 2
+            ;;
+    esac
+    if [ "$MHC_COMPATIBILITY_EXPORT" = "/" ]; then
+        echo "error: MHC_COMPATIBILITY_EXPORT must not be the filesystem root" >&2
+        exit 2
+    fi
+    mkdir -p "$MHC_COMPATIBILITY_EXPORT"
+    cp "$output" "$MHC_COMPATIBILITY_EXPORT/$export_name"
+    cmp "$fixture" "$MHC_COMPATIBILITY_EXPORT/$export_name"
+fi
