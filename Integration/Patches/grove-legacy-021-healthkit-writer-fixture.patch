+#!/usr/bin/env bash
+#
+# This source file belongs to the Stanford Spezi open-source project
+#
+# SPDX-FileCopyrightText: 2026 Stanford University and the project authors (see CONTRIBUTORS.md)
+#
+# SPDX-License-Identifier: MIT
+#
+
+set -euo pipefail
+cd "$(dirname "$0")/.."
+
+readonly fixture="Compatibility/Fixtures/grove-0.2.1-healthkit-sample.json"
+readonly output=".build/compatibility-evidence/grove-0.2.1/healthkit-sample.json"
+
+./Scripts/run-package-tests.sh SpeziHealthKitFHIR macOS
+cmp "$fixture" "$output"
+
+if [ -n "${GROVE_COMPATIBILITY_EXPORT:-}" ]; then
+    case "$GROVE_COMPATIBILITY_EXPORT" in
+        /*) ;;
+        *)
+            echo "error: GROVE_COMPATIBILITY_EXPORT must be an absolute file path" >&2
+            exit 2
+            ;;
+    esac
+    if [ "$GROVE_COMPATIBILITY_EXPORT" = "/" ]; then
+        echo "error: GROVE_COMPATIBILITY_EXPORT must name a file" >&2
+        exit 2
+    fi
+    mkdir -p "$(dirname "$GROVE_COMPATIBILITY_EXPORT")"
+    cp "$output" "$GROVE_COMPATIBILITY_EXPORT"
+    cmp "$fixture" "$GROVE_COMPATIBILITY_EXPORT"
+fi
diff --git a/Tests/SpeziHealthKitFHIRTests/CompatibilityEvidenceTests.swift b/Tests/SpeziHealthKitFHIRTests/CompatibilityEvidenceTests.swift
new file mode 100644
index 0000000000000000000000000000000000000000..5fe3ba98f453a0ebc371131ffaf6c9a5dab1a7f7
--- /dev/null
+++ b/Tests/SpeziHealthKitFHIRTests/CompatibilityEvidenceTests.swift
@@ -0,0 +1,198 @@
+//
+// This source file belongs to the Stanford Spezi open-source project
+//
+// SPDX-FileCopyrightText: 2026 Stanford University and the project authors (see CONTRIBUTORS.md)
+//
+// SPDX-License-Identifier: MIT
+//
+
+#if canImport(HealthKit)
+
+import Foundation
+import HealthKit
+import ModelsR4
+@testable import SpeziHealthKitFHIR
+import Testing
+
+
+/// Freezes bytes produced by the 0.2.1 HealthKit extension writer. The fixture is evidence from this
+/// exact release, not a hand-authored approximation of its wire format.
+@Suite
+struct CompatibilityEvidenceTests {
+    private static let fixtureName = "grove-0.2.1-healthkit-sample.json"
+    private static let normalizedSampleID = "01234567-89AB-CDEF-0123-456789ABCDEF"
+    private static let retiredSourceDevice = "https://bdh.stanford.edu/fhir/defs/sourceDevice"
+    private static let retiredSourceRevision = "https://bdh.stanford.edu/fhir/defs/sourceRevision"
+    private static let retiredMetadata = "https://bdh.stanford.edu/fhir/defs/metadata"
+
+    private var repositoryRoot: URL {
+        URL(fileURLWithPath: #filePath)
+            .deletingLastPathComponent()
+            .deletingLastPathComponent()
+            .deletingLastPathComponent()
+    }
+
+    private var fixtureURL: URL {
+        repositoryRoot
+            .appending(component: "Compatibility", directoryHint: .isDirectory)
+            .appending(component: "Fixtures", directoryHint: .isDirectory)
+            .appending(component: Self.fixtureName, directoryHint: .notDirectory)
+    }
+
+    private var exportURL: URL {
+        repositoryRoot
+            .appending(component: ".build", directoryHint: .isDirectory)
+            .appending(component: "compatibility-evidence", directoryHint: .isDirectory)
+            .appending(component: "grove-0.2.1", directoryHint: .isDirectory)
+            .appending(component: "healthkit-sample.json", directoryHint: .notDirectory)
+    }
+
+    private func makeSample() -> HKQuantitySample {
+        let device = HKDevice(
+            name: "Compatibility Watch",
+            manufacturer: "Grove Alliance",
+            model: "Fixture-021",
+            hardwareVersion: "1.0",
+            firmwareVersion: "2.1",
+            softwareVersion: "0.2.1",
+            localIdentifier: "legacy-device-021",
+            udiDeviceIdentifier: "urn:oid:1.2.840.10008.1.2.1"
+        )
+        return HKQuantitySample(
+            type: HKQuantityType(.stepCount),
+            quantity: HKQuantity(unit: .count(), doubleValue: 42),
+            start: Date(timeIntervalSince1970: 1_609_459_200),
+            end: Date(timeIntervalSince1970: 1_609_459_260),
+            device: device,
+            metadata: [HKMetadataKeyTimeZone: "UTC"]
+        )
+    }
+
+    /// The public HealthKit initializer intentionally chooses the UUID and source revision. Verify that
+    /// the untouched production conversion used both before normalizing only those volatile leaves.
+    private func assertUnnormalizedProductionTree(_ observation: Observation, sample: HKQuantitySample) throws {
+        #expect(observation.id?.value?.string == sample.uuid.uuidString)
+        #expect(observation.identifier?.count == 1)
+        let identifier = try #require(observation.identifier?.first)
+        #expect(identifier.id?.value?.string == sample.uuid.uuidString)
+        #expect(identifier.value?.value?.string == sample.uuid.uuidString)
+        #expect(identifier.assigner == nil)
+        #expect(identifier.extension == nil)
+        #expect(identifier.period == nil)
+        #expect(identifier.system == nil)
+        #expect(identifier.type == nil)
+        #expect(identifier.use == nil)
+
+        let sourceDevices = observation.extensions(for: Self.retiredSourceDevice)
+        #expect(sourceDevices.count == 1)
+        let sourceDevice = try #require(sourceDevices.first)
+        #expect(sourceDevice.extension?.count == 8)
+
+        let sourceRevisions = observation.extensions(for: Self.retiredSourceRevision)
+        #expect(sourceRevisions.count == 1)
+        let sourceRevision = try #require(sourceRevisions.first)
+        #expect(sourceRevision.extension?.count == 1)
+        let sources = sourceRevision.extensions(for: "\(Self.retiredSourceRevision)/source")
+        #expect(sources.count == 1)
+        let source = try #require(sources.first)
+        #expect(source.extension?.count == 2)
+        // A CI-created, unsaved sample has no public way to construct an HKSource. The production
+        // writer therefore omits these optional revision leaves; the fixture preserves that truth.
+        #expect(sourceRevision.extensions(for: "\(Self.retiredSourceRevision)/version").isEmpty)
+        #expect(sourceRevision.extensions(for: "\(Self.retiredSourceRevision)/productType").isEmpty)
+        #expect(sourceRevision.extensions(for: "\(Self.retiredSourceRevision)/OSVersion").isEmpty)
+
+        let metadataElements = observation.extensions(for: Self.retiredMetadata)
+        #expect(metadataElements.count == 1)
+        let metadata = try #require(metadataElements.first)
+        #expect(metadata.extension?.count == 1)
+        #expect(!metadata.extensions(for: "\(Self.retiredMetadata)/\(HKMetadataKeyTimeZone)").isEmpty)
+    }
+
+    private func replaceStringValue(in element: inout Extension, url: String, with value: String) -> Int {
+        var replacements = 0
+        if element.url.value?.url.absoluteString == url {
+            element.value = .string(value.asFHIRStringPrimitive())
+            replacements += 1
+        }
+        if var children = element.extension {
+            for index in children.indices {
+                replacements += replaceStringValue(in: &children[index], url: url, with: value)
+            }
+            element.extension = children
+        }
+        return replacements
+    }
+
+    /// Stabilizes exactly the values HealthKit does not let callers choose. The replacement source
+    /// name and bundle are deterministic fixture values, not claims about a real `HKSource` identity.
+    /// All resource structure still comes from `HKSample.resource(...)` and the production builders.
+    private func normalizeVolatileExtensionLeaves(_ observation: inout Observation) throws {
+        var extensions = try #require(observation.extension)
+        var normalizedCount = 0
+        for index in extensions.indices {
+            normalizedCount += replaceStringValue(
+                in: &extensions[index],
+                url: "\(Self.retiredSourceRevision)/source/name",
+                with: "Grove Compatibility Source"
+            )
+            normalizedCount += replaceStringValue(
+                in: &extensions[index],
+                url: "\(Self.retiredSourceRevision)/source/bundleIdentifier",
+                with: "org.grovealliance.compatibility-evidence"
+            )
+        }
+        #expect(normalizedCount == 2)
+        observation.extension = extensions
+    }
+
+    private func encodedFixture() throws -> Data {
+        let sample = makeSample()
+        let issued = try Instant(
+            date: Date(timeIntervalSince1970: 1_609_459_320),
+            timeZone: .gmt
+        )
+        let proxy = try sample.resource(issuedDate: FHIRPrimitive(issued))
+        var observation = try #require(proxy.get(if: Observation.self))
+        try assertUnnormalizedProductionTree(observation, sample: sample)
+        try normalizeVolatileExtensionLeaves(&observation)
+
+        let encoder = JSONEncoder()
+        encoder.outputFormatting = [.prettyPrinted, .sortedKeys, .withoutEscapingSlashes]
+        let productionBytes = try encoder.encode(observation)
+        let raw = try #require(
+            JSONSerialization.jsonObject(with: productionBytes) as? [String: Any]
+        )
+        let identifiers = try #require(raw["identifier"] as? [[String: Any]])
+        let identifier = try #require(identifiers.first)
+        let volatileSampleID = sample.uuid.uuidString
+        #expect(raw["id"] as? String == volatileSampleID)
+        #expect(identifier["id"] as? String == volatileSampleID)
+        #expect(identifier["value"] as? String == volatileSampleID)
+
+        let productionJSON = try #require(String(data: productionBytes, encoding: .utf8))
+        #expect(productionJSON.components(separatedBy: volatileSampleID).count - 1 == 3)
+        #expect(volatileSampleID.utf8.count == Self.normalizedSampleID.utf8.count)
+        let normalizedJSON = productionJSON.replacingOccurrences(
+            of: volatileSampleID,
+            with: Self.normalizedSampleID
+        )
+        var bytes = Data(normalizedJSON.utf8)
+        bytes.append(0x0A)
+        return bytes
+    }
+
+    @Test
+    func exactLegacyProductionWriterBytes() throws {
+        let bytes = try encodedFixture()
+        try FileManager.default.createDirectory(
+            at: exportURL.deletingLastPathComponent(),
+            withIntermediateDirectories: true
+        )
+        try bytes.write(to: exportURL, options: .atomic)
+
+        #expect(bytes == (try Data(contentsOf: fixtureURL)))
+    }
+}
+
+#endif
