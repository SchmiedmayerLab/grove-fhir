diff --git a/Tests/FHIRModelsExtensionsTests/LegacyWriterCompatibilityEvidenceTests.swift b/Tests/FHIRModelsExtensionsTests/LegacyWriterCompatibilityEvidenceTests.swift
new file mode 100644
index 0000000000000000000000000000000000000000..67184af3d9bd88a82a9e9e77bc92e2026ec9168a
--- /dev/null
+++ b/Tests/FHIRModelsExtensionsTests/LegacyWriterCompatibilityEvidenceTests.swift
@@ -0,0 +1,189 @@
+//
+// This source file belongs to the Grove open-source project
+//
+// SPDX-FileCopyrightText: 2026 Stanford University and the project authors (see CONTRIBUTORS.md)
+//
+// SPDX-License-Identifier: MIT
+//
+
+@testable import FHIRModelsExtensions
+import Foundation
+import GroveLegacyIdentifiers
+import ModelsR4
+import Testing
+
+
+/// Exercises the current reader against bytes emitted by the exact 0.2.1 writer. Synthetic legacy
+/// extensions remain useful unit tests, but they cannot prove that the frozen historical wire shape
+/// still crosses the release boundary.
+@Suite
+struct LegacyWriterCompatibilityEvidenceTests {
+    private static let sampleID = "01234567-89AB-CDEF-0123-456789ABCDEF"
+    private static let sourceDevice = FHIRExtensionURL(
+        RetiredFHIRCanonicalURLs.sourceDevice.canonical,
+        superseding: RetiredFHIRCanonicalURLs.sourceDevice.superseded
+    )
+    private static let sourceRevision = FHIRExtensionURL(
+        RetiredFHIRCanonicalURLs.sourceRevision.canonical,
+        superseding: RetiredFHIRCanonicalURLs.sourceRevision.superseded
+    )
+    private static let metadata = "https://bdh.stanford.edu/fhir/defs/metadata"
+
+    private static var retiredIdentifiers: [FHIRExtensionURL] {
+        [sourceDevice, sourceRevision]
+    }
+
+    private var trackedFixtureURL: URL {
+        URL(fileURLWithPath: #filePath)
+            .deletingLastPathComponent()
+            .deletingLastPathComponent()
+            .deletingLastPathComponent()
+            .appending(component: "Compatibility", directoryHint: .isDirectory)
+            .appending(component: "Fixtures", directoryHint: .isDirectory)
+            .appending(component: "grove-0.2.1-healthkit-sample.json", directoryHint: .notDirectory)
+    }
+
+    private func fixtureBytes() throws -> Data {
+        let tracked = try Data(contentsOf: trackedFixtureURL)
+        guard let exportedPath = ProcessInfo.processInfo.environment["GROVE_COMPATIBILITY_EXPORT"],
+              !exportedPath.isEmpty else {
+            return tracked
+        }
+
+        try #require(exportedPath.hasPrefix("/"), "GROVE_COMPATIBILITY_EXPORT must be absolute")
+        let exported = try Data(contentsOf: URL(fileURLWithPath: exportedPath))
+        #expect(exported == tracked, "current reader must consume the exact exported 0.2.1 bytes")
+        return exported
+    }
+
+    private func legacyObservation() throws -> Observation {
+        try JSONDecoder().decode(Observation.self, from: fixtureBytes())
+    }
+
+    private func rawFixture() throws -> [String: Any] {
+        try #require(
+            JSONSerialization.jsonObject(with: fixtureBytes()) as? [String: Any]
+        )
+    }
+
+    private func stringValue(_ elements: [Extension]) -> String? {
+        elements.first?.value?.stringValue?.value?.string
+    }
+
+    @Test
+    func readsExactLegacyWriterBytes() throws {
+        let observation = try legacyObservation()
+        let raw = try rawFixture()
+        #expect(raw["resourceType"] as? String == "Observation")
+        #expect(raw["id"] as? String == Self.sampleID)
+        #expect(raw["status"] as? String == "final")
+        #expect(raw["issued"] as? String == "2021-01-01T00:02:00Z")
+
+        let identifiers = try #require(raw["identifier"] as? [[String: Any]])
+        #expect(identifiers.count == 1)
+        #expect(identifiers.first?["id"] as? String == Self.sampleID)
+        #expect(identifiers.first?["value"] as? String == Self.sampleID)
+
+        let code = try #require(raw["code"] as? [String: Any])
+        let codings = try #require(code["coding"] as? [[String: Any]])
+        #expect(codings.count == 2)
+        #expect(codings[0]["code"] as? String == "55423-8")
+        #expect(codings[0]["system"] as? String == "http://loinc.org")
+        #expect(codings[1]["code"] as? String == "HKQuantityTypeIdentifierStepCount")
+        #expect(
+            codings[1]["system"] as? String
+                == "http://developer.apple.com/documentation/healthkit"
+        )
+
+        let effective = try #require(raw["effectivePeriod"] as? [String: Any])
+        #expect(effective["start"] as? String == "2021-01-01T00:00:00Z")
+        #expect(effective["end"] as? String == "2021-01-01T00:01:00Z")
+        let quantity = try #require(raw["valueQuantity"] as? [String: Any])
+        #expect(quantity["unit"] as? String == "steps")
+        #expect((quantity["value"] as? NSNumber)?.intValue == 42)
+
+        let topLevel = try #require(observation.extension)
+        #expect(topLevel.compactMap { $0.url.value?.url.absoluteString } == [
+            Self.sourceDevice.superseded[0].absoluteString,
+            Self.sourceRevision.superseded[0].absoluteString,
+            Self.metadata
+        ])
+
+        let device = try #require(observation.extensions(for: Self.sourceDevice).first)
+        #expect(device.extension?.count == 8)
+        let expectedDevice = [
+            "name": "Compatibility Watch",
+            "manufacturer": "Grove Alliance",
+            "model": "Fixture-021",
+            "hardwareVersion": "1.0",
+            "firmwareVersion": "2.1",
+            "softwareVersion": "0.2.1",
+            "localIdentifier": "legacy-device-021",
+            "UDIDeviceIdentifier": "urn:oid:1.2.840.10008.1.2.1"
+        ]
+        for (component, expected) in expectedDevice {
+            #expect(
+                stringValue(device.extensions(for: Self.sourceDevice.appending(component: component)))
+                    == expected
+            )
+        }
+
+        let revision = try #require(observation.extensions(for: Self.sourceRevision).first)
+        #expect(revision.extension?.count == 1)
+        let sourceIdentifier = Self.sourceRevision.appending(component: "source")
+        let source = try #require(revision.extensions(for: sourceIdentifier).first)
+        #expect(source.extension?.count == 2)
+        #expect(
+            stringValue(source.extensions(for: sourceIdentifier.appending(component: "name")))
+                == "Grove Compatibility Source"
+        )
+        #expect(
+            stringValue(source.extensions(for: sourceIdentifier.appending(component: "bundleIdentifier")))
+                == "org.grovealliance.compatibility-evidence"
+        )
+        for omitted in ["version", "productType", "OSVersion"] {
+            #expect(revision.extensions(for: Self.sourceRevision.appending(component: omitted)).isEmpty)
+        }
+
+        let metadataURL: FHIRPrimitive<FHIRURI> = "https://bdh.stanford.edu/fhir/defs/metadata"
+        let metadata = try #require(observation.extensions(for: metadataURL).first)
+        #expect(metadata.extension?.count == 1)
+        let timeZoneURL: FHIRPrimitive<FHIRURI> = "https://bdh.stanford.edu/fhir/defs/metadata/HKTimeZone"
+        #expect(
+            stringValue(metadata.extensions(for: timeZoneURL)) == "UTC"
+        )
+    }
+
+    @Test
+    func lookupIsBoundedToDeclaredSpellings() throws {
+        for identifier in Self.retiredIdentifiers {
+            let legacy = try #require(identifier.superseded.first)
+            var observation = try legacyObservation()
+            observation.extension = [
+                Extension(
+                    // swiftlint:disable:next force_unwrapping
+                    url: URL(string: legacy.absoluteString + "-other")!.asFHIRURIPrimitive(),
+                    value: .string("not the declared identifier".asFHIRStringPrimitive())
+                )
+            ]
+
+            #expect(observation.extensions(for: identifier).isEmpty)
+        }
+    }
+
+    @Test
+    func canonicalSpellingWinsOverTheFrozenLegacyCopy() throws {
+        for identifier in Self.retiredIdentifiers {
+            var observation = try legacyObservation()
+            observation.extension?.append(
+                Extension(url: identifier, value: .string("canonical".asFHIRStringPrimitive()))
+            )
+
+            let resolved = observation.extensions(for: identifier)
+            #expect(resolved.count == 1)
+            #expect(resolved.first?.url.value?.url.absoluteString == identifier.url.absoluteString)
+            #expect(stringValue(resolved) == "canonical")
+        }
+    }
+
+}
