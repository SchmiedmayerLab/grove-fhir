@@ -0,0 +1,567 @@
+//
+// This source file is part of the
+// Grove open-source project
+//
+// SPDX-FileCopyrightText: 2026 Stanford University and the project authors (see CONTRIBUTORS.md)
+//
+// SPDX-License-Identifier: MIT
+//
+
+#if canImport(HealthKit)
+
+// The contract matrix intentionally remains together, and nested FHIR constructors
+// are kept compact enough to show complete coding/system/value tuples at a glance.
+// swiftlint:disable file_length
+// swiftlint:disable type_body_length multiline_literal_brackets
+
+import FHIRModelsExtensions
+import GroveFoundation
+@testable import GroveHealthKitFHIR
+import HealthKit
+import ModelsR4
+import Testing
+
+
+@Suite
+struct MobileContractTests {
+    private let subject = Reference(reference: "Patient/example")
+    private let start = Date(timeIntervalSince1970: 1_721_314_800)
+    private let end = Date(timeIntervalSince1970: 1_721_318_400)
+    private let issued: FHIRPrimitive<Instant> = "2024-07-18T16:00:05Z"
+
+    private func sample(
+        _ type: HKQuantityTypeIdentifier = .stepCount,
+        unit: HKUnit = .count(),
+        value: Double = 42,
+        device: HKDevice? = nil,
+        metadata: [String: Any] = [:]
+    ) -> HKQuantitySample {
+        HKQuantitySample(
+            type: HKQuantityType(type),
+            quantity: HKQuantity(unit: unit, doubleValue: value),
+            start: start,
+            end: end,
+            device: device,
+            metadata: metadata.isEmpty ? nil : metadata
+        )
+    }
+
+    private func observation(
+        from sample: HKQuantitySample,
+        method: GroveRecordingMethod? = nil,
+        gateway: Device? = nil,
+        studies: [Reference] = []
+    ) throws -> Observation {
+        let proxy = try sample.resource(
+            issuedDate: issued,
+            subject: subject,
+            recordingMethod: method,
+            gatewayDevice: gateway,
+            researchStudies: studies
+        )
+        return try #require(proxy.get(if: Observation.self))
+    }
+
+    private func extensionValue(
+        _ observation: Observation,
+        url: FHIRPrimitive<FHIRURI>
+    ) -> Extension.ValueX? {
+        observation.extension?.first { $0.url == url }?.value
+    }
+
+    @Test
+    func healthKitIdentityIsACompleteCanonicalBusinessIdentifier() throws {
+        let source = sample()
+        let result = try observation(from: source)
+        let identifier = try #require(result.identifier?.only)
+
+        #expect(result.id == nil)
+        #expect(identifier.system == GroveFHIRVocabulary.healthKitObjectIdentifier)
+        #expect(identifier.value?.value?.string == source.uuid.uuidString.lowercased())
+        #expect(identifier.value?.value?.string == identifier.value?.value?.string.lowercased())
+        #expect(identifier.value?.value?.string.contains("-") == true)
+        #expect(result.meta?.source == nil)
+        #expect(result.meta?.tag == nil)
+    }
+
+    @Test
+    func intervalStepCountPreservesTheSourceCount() throws {
+        let result = try observation(from: sample())
+        #expect(result.meta?.profile == [
+            GroveFHIRVocabulary.healthKitObservationProfile,
+            GroveFHIRVocabulary.mobileStepCountProfile
+        ])
+        #expect(result.code.coding == [Coding(
+            code: "step-count-total",
+            display: "Step count total",
+            system: GroveFHIRVocabulary.mobileMeasurement
+        )])
+        #expect(result.value == .quantity(Quantity(
+            code: "{steps}",
+            system: GroveFHIRVocabulary.ucum,
+            unit: "steps",
+            value: 42.asFHIRDecimalPrimitive()
