+        let heartRate = try observation(from: sample(
+            .heartRate,
+            unit: .count().unitDivided(by: .minute()),
+            value: 72,
+            metadata: [
+                HKMetadataKeyHeartRateMotionContext: HKHeartRateMotionContext.active.rawValue,
+                HKMetadataKeyExternalUUID: "must-not-be-copied"
+            ]
+        ))
+        let sourceMetadata = try #require(heartRate.component?.first {
+            $0.code.coding?.contains {
+                $0.system == GroveFHIRVocabulary.healthKitMetadataKey
+                    && $0.code?.value?.string == HKMetadataKeyHeartRateMotionContext
+            } == true
+        })
+        #expect(sourceMetadata.value == .codeableConcept(CodeableConcept(coding: [Coding(
+            code: "active",
+            display: "Active",
+            system: GroveFHIRVocabulary.healthKitHeartRateMotionContext
+        )])))
+
+        let notSet = try observation(from: sample(
+            .heartRate,
+            unit: .count().unitDivided(by: .minute()),
+            value: 72,
+            metadata: [
+                HKMetadataKeyHeartRateMotionContext: HKHeartRateMotionContext.notSet.rawValue
+            ]
+        ))
+        #expect(notSet.component?.only?.value == .codeableConcept(CodeableConcept(coding: [Coding(
+            code: "not-set",
+            display: "Not Set",
+            system: GroveFHIRVocabulary.healthKitHeartRateMotionContext
+        )])))
+
+        let unknown = try observation(from: sample(
+            .heartRate,
+            unit: .count().unitDivided(by: .minute()),
+            value: 72,
+            metadata: [HKMetadataKeyHeartRateMotionContext: 999]
+        ))
+        #expect(unknown.component == nil)
+
+        let step = try observation(from: sample(metadata: [
+            HKMetadataKeyHeartRateMotionContext: HKHeartRateMotionContext.active.rawValue,
+            HKMetadataKeyExternalUUID: "must-not-be-copied"
+        ]))
+        #expect(step.component?.contains {
