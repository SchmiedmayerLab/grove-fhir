+
+#if canImport(HealthKit)
+
+public import FHIRModelsExtensions
+import Foundation
+public import HealthKit
+public import ModelsR4
+
+
+/// The resources produced by converting one HealthKit object under the Grove Mobile contract.
+///
+/// The Observation contains the clinical result and recording-device/gateway links. The
+/// Provenance independently records the source object, the HealthKit-reported source that
+/// authored it, and the application that performed the FHIR transformation.
+public struct HealthKitFHIRConversion: Sendable {
+    /// The converted clinical result.
+    public let observation: Observation
+    /// The transformation event that produced ``observation``.
+    public let provenance: Provenance
+
+    /// Both resources, suitable for inserting into a Bundle or repository transaction.
+    public var resources: [ResourceProxy] {
+        [ResourceProxy(with: observation), ResourceProxy(with: provenance)]
+    }
+}
+
+
+/// Caller-established classification for the author reported by `HKSourceRevision`.
+///
+/// HealthKit exposes the same `HKSource` shape for applications and direct devices and
+/// provides no discriminator. Grove therefore emits no author by default. Supplying a
+/// case classifies the source kind, but never supplies its identity: Grove derives the
+/// name, identifier, and version from this sample's `sourceRevision`. The Bluetooth Low
+/// Energy device case additionally asserts that exchanging its linkable identifier is
+/// authorized by the applicable privacy policy.
+public enum HealthKitSourceActor: Sendable {
+    /// Classifies the sample's reported source as an application product.
+    case application
+    /// Classifies the sample's reported source as a supported Bluetooth Low Energy device
+    /// whose HealthKit-provided linkable UUID is authorized for exchange.
+    case bluetoothLowEnergyDevice
+}
+
+
+@available(iOS 18, macOS 15, watchOS 11, *)
+extension HKSample {
+    /// Converts the sample and records the conversion as FHIR Provenance.
+    ///
+    /// - Parameters:
+    ///   - mapping: The clinical mapping to apply.
+    ///   - issuedDate: When the FHIR result was made available. Defaults to now.
+    ///   - subject: The Patient this result concerns.
+    ///   - converterApplication: The application Device that performed this conversion.
+    ///     It must have at least one complete identifier and a user-friendly name.
+    ///   - sourceActor: Caller-established source-author classification. Grove derives
+    ///     identity from this sample's `HKSourceRevision`. Omit when the source cannot be
+    ///     safely classified or a device identifier is not authorized for exchange.
+    ///   - recordingMethod: A recording method established by the caller. An explicit
+    ///     HealthKit user-entered flag takes precedence.
+    ///   - gatewayDevice: The Device that actually mediated the exchange, when known.
+    ///   - researchStudies: ResearchStudy resources governing the collection. Protocol
+    ///     attribution is represented by each study's versioned PlanDefinition reference.
+    ///   - extensions: Additional Observation extension builders.
+    public func fhirConversion( // swiftlint:disable:this type_contents_order
+        withMapping mapping: SampleTypesFHIRMapping = .default,
+        issuedDate: FHIRPrimitive<Instant>? = nil,
+        subject: Reference,
+        converterApplication: Device,
+        sourceActor: HealthKitSourceActor? = nil,
+        recordingMethod: GroveRecordingMethod? = nil,
+        gatewayDevice: Device? = nil,
+        researchStudies: [Reference] = [],
+        extensions: [any FHIRExtensionBuilderProtocol] = []
+    ) throws -> HealthKitFHIRConversion {
+        if let sourceActor,
+           case .bluetoothLowEnergyDevice = sourceActor,
+           (self as? HKQuantitySample)?.quantityType.identifier
+               != HKQuantityTypeIdentifier.heartRate.rawValue {
+            throw GroveHealthKitFHIRError.notSupported
+        }
+        let resource = try resource(
+            withMapping: mapping,
+            issuedDate: issuedDate,
+            subject: subject,
+            recordingMethod: recordingMethod,
+            gatewayDevice: gatewayDevice,
+            researchStudies: researchStudies,
+            extensions: extensions
+        )
+        guard let observation = resource.get(if: Observation.self),
+              let recorded = observation.issued,
+              let sourceIdentifier = observation.identifier?.first(where: {
+                  $0.system == GroveFHIRVocabulary.healthKitObjectIdentifier
+                      && $0.value?.value?.string.isEmpty == false
+              }) else {
+            throw GroveHealthKitFHIRError.invalidValue
+        }
+        let provenance = try conversionProvenance(
+            target: sourceIdentifier,
+            recorded: recorded,
+            converterApplication: converterApplication,
+            sourceActor: sourceActor
+        )
+        return HealthKitFHIRConversion(
+            observation: observation,
+            provenance: provenance
+        )
+    }
+
+    // Kept as one constructor so all Provenance role/link invariants are visible together.
+    private func conversionProvenance( // swiftlint:disable:this function_body_length type_contents_order
+        target sourceIdentifier: Identifier,
+        recorded: FHIRPrimitive<Instant>,
+        converterApplication: Device,
+        sourceActor: HealthKitSourceActor?
+    ) throws -> Provenance {
+        let converter = try converterApplication.groveApplication(
+            id: "converter-application",
+            requireSoftwareVersion: true
+        )
+
+        var contained = [ResourceProxy(with: converter)]
+        var sourceAgents: [ProvenanceAgent] = []
+        if let sourceActor {
+            let sourceDevice = try sourceDevice(for: sourceActor)
+            guard let sourceLocalID = sourceDevice.id?.value?.string,
+                  !sourceLocalID.isEmpty else {
+                throw GroveHealthKitFHIRError.invalidValue
+            }
+            contained.append(ResourceProxy(with: sourceDevice))
+            sourceAgents = [
+                ProvenanceAgent(
+                    type: CodeableConcept(coding: [
+                        Coding(
+                            code: "author",
+                            display: "Author",
+                            system: "http://terminology.hl7.org/CodeSystem/provenance-participant-type"
+                        )
+                    ]),
+                    who: Reference(reference: "#\(sourceLocalID)".asFHIRStringPrimitive())
+                )
+            ]
+        }
+
+        return Provenance(
+            activity: CodeableConcept(coding: [
+                Coding(
+                    code: "transform",
+                    display: "Transform/Translate Record Lifecycle Event",
+                    system: "http://terminology.hl7.org/CodeSystem/iso-21089-lifecycle"
+                )
+            ]),
+            agent: [
+                ProvenanceAgent(
+                    type: CodeableConcept(coding: [
+                        Coding(
+                            code: "assembler",
+                            display: "Assembler",
+                            system: "http://terminology.hl7.org/CodeSystem/provenance-participant-type"
+                        )
+                    ]),
+                    who: Reference(reference: "#converter-application")
+                )
+            ],
+            contained: contained,
+            entity: [
+                ProvenanceEntity(
+                    agent: sourceAgents.isEmpty ? nil : sourceAgents,
+                    role: FHIRPrimitive(.source),
+                    what: Reference(identifier: sourceIdentifier)
+                )
+            ],
+            meta: Meta(profile: [GroveFHIRVocabulary.conversionProvenanceProfile]),
+            recorded: recorded,
+            target: [
+                Reference(
+                    identifier: sourceIdentifier,
+                    type: "Observation"
+                )
+            ]
+        )
+    }
+
+    private func sourceDevice(
+        for sourceActor: HealthKitSourceActor
+    ) throws -> Device {
+        let revision = sourceRevision
+        let source = revision.source
+        switch sourceActor {
+        case .application:
+            return try Self.makeSourceApplication(
+                name: source.name,
+                bundleIdentifier: source.bundleIdentifier,
+                version: revision.version
+            )
+        case .bluetoothLowEnergyDevice:
+            guard let identifier = UUID(uuidString: source.bundleIdentifier) else {
+                throw GroveHealthKitFHIRError.invalidValue
+            }
+            return Self.makeBluetoothLowEnergySourceDevice(
+                name: source.name,
+                identifier: identifier
+            )
+        }
+    }
+
+    /// Builds an application author from the sample's HealthKit source revision after the
+    /// caller has established the source kind.
+    ///
+    /// The bundle identifier identifies the application product, not an installation.
+    /// `HKSourceRevision.version` is documented as the source's version string and is
+    /// placed in the typed application-software version slice when present.
+    static func makeSourceApplication(
+        name rawName: String,
+        bundleIdentifier rawBundleIdentifier: String,
+        version rawVersion: String?
+    ) throws -> Device {
+        let name = rawName.trimmingCharacters(in: .whitespacesAndNewlines)
+        let bundleIdentifier = rawBundleIdentifier
+            .trimmingCharacters(in: .whitespacesAndNewlines)
+        guard !name.isEmpty, !bundleIdentifier.isEmpty else {
+            throw GroveHealthKitFHIRError.invalidValue
+        }
+        var source = Device()
+        source.identifier = [
+            Identifier(
+                system: GroveFHIRVocabulary.appleBundleIdentifier,
+                value: bundleIdentifier.asFHIRStringPrimitive()
+            )
+        ]
+        source.deviceName = [
+            DeviceDeviceName(
+                name: name.asFHIRStringPrimitive(),
+                type: FHIRPrimitive(.userFriendlyName)
+            )
+        ]
+        if let version = rawVersion?.trimmingCharacters(in: .whitespacesAndNewlines),
+           !version.isEmpty {
+            source.version = [
+                DeviceVersion(
+                    type: CodeableConcept(coding: [
+                        Coding(
+                            code: "531975",
+                            display: "MDC_ID_PROD_SPEC_SW",
+                            system: GroveFHIRVocabulary.mdc
+                        )
+                    ]),
+                    value: version.asFHIRStringPrimitive()
+                )
+            ]
+        }
+        return try source.groveApplication(
+            id: "source-application",
+            requireSoftwareVersion: false
+        )
+    }
+
+    /// Builds a source Device from the sample's HealthKit source revision only after the
+    /// caller has established a supported direct Bluetooth Low Energy source and
+    /// authorized disclosure of its linkable UUID.
+    static func makeBluetoothLowEnergySourceDevice(
+        name rawName: String?,
+        identifier: UUID
+    ) -> Device {
+        let name = rawName?.trimmingCharacters(in: .whitespacesAndNewlines)
+        var source = Device()
+        source.id = "source-device"
+        source.identifier = [
+            Identifier(
+                system: GroveFHIRVocabulary.healthKitSourceDeviceIdentifier,
+                value: identifier.uuidString.lowercased().asFHIRStringPrimitive()
+            )
+        ]
+        if let name, !name.isEmpty {
+            source.deviceName = [
+                DeviceDeviceName(
+                    name: name.asFHIRStringPrimitive(),
+                    type: FHIRPrimitive(.userFriendlyName)
+                )
+            ]
+        }
+        return source
+    }
+}
+
+#endif
