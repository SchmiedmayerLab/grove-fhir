diff --git a/Tests/GroveQuestionnaireTests/FHIRQuestionnaireContractTests.swift b/Tests/GroveQuestionnaireTests/FHIRQuestionnaireContractTests.swift
new file mode 100644
index 0000000000000000000000000000000000000000..f5339fe51c63cab6a91d3f0e5a5acea2ae95c17e
--- /dev/null
+++ b/Tests/GroveQuestionnaireTests/FHIRQuestionnaireContractTests.swift
@@ -0,0 +1,283 @@
+//
+// This source file belongs to the Grove open-source project
+//
+// SPDX-FileCopyrightText: 2026 Stanford University and the project authors (see CONTRIBUTORS.md)
+//
+// SPDX-License-Identifier: MIT
+//
+
+import Foundation
+@testable import GroveQuestionnaire
+@testable import GroveQuestionnaireFHIR
+import ModelsR4
+import Testing
+
+
+/// Pins the published Questionnaire contract independently from renderer behavior.
+@Suite
+struct FHIRQuestionnaireContractTests {
+    private static let url = URL(string: "https://example.org/fhir/Questionnaire/contract")!
+
+    private func questionnaire(
+        version: String? = "1.0.0",
+        task: GroveQuestionnaire.Questionnaire.Task? = nil,
+        constraints: [GroveQuestionnaire.Questionnaire.Task.Constraint] = []
+    ) -> GroveQuestionnaire.Questionnaire {
+        GroveQuestionnaire.Questionnaire(
+            metadata: .init(
+                id: Self.url.absoluteString,
+                url: Self.url,
+                version: version,
+                title: "Contract",
+                explainer: "",
+                constraints: constraints
+            ),
+            sections: [
+                .init(id: "main", tasks: [task ?? .init(id: "consent", title: "Consent?", kind: .boolean)])
+            ]
+        )
+    }
+
+    private func fhirPath(_ source: String, language: String = "text/fhirpath") -> ModelsR4.Expression {
+        .init(
+            expression: source.asFHIRStringPrimitive(),
+            language: language.asFHIRStringPrimitive()
+        )
+    }
+
+    private func fhirQuestionnaire(item: ModelsR4.QuestionnaireItem) -> ModelsR4.Questionnaire {
+        var source = ModelsR4.Questionnaire(status: .init(.active))
+        source.url = Self.url.asFHIRURIPrimitive()
+        source.version = "1.0.0".asFHIRStringPrimitive()
+        source.item = [item]
+        return source
+    }
+
+    @Test(arguments: [
+        (version: "0.0.0", isValid: true),
+        (version: "1.2.3-alpha.1+build.7", isValid: true),
+        (version: "1.2", isValid: false),
+        (version: "01.2.3", isValid: false),
+        (version: "1.2.3-01", isValid: false)
+    ])
+    func profileExportRequiresSemanticVersion(version: String, isValid: Bool) throws {
+        if isValid {
+            #expect(try ModelsR4.Questionnaire(questionnaire(version: version)).version?.value?.string == version)
+        } else {
+            #expect(throws: FHIRExportError.self) {
+                try ModelsR4.Questionnaire(questionnaire(version: version))
+            }
+        }
+    }
+
+    @Test
+    func profileExportRequiresURLAndVersion() {
+        let noURL = GroveQuestionnaire.Questionnaire(
+            metadata: .init(id: "local", url: nil, version: "1.0.0", title: "Local", explainer: ""),
+            sections: [.init(id: "main", tasks: [.init(id: "q", title: "Q", kind: .boolean)])]
+        )
+        #expect(throws: FHIRExportError.self) { try ModelsR4.Questionnaire(noURL) }
+        #expect(throws: FHIRExportError.self) { try ModelsR4.Questionnaire(questionnaire(version: nil)) }
+    }
+
+    @Test
+    func exportUsesOnlyCurrentProfilesAndSemverAlgorithm() throws {
+        let fhir = try ModelsR4.Questionnaire(questionnaire())
+        #expect(fhir.meta?.profile?.map(\.value?.url.absoluteString) == [QuestionnaireFHIRContract.questionnaireProfile])
+        let algorithm = try #require(fhir.extensions(
+            for: "http://hl7.org/fhir/StructureDefinition/artifact-versionAlgorithm"
+        ).first)
+        guard case .coding(let coding)? = algorithm.value else {
+            Issue.record("Expected artifact-versionAlgorithm.valueCoding")
+            return
+        }
+        #expect(coding.system?.value?.url.absoluteString == "http://hl7.org/fhir/version-algorithm")
+        #expect(coding.code?.value?.string == "semver")
+        let encoded = String(decoding: try JSONEncoder().encode(ResourceProxy(with: fhir)), as: UTF8.self)
+        #expect(!encoded.contains("grovealliance.org/fhir/core/StructureDefinition/grove-questionnaire"))
+    }
+
+    @Test
+    func regexBecomesCompleteStandardTargetConstraint() throws {
+        let regex = try NSRegularExpression(pattern: "[A-Z]{2}[0-9]{2}")
+        let task = GroveQuestionnaire.Questionnaire.Task(
+            id: "code",
+            title: "Code",
+            kind: .freeText(.init(regex: regex))
+        )
+        let fhir = try ModelsR4.Questionnaire(questionnaire(task: task))
+        let item = try #require(fhir.item?.first)
+        #expect(item.extensions(for: "http://hl7.org/fhir/StructureDefinition/regex").isEmpty)
+        let constraint = try #require(item.extensions(
+            for: "http://hl7.org/fhir/StructureDefinition/targetConstraint"
+        ).first)
+        let names = Set((constraint.extension ?? []).compactMap { $0.url.value?.url.absoluteString })
+        #expect(names == ["key", "severity", "expression", "human"])
+        guard case .expression(let expression)? = constraint.extension?.first(where: {
+            $0.url.value?.url.absoluteString == "expression"
+        })?.value else {
+            Issue.record("Expected targetConstraint.expression")
+            return
+        }
+        #expect(expression.language.value?.string == "text/fhirpath")
+        #expect(expression.expression?.value?.string.contains("answer.value.matches") == true)
+    }
+
+    @Test
+    func unrepresentableRegexOptionsFailPrecisely() throws {
+        let task = GroveQuestionnaire.Questionnaire.Task(
+            id: "code",
+            title: "Code",
+            kind: .freeText(.init(regex: try NSRegularExpression(pattern: "abc", options: .caseInsensitive)))
+        )
+        do {
+            _ = try ModelsR4.Questionnaire(questionnaire(task: task))
+            Issue.record("Expected regex options to be rejected")
+        } catch {
+            #expect(error.localizedDescription.contains("cannot be represented portably"))
+        }
+    }
+
+    @Test(arguments: [
+        (
+            valueKind: GroveQuestionnaire.Questionnaire.Task.Kind.NumericTaskConfig.ValueKind.integer,
+            itemType: QuestionnaireItemType.integer
+        ),
+        (
+            valueKind: GroveQuestionnaire.Questionnaire.Task.Kind.NumericTaskConfig.ValueKind.quantity,
+            itemType: QuestionnaireItemType.quantity
+        )
+    ])
+    func maxDecimalPlacesRejectsNonDecimalItems(
+        valueKind: GroveQuestionnaire.Questionnaire.Task.Kind.NumericTaskConfig.ValueKind,
+        itemType: QuestionnaireItemType
+    ) {
+        let task = GroveQuestionnaire.Questionnaire.Task(
+            id: "number",
+            title: "Number",
+            kind: .numeric(.init(
+                inputMode: .numberPad(valueKind == .integer ? .integer : .decimal),
+                maxDecimalPlaces: 2,
+                valueKind: valueKind
+            ))
+        )
+        #expect(throws: FHIRExportError.self) {
+            try ModelsR4.Questionnaire(questionnaire(task: task))
+        }
+
+        var item = ModelsR4.QuestionnaireItem(linkId: "number".asFHIRStringPrimitive(), type: .init(itemType))
+        item.text = "Number".asFHIRStringPrimitive()
+        item.extension = [Extension(
+            url: "http://hl7.org/fhir/StructureDefinition/maxDecimalPlaces",
+            value: .integer(FHIRPrimitive(FHIRInteger(2)))
+        )]
+        #expect(throws: GroveQuestionnaire.Questionnaire.FHIRConversionError.self) {
+            try GroveQuestionnaire.Questionnaire(fhirQuestionnaire(item: item))
+        }
+    }
+
+    @Test
+    func questionnaireRootConstraintRoundTripsAndBlocksCompletion() throws {
+        let constraint = GroveQuestionnaire.Questionnaire.Task.Constraint(
+            expression: "%resource.item.where(linkId = 'consent').answer.value.first() = true",
+            humanDescription: "Consent is required.",
+            severity: .error,
+            key: "consent-required"
+        )
+        let authored = questionnaire(constraints: [constraint])
+        let fhir = try ModelsR4.Questionnaire(authored)
+        #expect(fhir.extensions(for: "http://hl7.org/fhir/StructureDefinition/targetConstraint").count == 1)
+        let imported = try GroveQuestionnaire.Questionnaire(fhir)
+        #expect(imported.metadata.constraints == [constraint])
+        let responses = QuestionnaireResponses(questionnaire: imported)
+        responses.responses["consent"] = .init(value: .bool(false))
+        #expect(try ModelsR4.QuestionnaireResponse(responses).status.value == .inProgress)
+        #expect(throws: (any Error).self) {
+            try ModelsR4.QuestionnaireResponse(responses, status: .completed)
+        }
+        responses.responses["consent"] = .init(value: .bool(true))
+        #expect(try ModelsR4.QuestionnaireResponse(responses, status: .completed).status.value == .completed)
+    }
+
+    @Test(arguments: ["notAFunction()", "1 +"])
+    func unsupportedFHIRPathIsRejectedBeforeAdministration(expression: String) {
+        var item = ModelsR4.QuestionnaireItem(linkId: "q".asFHIRStringPrimitive(), type: .init(.boolean))
+        item.text = "Q".asFHIRStringPrimitive()
+        item.extension = [Extension(
+            url: "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-enableWhenExpression",
+            value: .expression(fhirPath(expression))
+        )]
+        #expect(throws: GroveQuestionnaire.Questionnaire.FHIRConversionError.self) {
+            try GroveQuestionnaire.Questionnaire(fhirQuestionnaire(item: item))
+        }
+    }
+
+    @Test
+    func populationFailureIsVisibleButOnlyBlocksTerminalExport() throws {
+        var item = ModelsR4.QuestionnaireItem(linkId: "name".asFHIRStringPrimitive(), type: .init(.string))
+        item.text = "Name".asFHIRStringPrimitive()
+        item.required = FHIRPrimitive(FHIRBool(false))
+        item.extension = [Extension(
+            url: "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-initialExpression",
+            value: .expression(fhirPath("%patient.name.first().text"))
+        )]
+        let imported = try GroveQuestionnaire.Questionnaire(fhirQuestionnaire(item: item))
+        let responses = QuestionnaireResponses(questionnaire: imported)
+        #expect(responses.expressionFailures.count == 1)
+        #expect(try ModelsR4.QuestionnaireResponse(responses, status: .inProgress).status.value == .inProgress)
+        #expect(throws: (any Error).self) {
+            try ModelsR4.QuestionnaireResponse(responses, status: .completed)
+        }
+    }
+
+    @Test
+    func terminalExportRejectsEnabledRequiredUnansweredItem() throws {
+        let responses = QuestionnaireResponses(questionnaire: questionnaire())
+        #expect(try ModelsR4.QuestionnaireResponse(responses).status.value == .inProgress)
+        #expect(throws: (any Error).self) {
+            try ModelsR4.QuestionnaireResponse(responses, status: .completed)
+        }
+        #expect(throws: (any Error).self) {
+            try ModelsR4.QuestionnaireResponse(responses, status: .amended)
+        }
+    }
+
+    @Test
+    func responseImporterPreservesExchangeMetadataAndExactCanonical() throws {
+        let questionnaire = questionnaire()
+        let responses = QuestionnaireResponses(
+            id: UUID(uuidString: "11111111-2222-3333-4444-555555555555")!,
+            questionnaire: questionnaire
+        )
+        responses.responses["consent"] = .init(value: .bool(true))
+        let authored = Date(timeIntervalSince1970: 1_700_000_000)
+        let original = try ModelsR4.QuestionnaireResponse(
+            responses,
+            subject: Reference(reference: "Patient/example"),
+            author: Reference(reference: "Practitioner/author"),
+            source: Reference(reference: "Patient/example"),
+            status: .amended,
+            identifier: Identifier(
+                system: "https://example.org/fhir/NamingSystem/responses".asFHIRURIPrimitive(),
+                value: "response-42".asFHIRStringPrimitive()
+            ),
+            authored: authored
+        )
+        let imported = try QuestionnaireResponses(original, questionnaire: questionnaire)
+        let reexported = try ModelsR4.QuestionnaireResponse(imported)
+        #expect(reexported.questionnaire == original.questionnaire)
+        #expect(reexported.identifier == original.identifier)
+        #expect(reexported.status == original.status)
+        #expect(reexported.authored == original.authored)
+        #expect(reexported.subject == original.subject)
+        #expect(reexported.author == original.author)
+        #expect(reexported.source == original.source)
+        #expect(reexported.extension == original.extension)
+
+        var mismatched = original
+        mismatched.questionnaire = FHIRPrimitive(Canonical(Self.url, version: "2.0.0"))
+        #expect(throws: FHIRResponseImportError.self) {
+            try QuestionnaireResponses(mismatched, questionnaire: questionnaire)
+        }
+    }
+}
