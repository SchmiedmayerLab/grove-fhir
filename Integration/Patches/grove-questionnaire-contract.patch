+            type: source.type?.value?.url.absoluteString,
+            identifier: source.identifier.map {
+                .init(
+                    system: $0.system?.value?.url.absoluteString,
+                    value: $0.value?.value?.string
+                )
+            },
+            display: source.display?.value?.string
+        )
+    }
+}
