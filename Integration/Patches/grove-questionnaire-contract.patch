index 0000000000000000000000000000000000000000..f8d92cb42235073be0c14780d3a93d46757b4062
--- /dev/null
+++ b/Scripts/test-questionnaire-pair.py
@@ -0,0 +1,139 @@
+#!/usr/bin/env python3
+"""Run deterministic positive and one-mutation negative tests for the pair checker."""
+
+from __future__ import annotations
+
+import argparse
+import copy
+import importlib.util
+import json
+import sys
+from pathlib import Path
+from typing import Any
+
+
+SCRIPT_DIRECTORY = Path(__file__).resolve().parent
+CHECKER_PATH = SCRIPT_DIRECTORY / "validate-questionnaire-pair.py"
+DEFAULT_MANIFEST = (
+    SCRIPT_DIRECTORY.parent
+    / "Tests/GroveQuestionnaireTests/Fixtures/GroveQuestionnaireConformance/paired/invalid-cases.json"
+)
+
+
+def load_checker() -> Any:
+    spec = importlib.util.spec_from_file_location("grove_questionnaire_pair_checker", CHECKER_PATH)
+    if spec is None or spec.loader is None:
+        raise RuntimeError(f"Unable to load {CHECKER_PATH}")
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[spec.name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+def pointer_parts(pointer: str) -> list[str]:
+    if pointer == "":
+        return []
+    if not pointer.startswith("/"):
+        raise ValueError(f"JSON Pointer must start with '/': {pointer}")
+    return [part.replace("~1", "/").replace("~0", "~") for part in pointer[1:].split("/")]
+
+
+def resolve_parent(document: Any, pointer: str) -> tuple[Any, str]:
+    parts = pointer_parts(pointer)
+    if not parts:
+        raise ValueError("Mutation of the document root is not supported")
+    current = document
+    for part in parts[:-1]:
+        current = current[int(part)] if isinstance(current, list) else current[part]
+    return current, parts[-1]
+
+
+def get_pointer(document: Any, pointer: str) -> Any:
+    current = document
+    for part in pointer_parts(pointer):
+        current = current[int(part)] if isinstance(current, list) else current[part]
+    return current
+
+
+def pop_pointer(document: Any, pointer: str) -> Any:
+    parent, key = resolve_parent(document, pointer)
+    return parent.pop(int(key)) if isinstance(parent, list) else parent.pop(key)
+
+
+def apply_mutation(resources: dict[str, Any], mutation: dict[str, Any]) -> None:
+    document = resources[mutation["resource"]]
+    operation = mutation["op"]
+    if operation == "set":
+        parent, key = resolve_parent(document, mutation["pointer"])
+        if isinstance(parent, list):
+            parent[int(key)] = mutation["value"]
+        else:
+            parent[key] = mutation["value"]
+    elif operation == "append":
+        get_pointer(document, mutation["pointer"]).append(mutation["value"])
+    elif operation == "move":
+        moved = pop_pointer(document, mutation["from"])
+        get_pointer(document, mutation["pointer"]).append(moved)
+    else:
+        raise ValueError(f"Unsupported mutation operation '{operation}'")
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--manifest", type=Path, default=DEFAULT_MANIFEST)
+    parser.add_argument("--package", action="append", type=Path, default=[])
+    args = parser.parse_args()
+    checker = load_checker()
+    manifest_path = args.manifest.resolve()
+    manifest = json.loads(manifest_path.read_text())
+    if manifest.get("schemaVersion") != 1:
+        raise ValueError("Unsupported mutation manifest schema")
+
+    bases: dict[str, dict[str, Any]] = {}
+    for name, definition in manifest["bases"].items():
+        value_set_paths = [(manifest_path.parent / path).resolve() for path in definition.get("valueSets", [])]
+        bases[name] = {
+            "questionnaire": json.loads((manifest_path.parent / definition["questionnaire"]).read_text()),
+            "response": json.loads((manifest_path.parent / definition["response"]).read_text()),
+            "valueSets": checker.load_value_sets(value_set_paths, args.package),
+        }
+        findings = checker.validate_pair(
+            bases[name]["questionnaire"], bases[name]["response"], bases[name]["valueSets"]
+        )
+        if findings:
+            print(f"Base '{name}' is invalid:", file=sys.stderr)
+            for finding in findings:
+                print(f"  {finding}", file=sys.stderr)
+            return 1
+
+    # Status-aware requiredness: the same unanswered item is allowed while work is in progress.
+    in_progress = copy.deepcopy(bases["emitted"])
+    in_progress["response"]["status"] = "in-progress"
+    in_progress["response"]["item"][0]["item"][1]["answer"][0]["item"][0]["answer"] = []
+    if checker.validate_pair(in_progress["questionnaire"], in_progress["response"], in_progress["valueSets"]):
+        print("In-progress requiredness probe was rejected", file=sys.stderr)
+        return 1
+
+    for case in manifest["cases"]:
+        resources = copy.deepcopy(bases[case["base"]])
+        apply_mutation(resources, case["mutation"])
+        findings = checker.validate_pair(
+            resources["questionnaire"], resources["response"], resources["valueSets"]
+        )
+        actual = sorted(finding.code for finding in findings)
+        expected = sorted(case["expectedCodes"])
+        if actual != expected:
+            print(
+                f"{case['id']}: expected {expected}, got {actual or 'no findings'}",
+                file=sys.stderr,
+            )
+            for finding in findings:
+                print(f"  {finding}", file=sys.stderr)
+            return 1
+        print(f"OK {case['id']}: {', '.join(actual)}")
+    print(f"OK: {len(manifest['cases'])} one-mutation paired-resource cases")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
