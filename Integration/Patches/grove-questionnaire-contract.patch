+@available(iOS 18, macOS 15, watchOS 11, *)
+extension GroveQuestionnaire.QuestionnaireResponses {
+    func validateForFHIRExport(status: QuestionnaireResponseStatus) throws {
+        guard status == .completed || status == .amended else {
+            return
+        }
+        let tasks = questionnaire.allTasks
+        let requiresExpressionEngine = !questionnaire.metadata.variables.isEmpty
+            || !questionnaire.metadata.constraints.isEmpty
+            || tasks.contains { task in
+                task.initialExpression != nil
+                    || task.calculatedExpression != nil
+                    || !task.variables.isEmpty
+                    || !task.constraints.isEmpty
+                    || { if case .expression = task.enabledCondition { true } else { false } }()
+            }
+        if requiresExpressionEngine && questionnaire.expressionEngine == nil {
+            throw FHIRResponseConversionError(
+                "A completed or amended response cannot be exported because the questionnaire has executable semantics but no expression engine"
+            )
+        }
+        func validate(
+            _ tasks: [GroveQuestionnaire.Questionnaire.Task],
+            in scopedResponses: GroveQuestionnaire.QuestionnaireResponses
+        ) throws {
+            for task in tasks {
+                let enabled = scopedResponses.shouldEnable(task: task)
+                if !enabled, scopedResponses.hasResponse(for: task) {
+                    throw FHIRResponseConversionError(
+                        "A completed or amended response contains an answer for disabled item '\(task.id)'"
+                    )
+                }
+                guard enabled else {
+                    continue
+                }
+                if !task.isOptional, !scopedResponses.hasResponse(for: task) {
+                    throw FHIRResponseConversionError(
+                        "A completed or amended response is missing enabled required item '\(task.id)'"
+                    )
+                }
+                if case .invalid(let message) = scopedResponses.validateResponse(for: task) {
+                    throw FHIRResponseConversionError(
+                        "Item '\(task.id)' prevents completion: \(String(localized: message))"
+                    )
+                }
+                guard case .choice(let config) = task.kind.variant else {
+                    continue
+                }
+                for optionId in scopedResponses.responses[task.id].value.choiceValue.selectedOptions {
+                    let nested = scopedResponses.nestedView(for: task.id, optionId: optionId)
+                    try validate(config.followUpTasks, in: nested)
+                }
+            }
+        }
+        try validate(questionnaire.sections.flatMap(\.tasks), in: self)
+        if let engine = questionnaire.expressionEngine {
+            for constraint in questionnaire.metadata.constraints where constraint.severity == .error {
+                do {
+                    let result = try engine.evaluateBoolean(constraint.expression, scope: .questionnaire, in: self)
+                    guard result == .true else {
+                        throw FHIRResponseConversionError(
+                            "Questionnaire targetConstraint '\(constraint.key ?? "?")' prevents completion: \(constraint.humanDescription)"
+                        )
+                    }
+                } catch let error as FHIRResponseConversionError {
+                    throw error
+                } catch {
+                    throw FHIRResponseConversionError(
+                        "Questionnaire targetConstraint '\(constraint.key ?? "?")' could not be evaluated: \(error)"
+                    )
+                }
+            }
+        }
+        guard expressionFailures.isEmpty else {
+            let first = expressionFailures[0]
+            throw FHIRResponseConversionError(
+                "A completed or amended response cannot be exported because expression '\(first.expression)' failed: \(first.reason)"
+            )
+        }
+    }
+}
