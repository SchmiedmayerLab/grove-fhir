+
+/// An error occurring while importing a FHIR QuestionnaireResponse.
+public struct FHIRResponseImportError: LocalizedError, Equatable, Sendable {
+    public let errorDescription: String?
+
+    init(_ message: String) {
+        errorDescription = message
+    }
+}
+
+
+@available(iOS 18, macOS 15, watchOS 11, *)
+extension GroveQuestionnaire.QuestionnaireResponses {
+    /// Imports a FHIR R4 response for an already resolved Questionnaire.
+    ///
+    /// The exact `url|version` canonical is checked before any answer is accepted.
+    /// Structural, choice-membership, required/enabled, and completion checks remain
+    /// part of the repository paired-resource gate; this importer additionally rejects
+    /// unknown, duplicate, or misplaced items so application code cannot bypass it.
+    public convenience init(
+        _ source: ModelsR4.QuestionnaireResponse,
+        questionnaire: GroveQuestionnaire.Questionnaire
+    ) throws {
+        let metadata = try Self.exchangeMetadata(from: source, questionnaire: questionnaire)
+        var decoder = FHIRQuestionnaireResponseDecoder(questionnaire: questionnaire)
+        let responses = try decoder.decode(source.item ?? [])
+        let responseId: UUID
+        if let value = source.identifier?.value?.value?.string,
+           let identifierId = UUID(uuidString: value) {
+            responseId = identifierId
+        } else if let value = source.id?.value?.string,
+                  let resourceId = UUID(uuidString: value) {
+            responseId = resourceId
+        } else {
+            responseId = UUID()
+        }
+        self.init(
+            id: responseId,
+            questionnaire: questionnaire,
+            responses: responses,
+            exchangeMetadata: metadata
+        )
+        try validateForFHIRExport(status: source.status.value ?? .inProgress)
+    }
+
+    private static func exchangeMetadata(
+        from source: ModelsR4.QuestionnaireResponse,
+        questionnaire: GroveQuestionnaire.Questionnaire
+    ) throws -> ExchangeMetadata {
+        guard let canonical = source.questionnaire?.value,
+              let canonicalVersion = canonical.version,
+              !canonicalVersion.isEmpty else {
+            throw FHIRResponseImportError("QuestionnaireResponse.questionnaire must be an exact url|version canonical")
+        }
+        let canonicalURL = canonical.url.absoluteString
+        guard canonicalURL == questionnaire.metadata.url?.absoluteString,
+              canonicalVersion == questionnaire.metadata.version else {
+            throw FHIRResponseImportError(
+                "QuestionnaireResponse.questionnaire '\(canonicalURL)|\(canonicalVersion)' does not match the resolved Questionnaire"
+            )
+        }
+        guard let identifier = source.identifier,
+              let identifierSystem = identifier.system?.value?.url.absoluteString,
+              let identifierValue = identifier.value?.value?.string,
+              !identifierSystem.isEmpty,
+              !identifierValue.isEmpty else {
+            throw FHIRResponseImportError("QuestionnaireResponse.identifier must contain both system and value")
+        }
+        let status: ExchangeMetadata.Status = switch source.status.value {
+        case .inProgress: .inProgress
+        case .completed: .completed
+        case .amended: .amended
+        case .enteredInError: .enteredInError
+        case .stopped: .stopped
+        case nil: throw FHIRResponseImportError("QuestionnaireResponse.status is missing")
+        }
+        guard case .codeableConcept(let completionMode)? = source.extensions(
+            for: QuestionnaireFHIRContract.completionMode
+        ).first?.value else {
+            throw FHIRResponseImportError("QuestionnaireResponse is missing its electronic completionMode")
+        }
+        let mode = ExchangeMetadata.CompletionMode(
+            coding: (completionMode.coding ?? []).map { .init(
+                system: $0.system?.value?.url.absoluteString,
+                version: $0.version?.value?.string,
+                code: $0.code?.value?.string,
+                display: $0.display?.value?.string,
+                userSelected: $0.userSelected?.value?.bool
+            ) },
+            text: completionMode.text?.value?.string
+        )
+        guard mode.coding.contains(where: {
+            $0.system == "http://terminology.hl7.org/CodeSystem/v3-ParticipationMode" && $0.code == "ELECTRONIC"
+        }) else {
+            throw FHIRResponseImportError("QuestionnaireResponse completionMode must be v3 ParticipationMode ELECTRONIC")
+        }
+        guard let authoredPrimitive = source.authored,
+              let authored = try authoredPrimitive.value?.asNSDate() as Date? else {
+            throw FHIRResponseImportError("QuestionnaireResponse.authored is required")
+        }
+        return ExchangeMetadata(
+            questionnaireURL: canonicalURL,
+            questionnaireVersion: canonicalVersion,
+            identifier: .init(system: identifierSystem, value: identifierValue),
+            status: status,
+            authored: authored,
+            subject: source.subject.map(ExchangeMetadata.Reference.init),
+            author: source.author.map(ExchangeMetadata.Reference.init),
+            source: source.source.map(ExchangeMetadata.Reference.init),
+            completionMode: mode
+        )
+    }
+}
