index 0000000000000000000000000000000000000000..d7198641764e3b802ea53233839e5d60690ef209
--- /dev/null
+++ b/Scripts/validate-questionnaire-conformance.sh
@@ -0,0 +1,91 @@
+#!/usr/bin/env bash
+#
+# This source file belongs to the Grove open-source project
+#
+# SPDX-FileCopyrightText: 2026 Stanford University and the project authors (see CONTRIBUTORS.md)
+#
+# SPDX-License-Identifier: MIT
+#
+
+# Emits Grove's deterministic Questionnaire resources, verifies their paired semantics,
+# and validates every checked-in conformance resource against one exact IG package.
+#
+# Required inputs:
+#   GROVE_IG_QUESTIONNAIRE  path to org.grovealliance.fhir.questionnaire#0.1.0 package.tgz
+#   FHIR_VALIDATOR          path to the HL7 R4 validator_cli.jar
+#
+# Optional:
+#   GROVE_CONFORMANCE_EXPORT  output directory for freshly emitted resources
+#   FHIR_TERMINOLOGY_SERVER   terminology endpoint; defaults to n/a for reproducible offline validation
+
+set -euo pipefail
+
+ROOT="$(cd "$(dirname "$0")/.." && pwd)"
+OUT="${GROVE_CONFORMANCE_EXPORT:-$ROOT/.build/questionnaire-conformance}"
+EXPECTED="$ROOT/Tests/GroveQuestionnaireTests/Fixtures/GroveQuestionnaireConformance/valid"
+PAIRED="$ROOT/Tests/GroveQuestionnaireTests/Fixtures/GroveQuestionnaireConformance/paired"
+QUESTIONNAIRE_PACKAGE="${GROVE_IG_QUESTIONNAIRE:-}"
+VALIDATOR="${FHIR_VALIDATOR:-}"
+TERMINOLOGY_SERVER="${FHIR_TERMINOLOGY_SERVER:-n/a}"
+
+if [ ! -f "$QUESTIONNAIRE_PACKAGE" ]; then
+    echo "error: GROVE_IG_QUESTIONNAIRE must name the exact questionnaire package.tgz" >&2
+    exit 2
+fi
+if [ ! -f "$VALIDATOR" ]; then
+    echo "error: FHIR_VALIDATOR must name validator_cli.jar" >&2
+    exit 2
+fi
+
+package_identity="$({ tar -xOf "$QUESTIONNAIRE_PACKAGE" package/package.json 2>/dev/null || true; } | python3 -c '
+import json, sys
+try:
+    package = json.load(sys.stdin)
+except json.JSONDecodeError:
+    raise SystemExit(2)
+print("{}#{}".format(package.get("name", ""), package.get("version", "")))
+')"
+if [ "$package_identity" != "org.grovealliance.fhir.questionnaire#0.1.0" ]; then
+    echo "error: expected org.grovealliance.fhir.questionnaire#0.1.0, got $package_identity" >&2
+    exit 2
+fi
+
+mkdir -p "$OUT"
+rm -f "$OUT/questionnaire.json" "$OUT/questionnaire-response.json" "$OUT/validation.txt"
+
+echo "==> running the unchanged GroveQuestionnaire package suite and emitting resources"
+GROVE_CONFORMANCE_EXPORT="$OUT" "$ROOT/Scripts/run-package-tests.sh" GroveQuestionnaire macOS
+
+for name in questionnaire.json questionnaire-response.json; do
+    if [ ! -f "$OUT/$name" ]; then
+        echo "error: fixture test did not emit $OUT/$name" >&2
+        exit 1
+    fi
+    if ! cmp -s "$EXPECTED/$name" "$OUT/$name"; then
+        echo "error: emitted $name differs from the checked-in deterministic fixture" >&2
+        exit 1
+    fi
+done
+
+echo "==> checking Questionnaire/QuestionnaireResponse semantics"
+python3 "$ROOT/Scripts/validate-questionnaire-pair.py" \
+    "$OUT/questionnaire.json" "$OUT/questionnaire-response.json" \
+    --package "$QUESTIONNAIRE_PACKAGE"
+python3 "$ROOT/Scripts/test-questionnaire-pair.py" --package "$QUESTIONNAIRE_PACKAGE"
+
+echo "==> validating static resources against $package_identity"
+java -jar "$VALIDATOR" -version 4.0.1 -tx "$TERMINOLOGY_SERVER" -ig "$QUESTIONNAIRE_PACKAGE" \
+    "$OUT/questionnaire.json" \
+    "$OUT/questionnaire-response.json" \
+    "$PAIRED/external-questionnaire.json" \
+    "$PAIRED/external-questionnaire-response.json" \
+    "$PAIRED/external-valueset.json" \
+    "$PAIRED/external-valueset-3.json" \
+    2>&1 | tee "$OUT/validation.txt"
+
+if grep -q '\*FAILURE\*' "$OUT/validation.txt" || grep -Eq '^[[:space:]]*Error @' "$OUT/validation.txt"; then
+    echo "FAILED: at least one resource violates the exact Questionnaire package" >&2
+    exit 1
+fi
+
+echo "OK: emitted bytes, paired semantics, mutation cases, and R4 profile validation passed."
