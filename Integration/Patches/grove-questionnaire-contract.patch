index 0000000000000000000000000000000000000000..cc50117392c4b909711c46146a8bb1907c064ec4
--- /dev/null
+++ b/Scripts/validate-questionnaire-pair.py
@@ -0,0 +1,393 @@
+#!/usr/bin/env python3
+"""Validate Questionnaire/QuestionnaireResponse semantics the R4 validator cannot pair.
+
+The HL7 validator checks each resource in isolation. This checker deliberately owns the
+cross-resource rules: exact canonical/version, response hierarchy and item identity,
+answer datatypes and choices, response text, cardinalities, and status-aware
+enablement/requiredness. Findings use stable rule codes so CI and mutation fixtures can
+pin the reason a pair was rejected.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import re
+import sys
+import tarfile
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Any, Iterable
+
+
+QUESTIONNAIRE_PROFILE = (
+    "https://schmiedmayerlab.github.io/grove-fhir/fhir/questionnaire/"
+    "StructureDefinition/grove-questionnaire"
+)
+RESPONSE_PROFILE = (
+    "https://schmiedmayerlab.github.io/grove-fhir/fhir/questionnaire/"
+    "StructureDefinition/grove-questionnaire-response"
+)
+VERSION_ALGORITHM = "http://hl7.org/fhir/StructureDefinition/artifact-versionAlgorithm"
+COMPLETION_MODE = "http://hl7.org/fhir/StructureDefinition/questionnaireresponse-completionMode"
+ENABLE_EXPRESSION = (
+    "http://hl7.org/fhir/uv/sdc/StructureDefinition/"
+    "sdc-questionnaire-enableWhenExpression"
+)
+MIN_OCCURS = "http://hl7.org/fhir/StructureDefinition/questionnaire-minOccurs"
+MAX_OCCURS = "http://hl7.org/fhir/StructureDefinition/questionnaire-maxOccurs"
+SEMVER = re.compile(
+    r"^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)"
+    r"(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)"
+    r"(?:\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?"
+    r"(?:\+[0-9A-Za-z-]+(?:\.[0-9A-Za-z-]+)*)?$"
+)
+
+
+@dataclass(frozen=True)
+class Finding:
+    code: str
+    path: str
+    message: str
+
+    def __str__(self) -> str:
+        return f"[{self.code}] {self.path}: {self.message}"
+
+
+def extensions(resource: dict[str, Any], url: str) -> list[dict[str, Any]]:
+    return [entry for entry in resource.get("extension", []) if entry.get("url") == url]
+
+
+def extension_integer(resource: dict[str, Any], url: str) -> int | None:
+    matches = extensions(resource, url)
+    return matches[0].get("valueInteger") if matches else None
+
+
+def value_key(value: dict[str, Any]) -> tuple[str, str] | None:
+    keys = sorted(key for key in value if key.startswith("value") and key != "valueSet")
+    if len(keys) != 1:
+        return None
+    key = keys[0]
+    comparable = value[key]
+    if key == "valueCoding":
+        # Display/userSelected are presentation and provenance, not code identity.
+        comparable = {
+            field: comparable[field]
+            for field in ("system", "version", "code")
+            if field in comparable
+        }
+    return key, json.dumps(comparable, sort_keys=True, separators=(",", ":"))
+
+
+def split_canonical(value: str) -> tuple[str, str | None]:
+    url, separator, version = value.rpartition("|")
+    return (url, version) if separator else (value, None)
+
+
+def load_value_sets(paths: Iterable[Path], packages: Iterable[Path]) -> list[dict[str, Any]]:
+    resources: list[dict[str, Any]] = []
+    for path in paths:
+        resource = json.loads(path.read_text())
+        if resource.get("resourceType") != "ValueSet":
+            raise ValueError(f"{path} is not a ValueSet")
+        resources.append(resource)
+    for package in packages:
+        with tarfile.open(package, "r:gz") as archive:
+            for member in archive.getmembers():
+                if not member.isfile() or not member.name.endswith(".json"):
+                    continue
+                extracted = archive.extractfile(member)
+                if extracted is None:
+                    continue
+                try:
+                    resource = json.load(extracted)
+                except (UnicodeDecodeError, json.JSONDecodeError):
+                    continue
+                if resource.get("resourceType") == "ValueSet":
+                    resources.append(resource)
+    return resources
+
+
+def value_set_codes(value_set: dict[str, Any]) -> set[tuple[str | None, str | None]]:
+    result: set[tuple[str | None, str | None]] = set()
+    for contains in value_set.get("expansion", {}).get("contains", []):
+        result.add((contains.get("system"), contains.get("code")))
+    for include in value_set.get("compose", {}).get("include", []):
+        system = include.get("system")
+        for concept in include.get("concept", []):
+            result.add((system, concept.get("code")))
+    return result
+
+
+def validate_pair(
+    questionnaire: dict[str, Any],
+    response: dict[str, Any],
+    value_sets: Iterable[dict[str, Any]] = (),
+) -> list[Finding]:
+    findings: list[Finding] = []
+
+    def add(code: str, path: str, message: str) -> None:
+        findings.append(Finding(code, path, message))
+
+    if questionnaire.get("resourceType") != "Questionnaire":
+        add("PAIR-RESOURCE-001", "Questionnaire", "expected resourceType Questionnaire")
+        return findings
+    if response.get("resourceType") != "QuestionnaireResponse":
+        add("PAIR-RESOURCE-002", "QuestionnaireResponse", "expected resourceType QuestionnaireResponse")
+        return findings
+
+    q_profiles = questionnaire.get("meta", {}).get("profile", [])
+    r_profiles = response.get("meta", {}).get("profile", [])
+    if QUESTIONNAIRE_PROFILE not in q_profiles:
+        add("PAIR-PROFILE-001", "Questionnaire.meta.profile", "current Grove Questionnaire profile is missing")
+    if RESPONSE_PROFILE not in r_profiles:
+        add("PAIR-PROFILE-002", "QuestionnaireResponse.meta.profile", "current Grove response profile is missing")
+
+    q_url, q_version = questionnaire.get("url"), questionnaire.get("version")
+    if not q_url or not q_version or not SEMVER.fullmatch(q_version):
+        add("PAIR-CANONICAL-001", "Questionnaire.url|version", "canonical URL and valid Semantic Version are required")
+    expected_canonical = f"{q_url}|{q_version}" if q_url and q_version else None
+    if response.get("questionnaire") != expected_canonical:
+        add("PAIR-CANONICAL-002", "QuestionnaireResponse.questionnaire", "must exactly match Questionnaire url|version")
+    algorithm = extensions(questionnaire, VERSION_ALGORITHM)
+    if not algorithm or algorithm[0].get("valueCoding") != {
+        "system": "http://hl7.org/fhir/version-algorithm",
+        "code": "semver",
+    }:
+        add("PAIR-CANONICAL-003", "Questionnaire.versionAlgorithm[x]", "must declare the semver algorithm coding")
+
+    identifier = response.get("identifier", {})
+    if not identifier.get("system") or not identifier.get("value"):
+        add("PAIR-METADATA-001", "QuestionnaireResponse.identifier", "system and value are required")
+    if not response.get("authored"):
+        add("PAIR-METADATA-002", "QuestionnaireResponse.authored", "authored is required")
+    mode = extensions(response, COMPLETION_MODE)
+    codings = mode[0].get("valueCodeableConcept", {}).get("coding", []) if mode else []
+    if not any(
+        coding.get("system") == "http://terminology.hl7.org/CodeSystem/v3-ParticipationMode"
+        and coding.get("code") == "ELECTRONIC"
+        for coding in codings
+    ):
+        add("PAIR-METADATA-003", "QuestionnaireResponse.completionMode", "electronic completion mode is required")
+
+    @dataclass
+    class QNode:
+        item: dict[str, Any]
+        parent: str
+        path: str
+
+    q_nodes: dict[str, QNode] = {}
+
+    def index_questionnaire(items: list[dict[str, Any]], parent: str, path: str) -> None:
+        for index, item in enumerate(items):
+            item_path = f"{path}.item[{index}]"
+            link_id = item.get("linkId")
+            if not link_id:
+                add("PAIR-HIERARCHY-001", f"{item_path}.linkId", "linkId is required")
+                continue
+            if link_id in q_nodes:
+                add("PAIR-DUPLICATE-001", f"{item_path}.linkId", f"duplicate Questionnaire linkId '{link_id}'")
+                continue
+            q_nodes[link_id] = QNode(item, parent, item_path)
+            child_parent = f"item:{link_id}" if item.get("type") == "group" else f"answer:{link_id}"
+            index_questionnaire(item.get("item", []), child_parent, item_path)
+
+    index_questionnaire(questionnaire.get("item", []), "root", "Questionnaire")
+
+    @dataclass
+    class ResponseOccurrence:
+        item: dict[str, Any]
+        path: str
+        parent_path: str
+
+    answers_by_id: dict[str, list[dict[str, Any]]] = {}
+    response_items_by_id: dict[str, list[ResponseOccurrence]] = {}
+
+    def index_response(items: list[dict[str, Any]], parent: str, path: str) -> None:
+        seen_siblings: set[str] = set()
+        for index, item in enumerate(items):
+            item_path = f"{path}.item[{index}]"
+            link_id = item.get("linkId")
+            node = q_nodes.get(link_id)
+            if node is None:
+                add("PAIR-UNKNOWN-001", f"{item_path}.linkId", f"unknown response item '{link_id}'")
+                continue
+            if link_id in seen_siblings:
+                add("PAIR-DUPLICATE-002", f"{item_path}.linkId", f"duplicate response item '{link_id}'")
+            seen_siblings.add(link_id)
+            response_items_by_id.setdefault(link_id, []).append(ResponseOccurrence(item, item_path, path))
+            if node.parent != parent:
+                add("PAIR-MISPLACED-001", item_path, f"'{link_id}' belongs under {node.parent}, not {parent}")
+            if node.item.get("text") and item.get("text") != node.item.get("text"):
+                add("PAIR-TEXT-001", f"{item_path}.text", "must exactly match Questionnaire.item.text")
+            answers = item.get("answer", [])
+            answers_by_id.setdefault(link_id, []).extend(answers)
+            index_response(item.get("item", []), f"item:{link_id}", item_path)
+            for answer_index, answer in enumerate(answers):
+                index_response(answer.get("item", []), f"answer:{link_id}", f"{item_path}.answer[{answer_index}]")
+
+    index_response(response.get("item", []), "root", "QuestionnaireResponse")
+
+    resolved_sets: dict[tuple[str, str | None], list[dict[str, Any]]] = {}
+    for value_set in list(value_sets) + [
+        resource for resource in questionnaire.get("contained", []) if resource.get("resourceType") == "ValueSet"
+    ]:
+        resolved_sets.setdefault((value_set.get("url"), value_set.get("version")), []).append(value_set)
+        if value_set.get("id"):
+            resolved_sets.setdefault((f"#{value_set['id']}", None), []).append(value_set)
+
+    expected_types = {
+        "boolean": {"valueBoolean"}, "decimal": {"valueDecimal"}, "integer": {"valueInteger"},
+        "date": {"valueDate"}, "dateTime": {"valueDateTime"}, "time": {"valueTime"},
+        "string": {"valueString"}, "text": {"valueString"}, "url": {"valueUri"},
+        "attachment": {"valueAttachment"}, "quantity": {"valueQuantity"},
+        "reference": {"valueReference"},
+    }
+
+    def is_enabled(item: dict[str, Any]) -> bool | None:
+        if extensions(item, ENABLE_EXPRESSION):
+            return None
+        conditions = item.get("enableWhen", [])
+        if not conditions:
+            return True
+        results: list[bool] = []
+        for condition in conditions:
+            source = answers_by_id.get(condition.get("question"), [])
+            operator = condition.get("operator")
+            target_entry = {key: value for key, value in condition.items() if key.startswith("answer")}
+            if operator == "exists":
+                results.append(bool(source) == bool(target_entry.get("answerBoolean")))
+                continue
+            if not source:
+                results.append(False)
+                continue
+            target_key = next(iter(target_entry), None)
+            target = target_entry.get(target_key) if target_key else None
+            source_values = [next((value for key, value in answer.items() if key.startswith("value")), None) for answer in source]
+            try:
+                if operator == "=": results.append(any(value == target for value in source_values))
+                elif operator == "!=": results.append(any(value != target for value in source_values))
+                elif operator == ">": results.append(any(value > target for value in source_values))
+                elif operator == "<": results.append(any(value < target for value in source_values))
+                elif operator == ">=": results.append(any(value >= target for value in source_values))
+                elif operator == "<=": results.append(any(value <= target for value in source_values))
+                else: results.append(False)
+            except TypeError:
+                results.append(False)
+        return all(results) if item.get("enableBehavior", "all") == "all" else any(results)
+
+    terminal_status = response.get("status") in {"completed", "amended"}
+
+    def expected_parent_paths(parent: str) -> list[str]:
+        if parent == "root":
+            return ["QuestionnaireResponse"]
+        parent_kind, parent_link_id = parent.split(":", 1)
+        parent_occurrences = response_items_by_id.get(parent_link_id, [])
+        if parent_kind == "item":
+            return [occurrence.path for occurrence in parent_occurrences]
+        return [
+            f"{occurrence.path}.answer[{index}]"
+            for occurrence in parent_occurrences
+            for index, _ in enumerate(occurrence.item.get("answer", []))
+        ]
+
+    for link_id, node in q_nodes.items():
+        item, item_path = node.item, node.path
+        occurrences = response_items_by_id.get(link_id, [])
+        answer_groups = [
+            (occurrence.path, occurrence.item.get("answer", []))
+            for occurrence in occurrences
+        ]
+        enabled = is_enabled(item)
+        if enabled is None:
+            add("PAIR-ENABLED-002", item_path, "enableWhenExpression needs the runtime semantic gate")
+        elif not enabled and occurrences:
+            add("PAIR-DISABLED-001", item_path, "disabled item must not appear in the response")
+        if terminal_status and enabled is True and item.get("required"):
+            occurrences_by_parent = {
+                occurrence.parent_path: occurrence
+                for occurrence in occurrences
+                if occurrence.parent_path in expected_parent_paths(node.parent)
+            }
+            for parent_path in expected_parent_paths(node.parent):
+                occurrence = occurrences_by_parent.get(parent_path)
+                if occurrence is None or not occurrence.item.get("answer", []):
+                    add(
+                        "PAIR-REQUIRED-001",
+                        f"{parent_path}.item[{link_id}]",
+                        "enabled required item is unanswered in a terminal response",
+                    )
+        all_answers = [answer for _, answers in answer_groups for answer in answers]
+        if item.get("type") in {"group", "display"} and all_answers:
+            add("PAIR-DATATYPE-001", item_path, f"{item.get('type')} items must not carry answers")
+            continue
+        allowed_types = expected_types.get(item.get("type"))
+        if item.get("type") in {"choice", "open-choice"}:
+            allowed_types = {"valueCoding", "valueString", "valueInteger", "valueDate", "valueTime"}
+        minimum, maximum = extension_integer(item, MIN_OCCURS), extension_integer(item, MAX_OCCURS)
+        cardinality_groups = answer_groups or ([(item_path, [])] if enabled is True else [])
+        for occurrence_path, answers in cardinality_groups:
+            for answer_index, answer in enumerate(answers):
+                answer_path = f"{occurrence_path}.answer[{answer_index}]"
+                value = value_key(answer)
+                if value is None or allowed_types is None or value[0] not in allowed_types:
+                    add("PAIR-DATATYPE-002", answer_path, f"answer datatype does not match Questionnaire type '{item.get('type')}'")
+            if not item.get("repeats") and len(answers) > 1:
+                add("PAIR-REPEATS-001", occurrence_path, "non-repeating item has multiple answers")
+            if minimum is not None and len(answers) < minimum:
+                add("PAIR-LIMITS-001", occurrence_path, f"answer count is below questionnaire-minOccurs {minimum}")
+            if maximum is not None and len(answers) > maximum:
+                add("PAIR-LIMITS-002", occurrence_path, f"answer count exceeds questionnaire-maxOccurs {maximum}")
+
+        if item.get("type") not in {"choice", "open-choice"} or not all_answers:
+            continue
+        allowed = {value_key(option) for option in item.get("answerOption", [])}
+        allowed.discard(None)
+        binding = item.get("answerValueSet")
+        unresolved_binding = False
+        if binding:
+            binding_url, binding_version = split_canonical(binding)
+            candidates = resolved_sets.get((binding_url, binding_version), [])
+            if binding_version is None:
+                candidates = [
+                    resource for (url, _), resources in resolved_sets.items() if url == binding_url for resource in resources
+                ]
+            unique = {json.dumps(candidate, sort_keys=True) for candidate in candidates}
+            if len(unique) != 1:
+                add("PAIR-CHOICE-002", item_path, f"ValueSet '{binding}' did not resolve to exactly one version")
+                unresolved_binding = True
+            elif candidates:
+                allowed |= {("valueCoding", json.dumps({"system": system, "code": code}, sort_keys=True, separators=(",", ":")))
+                            for system, code in value_set_codes(candidates[0])}
+        if unresolved_binding:
+            continue
+        for answer_index, answer in enumerate(all_answers):
+            if item.get("type") == "open-choice" and "valueString" in answer:
+                continue
+            if value_key(answer) not in allowed:
+                add("PAIR-CHOICE-001", f"{item_path}.answer[{answer_index}]", "answer is not in the inline or resolved ValueSet choices")
+
+    return sorted(findings, key=lambda value: (value.code, value.path, value.message))
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("questionnaire", type=Path)
+    parser.add_argument("response", type=Path)
+    parser.add_argument("--valueset", action="append", default=[], type=Path)
+    parser.add_argument("--package", action="append", default=[], type=Path)
+    args = parser.parse_args()
+    questionnaire = json.loads(args.questionnaire.read_text())
+    response = json.loads(args.response.read_text())
+    findings = validate_pair(questionnaire, response, load_value_sets(args.valueset, args.package))
+    for finding in findings:
+        print(finding)
+    if findings:
+        print(f"FAILED: {len(findings)} paired-resource finding(s)", file=sys.stderr)
+        return 1
+    print("OK: Questionnaire and QuestionnaireResponse satisfy paired semantics")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
