+@available(iOS 18, macOS 15, watchOS 11, *)
+private struct FHIRQuestionnaireResponseDecoder {
+    private enum Parent: Equatable {
+        case root
+        case item(String)
+        case answer(String)
+    }
+
+    private struct Expected {
+        let task: GroveQuestionnaire.Questionnaire.Task?
+        let parent: Parent
+        let text: String?
+        /// Native choice follow-ups live in `Response.nestedResponses`; items imported
+        /// from arbitrary FHIR question nesting continue to use the root response map.
+        let isNativeChoiceFollowUp: Bool
+    }
+
+    private let expected: [String: Expected]
+    private var responses = GroveQuestionnaire.QuestionnaireResponses.Responses()
+
+    init(questionnaire: GroveQuestionnaire.Questionnaire) {
+        var expected: [String: Expected] = [:]
+        func register(
+            _ tasks: [GroveQuestionnaire.Questionnaire.Task],
+            defaultParent: Parent,
+            nativeChoiceFollowUp: Bool
+        ) {
+            for task in tasks {
+                var parent = defaultParent
+                for group in task.groupPath {
+                    if expected[group.id] == nil {
+                        expected[group.id] = Expected(
+                            task: nil,
+                            parent: parent,
+                            text: group.title.isEmpty ? nil : group.title,
+                            isNativeChoiceFollowUp: nativeChoiceFollowUp
+                        )
+                    }
+                    parent = .item(group.id)
+                }
+                if let parentTaskId = task.parentTaskId {
+                    parent = .answer(parentTaskId)
+                }
+                expected[task.id] = Expected(
+                    task: task,
+                    parent: parent,
+                    text: task.title.isEmpty ? nil : task.title,
+                    isNativeChoiceFollowUp: nativeChoiceFollowUp
+                )
+                register(
+                    task.kind.followUpTasks,
+                    defaultParent: .answer(task.id),
+                    nativeChoiceFollowUp: true
+                )
+            }
+        }
+        for section in questionnaire.sections {
+            let sectionParent: Parent = section.fhirGroupId.map(Parent.item) ?? .root
+            if let groupId = section.fhirGroupId {
+                expected[groupId] = Expected(
+                    task: nil,
+                    parent: .root,
+                    text: section.title.isEmpty ? nil : section.title,
+                    isNativeChoiceFollowUp: false
+                )
+            }
+            register(section.tasks, defaultParent: sectionParent, nativeChoiceFollowUp: false)
+        }
+        self.expected = expected
+    }
+
+    mutating func decode(_ items: [QuestionnaireResponseItem]) throws -> GroveQuestionnaire.QuestionnaireResponses.Responses {
+        _ = try decode(items, parent: .root)
+        return responses
+    }
+
+    /// Decodes one response-item context. The returned container contains native
+    /// choice follow-ups only; ordinary tasks are written to the root response map.
+    /// Keeping duplicate tracking local to this array allows the same follow-up linkId
+    /// once beneath each answer of a repeating choice, as R4 requires.
+    private mutating func decode(
+        _ items: [QuestionnaireResponseItem],
+        parent: Parent
+    ) throws -> GroveQuestionnaire.QuestionnaireResponses.Responses {
+        var nestedResponses = GroveQuestionnaire.QuestionnaireResponses.Responses()
+        var seenSiblings: Set<String> = []
+        for item in items {
+            guard let linkId = item.linkId.value?.string, let node = expected[linkId] else {
+                throw FHIRResponseImportError(
+                    "QuestionnaireResponse contains unknown item '\(item.linkId.value?.string ?? "?")'"
+                )
+            }
+            guard seenSiblings.insert(linkId).inserted else {
+                throw FHIRResponseImportError("QuestionnaireResponse contains duplicate item '\(linkId)'")
+            }
+            guard node.parent == parent else {
+                throw FHIRResponseImportError("QuestionnaireResponse item '\(linkId)' is structurally misplaced")
+            }
+            if let expectedText = node.text, item.text?.value?.string != expectedText {
+                throw FHIRResponseImportError("QuestionnaireResponse item '\(linkId)' text does not match the Questionnaire")
+            }
+            if let task = node.task {
+                var decoded = try response(from: item, for: task)
+                let itemChildren = try decode(item.item ?? [], parent: .item(linkId))
+                guard itemChildren.isEmpty else {
+                    throw FHIRResponseImportError(
+                        "Native follow-up items on '\(linkId)' must be nested beneath a selected answer"
+                    )
+                }
+                for answer in item.answer ?? [] {
+                    let answerChildren = try decode(answer.item ?? [], parent: .answer(linkId))
+                    guard !answerChildren.isEmpty else {
+                        continue
+                    }
+                    guard case .choice(let config) = task.kind.variant,
+                          let optionId = try selectedOptionId(for: answer, config: config) else {
+                        throw FHIRResponseImportError(
+                            "Nested response items on '\(linkId)' require a recognized choice answer"
+                        )
+                    }
+                    guard var response = decoded else {
+                        throw FHIRResponseImportError("Nested response items on unanswered item '\(linkId)'")
+                    }
+                    let key = GroveQuestionnaire.QuestionnaireResponses.Response.NestedResponseIdentifier.choiceOption(optionId)
+                    guard response.nestedResponses[key] == nil else {
+                        throw FHIRResponseImportError(
+                            "QuestionnaireResponse contains duplicate nested response context for '\(linkId)' option '\(optionId)'"
+                        )
+                    }
+                    response.nestedResponses[key] = answerChildren
+                    decoded = response
+                }
+                if let decoded {
+                    if node.isNativeChoiceFollowUp {
+                        nestedResponses[task.id] = decoded
+                    } else {
+                        responses[task.id] = decoded
+                    }
+                }
+            } else if !(item.answer?.isEmpty ?? true) {
+                throw FHIRResponseImportError("Structural group '\(linkId)' must not carry answers")
+            } else {
+                let children = try decode(item.item ?? [], parent: .item(linkId))
+                for (taskId, response) in children {
+                    nestedResponses[taskId] = response
+                }
+            }
+        }
+        return nestedResponses
+    }
+
+    private func response(
+        from item: QuestionnaireResponseItem,
+        for task: GroveQuestionnaire.Questionnaire.Task
+    ) throws -> GroveQuestionnaire.QuestionnaireResponses.Response? {
+        let answers = item.answer ?? []
+        guard !answers.isEmpty else {
+            return nil
+        }
+        let value: GroveQuestionnaire.QuestionnaireResponses.Response.Value
+        switch task.kind.variant {
+        case .instructional:
+            throw FHIRResponseImportError("Display item '\(task.id)' must not carry an answer")
+        case .boolean:
+            guard answers.count == 1, case .boolean(let primitive)? = answers[0].value,
+                  let bool = primitive.value?.bool else {
+                throw FHIRResponseImportError("Item '\(task.id)' requires one boolean answer")
+            }
+            value = .bool(bool)
+        case .freeText(let config):
+            guard answers.count == 1 else {
+                throw FHIRResponseImportError("Item '\(task.id)' does not repeat")
+            }
+            switch answers[0].value {
+            case .string(let primitive):
+                value = .string(primitive.value?.string ?? "")
+            case .uri(let primitive) where config.expectsURL:
+                value = .string(primitive.value?.url.absoluteString ?? "")
+            default:
+                throw FHIRResponseImportError("Item '\(task.id)' has the wrong text answer datatype")
+            }
+        case .numeric(let config):
+            guard answers.count == 1 else {
+                throw FHIRResponseImportError("Item '\(task.id)' does not repeat")
+            }
+            switch (config.valueKind, answers[0].value) {
+            case (.integer, .integer(let primitive)):
+                value = .number(Double(primitive.value?.integer ?? 0))
+            case (.decimal, .decimal(let primitive)):
+                value = .number(primitive.value.map { NSDecimalNumber(decimal: $0.decimal).doubleValue } ?? 0)
+            case (.quantity, .quantity(let quantity)):
+                guard let number = quantity.value?.value?.decimal,
+                      let code = quantity.code?.value?.string ?? quantity.unit?.value?.string else {
+                    throw FHIRResponseImportError("Quantity answer on '\(task.id)' must contain value and unit code")
+                }
+                value = .quantity(NSDecimalNumber(decimal: number).doubleValue, unitCode: code)
+            default:
+                throw FHIRResponseImportError("Item '\(task.id)' has the wrong numeric answer datatype")
+            }
+        case .dateTime(let config):
+            guard answers.count == 1 else {
+                throw FHIRResponseImportError("Item '\(task.id)' does not repeat")
+            }
+            value = .date(try dateComponents(from: answers[0].value, style: config.style, taskId: task.id))
+        case .choice(let config):
+            var selected: Set<String> = []
+            var other: String?
+            for answer in answers {
+                if let optionId = try selectedOptionId(for: answer, config: config) {
+                    guard selected.insert(optionId).inserted else {
+                        throw FHIRResponseImportError("Item '\(task.id)' contains the same choice answer more than once")
+                    }
+                } else if case .string(let primitive)? = answer.value,
+                          config.hasFreeTextOtherOption,
+                          let value = primitive.value?.string {
+                    guard other == nil else {
+                        throw FHIRResponseImportError("Item '\(task.id)' contains more than one free-text other answer")
+                    }
+                    other = value
+                } else {
+                    throw FHIRResponseImportError("Item '\(task.id)' has an unsupported or unrecognized choice answer")
+                }
+            }
+            if !config.allowsMultipleSelection, selected.count + (other == nil ? 0 : 1) > 1 {
+                throw FHIRResponseImportError("Item '\(task.id)' does not allow repeated answers")
+            }
+            if let maximum = config.maxSelections, selected.count + (other == nil ? 0 : 1) > maximum {
+                throw FHIRResponseImportError("Item '\(task.id)' exceeds its maximum number of selections")
+            }
+            value = .choice(.init(selectedOptions: selected, freeTextOtherResponse: other))
+        case .fileAttachment:
+            throw FHIRResponseImportError(
+                "Attachment import for item '\(task.id)' requires an application-managed binary store and is not available in the in-memory importer"
+            )
+        case .custom:
+            throw FHIRResponseImportError("Custom item '\(task.id)' has no registered FHIR response importer")
+        }
+        return .init(value: value)
+    }
+
+    private func selectedOptionId(
+        for answer: QuestionnaireResponseItemAnswer,
+        config: GroveQuestionnaire.Questionnaire.Task.Kind.ChoiceConfig
+    ) throws -> String? {
+        let match: GroveQuestionnaire.Questionnaire.Task.Kind.ChoiceConfig.Option?
+        switch answer.value {
+        case .coding(let coding):
+            guard let code = coding.code?.value?.string else {
+                throw FHIRResponseImportError("Coded choice answer is missing its code")
+            }
+            let system = coding.system?.value?.url
+            match = config.options.first { option in
+                if let optionCoding = option.fhirCoding {
+                    return optionCoding.system == system && optionCoding.code == code
+                }
+                return system == nil && option.id == code
+            }
+        case .string(let primitive):
+            guard let value = primitive.value?.string else {
+                throw FHIRResponseImportError("String choice answer is missing its value")
+            }
+            match = config.options.first { $0.answerValue == .string(value) }
+        case .integer(let primitive):
+            guard let value = primitive.value?.integer else {
+                throw FHIRResponseImportError("Integer choice answer is missing its value")
+            }
+            match = config.options.first { $0.answerValue == .integer(Int(value)) }
+        case .date(let primitive):
+            guard let value = primitive.value else {
+                throw FHIRResponseImportError("Date choice answer is missing its value")
+            }
+            let components = DateComponents(
+                year: value.year,
+                month: value.month.map(Int.init),
+                day: value.day.map(Int.init)
+            )
+            match = config.options.first { $0.answerValue == .date(components) }
+        case .time(let primitive):
+            guard let value = primitive.value else {
+                throw FHIRResponseImportError("Time choice answer is missing its value")
+            }
+            let components = DateComponents(
+                hour: Int(value.hour),
+                minute: Int(value.minute),
+                second: Int(value.second.doubleValue)
+            )
+            match = config.options.first { $0.answerValue == .time(components) }
+        default:
+            return nil
+        }
+        return match?.id
+    }
+
+    private func dateComponents(
+        from value: QuestionnaireResponseItemAnswer.ValueX?,
+        style: GroveQuestionnaire.Questionnaire.Task.Kind.DateTimeConfig.Style,
+        taskId: String
+    ) throws -> DateComponents {
+        switch (style, value) {
+        case (.dateOnly, .date(let primitive)):
+            return DateComponents(
+                year: primitive.value?.year,
+                month: primitive.value?.month.map(Int.init),
+                day: primitive.value?.day.map(Int.init)
+            )
+        case (.timeOnly, .time(let primitive)):
+            return DateComponents(
+                hour: primitive.value.map { Int($0.hour) },
+                minute: primitive.value.map { Int($0.minute) },
+                second: primitive.value.map { Int($0.second.doubleValue) }
+            )
+        case (.dateAndTime, .dateTime(let primitive)):
+            return DateComponents(
+                year: primitive.value?.date.year,
+                month: primitive.value?.date.month.map(Int.init),
+                day: primitive.value?.date.day.map(Int.init),
+                hour: primitive.value?.time.map { Int($0.hour) },
+                minute: primitive.value?.time.map { Int($0.minute) },
+                second: primitive.value?.time.map { Int($0.second.doubleValue) }
+            )
+        default:
+            throw FHIRResponseImportError("Item '\(taskId)' has the wrong date/time answer datatype")
+        }
+    }
+}
