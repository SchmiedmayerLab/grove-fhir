+/// Canonicals and extension URLs shared by Grove's Questionnaire import and export paths.
+///
+/// Keeping these values in one place prevents a client release from claiming a retired
+/// profile while another path emits the current contract.
+public enum QuestionnaireFHIRContract {
+    /// The Grove Questionnaire profile published by the Questionnaire implementation guide.
+    public static let questionnaireProfile =
+        "https://schmiedmayerlab.github.io/grove-fhir/fhir/questionnaire/StructureDefinition/grove-questionnaire"
+    /// The Grove QuestionnaireResponse profile published by the Questionnaire implementation guide.
+    public static let questionnaireResponseProfile =
+        "https://schmiedmayerlab.github.io/grove-fhir/fhir/questionnaire/StructureDefinition/grove-questionnaire-response"
+
+    static let versionAlgorithm = "http://hl7.org/fhir/StructureDefinition/artifact-versionAlgorithm"
+    static let versionAlgorithmSystem = "http://hl7.org/fhir/version-algorithm"
+    static let targetConstraint = "http://hl7.org/fhir/StructureDefinition/targetConstraint"
+    static let retiredConstraint = "http://hl7.org/fhir/StructureDefinition/questionnaire-constraint"
+    static let variable = "http://hl7.org/fhir/StructureDefinition/variable"
+    static let completionMode = "http://hl7.org/fhir/StructureDefinition/questionnaireresponse-completionMode"
+    static let hidden = "http://hl7.org/fhir/StructureDefinition/questionnaire-hidden"
+    static let styleSensitive = "http://hl7.org/fhir/StructureDefinition/rendering-styleSensitive"
+
+    /// Validates the SemVer 2.0.0 shape required by the published profile.
+    ///
+    /// Build metadata is accepted and leading zeroes in numeric identifiers are rejected.
+    static func isSemanticVersion(_ value: String) -> Bool {
+        value.range(
+            of: #"^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\+([0-9A-Za-z-]+(?:\.[0-9A-Za-z-]+)*))?$"#,
+            options: .regularExpression
+        ) != nil
+    }
+}
