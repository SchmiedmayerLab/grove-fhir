+  async retireIdentifierClaim(
+    identifierKey: string,
+    nowMs: number,
+    currentOwnerRecheckAtMs: number,
+  ): Promise<
+    "deleted" | "deferred-current" | "deferred-reservation" | "skipped"
+  > {
+    const claimReference = this.firestore
+      .collection(IDENTIFIER_COLLECTION)
+      .doc(identifierKey);
+    return this.firestore.runTransaction(async (transaction) => {
+      const claimSnapshot = await transaction.get(claimReference);
+      if (!claimSnapshot.exists) {
+        return "skipped" as const;
+      }
+      const claimData = claimSnapshot.data();
+      const claimSchemaVersion: unknown = claimData?.schemaVersion;
+      const claim = claimData as IdentifierClaimDocument;
+      if (
+        claimSchemaVersion !== FHIR_EXCHANGE_SCHEMA_VERSION ||
+        claim.retirementState !== "eligible" ||
+        !Number.isSafeInteger(claim.retireAfterMs) ||
+        claim.retireAfterMs > nowMs
+      ) {
+        return "skipped" as const;
+      }
+      if (
+        claim.identifierKey !== identifierKey ||
+        (claim.active !== null && !isActiveIdentifierClaim(claim.active)) ||
+        (claim.pending !== null && !isPendingIdentifierClaim(claim.pending))
+      ) {
+        const pendingPageId =
+          (
+            typeof claim.pending === "object" &&
+            claim.pending !== null &&
+            "pageId" in claim.pending &&
+            typeof claim.pending.pageId === "string"
+          ) ?
+            claim.pending.pageId
+          : undefined;
+        if (pendingPageId !== undefined) {
+          transaction.delete(
+            this.firestore.collection(CLAIM_PAGE_COLLECTION).doc(pendingPageId),
+          );
+        }
+        transaction.set(claimReference, {
+          ...claim,
+          retirementState: "quarantined",
+          retirementAttempts:
+            (
+              Number.isSafeInteger(claim.retirementAttempts) &&
+              claim.retirementAttempts >= 0
+            ) ?
+              claim.retirementAttempts + 1
+            : 1,
+          retirementLastErrorCode: "invalid-identifier-claim",
+          updatedAtMs: nowMs,
+        } satisfies IdentifierClaimDocument);
+        return "skipped" as const;
+      }
+      const slots = [claim.active, claim.pending].filter(
+        (slot): slot is ActiveIdentifierClaim => slot !== null,
+      );
+      const sourceKeys = Array.from(
+        new Set(slots.map((slot) => slot.sourceKey)),
+      );
+      const sourceReferences = sourceKeys.map((sourceKey) =>
+        this.firestore.collection(SOURCE_COLLECTION).doc(sourceKey),
+      );
+      const sourceSnapshots =
+        sourceReferences.length === 0 ?
+          []
+        : await transaction.getAll(...sourceReferences);
+      const sources = new Map<string, StoredFhirSourceState>();
+      sourceSnapshots.forEach((snapshot) => {
+        if (snapshot.exists) {
+          sources.set(snapshot.id, snapshot.data() as StoredFhirSourceState);
+        }
+      });
+      const committedSlots = slots.filter(
+        (slot) =>
+          sources.get(slot.sourceKey)?.generationId === slot.generationId,
+      );
+      const committedOwners = new Set(
+        committedSlots.map(
+          (slot) => `${slot.sourceKey}\u0000${slot.generationId}`,
+        ),
+      );
+      if (committedOwners.size > 1) {
+        transaction.set(claimReference, {
+          ...claim,
+          retirementState: "quarantined",
+          retirementAttempts: claim.retirementAttempts + 1,
+          retirementLastErrorCode: "multiple-committed-owners",
+          updatedAtMs: nowMs,
+        } satisfies IdentifierClaimDocument);
+        return "skipped" as const;
+      }
+      const pending = claim.pending;
+      const pendingIsCommitted =
+        pending !== null &&
+        sources.get(pending.sourceKey)?.generationId === pending.generationId;
+      if (
+        pending !== null &&
+        !pendingIsCommitted &&
+        pending.reservationExpiresAtMs > nowMs
+      ) {
+        transaction.set(claimReference, {
+          ...claim,
+          retireAfterMs: pending.reservationExpiresAtMs,
+          updatedAtMs: nowMs,
+        } satisfies IdentifierClaimDocument);
+        return "deferred-reservation" as const;
+      }
+      if (committedSlots.length > 0) {
+        const effectiveActive = committedSlots[0];
+        if (pending !== null && !pendingIsCommitted) {
+          transaction.delete(
+            this.firestore
+              .collection(CLAIM_PAGE_COLLECTION)
+              .doc(pending.pageId),
+          );
+        }
+        transaction.set(claimReference, {
+          ...claim,
+          active: {
+            sourceKey: effectiveActive.sourceKey,
+            generationId: effectiveActive.generationId,
+            sourceVersion: effectiveActive.sourceVersion,
+            eventSequence: effectiveActive.eventSequence,
+            entryIndexes: effectiveActive.entryIndexes,
+          },
+          pending: null,
+          retirementState: "eligible",
+          retireAfterMs: currentOwnerRecheckAtMs,
+          retirementAttempts: 0,
+          retirementLastErrorCode: null,
+          updatedAtMs: nowMs,
+        } satisfies IdentifierClaimDocument);
+        return "deferred-current" as const;
+      }
+      if (pending !== null) {
+        transaction.delete(
+          this.firestore.collection(CLAIM_PAGE_COLLECTION).doc(pending.pageId),
+        );
+      }
+      transaction.delete(claimReference);
+      return "deleted" as const;
+    });
+  }
+
