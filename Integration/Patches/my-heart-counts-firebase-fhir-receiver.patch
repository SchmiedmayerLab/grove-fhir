+  const keys = identifiers.map((identifier) =>
+    completeIdentifierKey(identifier),
+  );
+  if (new Set(keys).size !== keys.length) {
+    throw new FhirExchangeError(
+      "duplicate-observation-identifier",
+      `${path} repeats a complete (system, value) token.`,
+    );
