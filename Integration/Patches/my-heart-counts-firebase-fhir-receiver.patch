+  let value: unknown;
+  try {
+    value = JSON.parse(exactJson) as unknown;
+  } catch {
+    throw new FhirExchangeError(
+      "corrupt-source-manifest",
+      "The stored source manifest is not valid JSON.",
+    );
+  }
+  assertUniqueJsonObjectKeys(exactJson);
+  canonicalJson(value);
+  if (
+    !isJsonObject(value) ||
+    value.schemaVersion !== FHIR_EXCHANGE_SCHEMA_VERSION ||
+    typeof value.sourceKey !== "string" ||
+    typeof value.generationId !== "string" ||
+    !Array.isArray(value.activeObservations)
+  ) {
+    throw new FhirExchangeError(
+      "corrupt-source-manifest",
+      "The stored source manifest has an invalid shape.",
+    );
+  }
+  for (const observation of value.activeObservations) {
+    if (
+      !isJsonObject(observation) ||
+      !Array.isArray(observation.identifiers) ||
+      !Array.isArray(observation.identifierKeys)
+    ) {
+      throw new FhirExchangeError(
+        "corrupt-source-manifest",
+        "The stored source manifest contains an invalid Observation index.",
+      );
+    }
+  }
+  return value as unknown as StoredFhirSourceManifest;
+}
+
+function generationIdentifier(
+  sourceKey: string,
+  submission: FhirBundleSubmission,
+  payloadDigest: string,
+): string {
+  return `generation-v2-${sha256(
+    canonicalJson([
+      sourceKey,
+      submission.eventSequence,
+      submission.operation,
+      submission.sourceVersion,
+      payloadDigest,
+    ]),
+  )}`;
+}
+
+function identifierClaims(
+  partitionIdentifier: CompleteFhirIdentifier,
+  sourceKey: string,
+  generationId: string,
+  sourceVersion: string,
+  eventSequence: string,
+  observations: ParsedObservation[],
+  updatedAtMs: number,
+): StoredFhirObservationIdentifier[] {
+  const ownersByKey = new Map<string, IdentifierOwners>();
+  for (const observation of observations) {
+    for (const identifier of observation.identifiers) {
+      const key = partitionedCompleteIdentifierKey(
+        partitionIdentifier,
+        identifier,
+        "fhir-observation-identifier-v2",
+      );
+      const owners = ownersByKey.get(key);
+      if (owners === undefined) {
+        ownersByKey.set(key, {
+          identifier,
+          entryIndexes: [observation.entryIndex],
+        });
+      } else {
+        if (canonicalJson(owners.identifier) !== canonicalJson(identifier)) {
+          throw new FhirExchangeError(
+            "identifier-key-collision",
+            `Identifier key ${key} resolves to different complete tokens.`,
+          );
+        }
+        owners.entryIndexes.push(observation.entryIndex);
+      }
+    }
+  }
+  return Array.from(ownersByKey.entries())
+    .sort(([left], [right]) => left.localeCompare(right))
+    .map(([identifierKey, owners]) => ({
+      schemaVersion: FHIR_EXCHANGE_SCHEMA_VERSION,
+      identifierKey,
+      identifier: owners.identifier,
+      partitionIdentifier,
+      sourceKey,
+      generationId,
+      sourceVersion,
+      eventSequence,
+      entryIndexes: owners.entryIndexes,
+      updatedAtMs,
+    }));
+}
+
+export class FhirBundleReceiver {
+  private readonly partitionIdentifier: CompleteFhirIdentifier;
+
+  constructor(
+    private readonly store: FhirBundleStore,
+    partitionIdentifier: CompleteFhirIdentifier,
+    private readonly terminalRetentionMs: number,
+    private readonly now: () => number = Date.now,
+    private readonly uploadStagingLifetimeMs = DEFAULT_FHIR_UPLOAD_STAGING_LIFETIME_MS,
+  ) {
+    assertCompleteIdentifier(partitionIdentifier, "partitionIdentifier");
+    if (
+      !Number.isSafeInteger(terminalRetentionMs) ||
+      terminalRetentionMs < 1 ||
+      terminalRetentionMs > Number.MAX_SAFE_INTEGER / 2
+    ) {
+      throw new FhirExchangeError(
+        "invalid-retention-policy",
+        "terminalRetentionMs must be a bounded positive safe integer.",
+      );
+    }
+    if (
+      !Number.isSafeInteger(uploadStagingLifetimeMs) ||
+      uploadStagingLifetimeMs < 1 ||
+      uploadStagingLifetimeMs > Number.MAX_SAFE_INTEGER / 2
+    ) {
+      throw new FhirExchangeError(
+        "invalid-staging-policy",
+        "uploadStagingLifetimeMs must be a bounded positive safe integer.",
+      );
+    }
+    this.partitionIdentifier = copyCompleteIdentifier(partitionIdentifier);
+  }
+
+  async receive(submissionValue: unknown): Promise<ReceiveFhirBundleResult> {
+    const submission = parseSubmission(submissionValue);
+    compareSourceVersions(submission.sourceVersion, submission.sourceVersion);
+    compareEventSequences(submission.eventSequence, submission.eventSequence);
+    const parsed = parseBundle(submission.bundleJson);
+    assertBundleSourceIdentifier(parsed, submission.sourceIdentifier);
+    const payloadDigest = sha256(submission.bundleJson);
+    const sourceKey = partitionedCompleteIdentifierKey(
+      this.partitionIdentifier,
+      submission.sourceIdentifier,
+      "fhir-source-v2",
+    );
+    const generationId = generationIdentifier(
+      sourceKey,
+      submission,
+      payloadDigest,
+    );
+    const deliveryId = deliveryIdentifier(
+      sourceKey,
+      submission.eventSequence,
+      submission.operation,
+      payloadDigest,
+    );
+    const receivedAtMs = this.now();
+    if (!Number.isSafeInteger(receivedAtMs) || receivedAtMs < 0) {
+      throw new FhirExchangeError(
+        "invalid-receiver-clock",
+        "Receiver clock must return non-negative epoch milliseconds.",
+      );
+    }
+
+    let bundleObject: StoredFhirObjectReference | undefined;
+    let manifestObject: StoredFhirObjectReference | undefined;
+    for (let attempt = 0; attempt < SOURCE_COMMIT_ATTEMPTS; attempt += 1) {
+      const current = await this.store.getSource(sourceKey);
+      const currentSchemaVersion: unknown = current?.schemaVersion;
+      if (
+        current !== undefined &&
+        (currentSchemaVersion !== FHIR_EXCHANGE_SCHEMA_VERSION ||
+          canonicalJson(current.partitionIdentifier) !==
+            canonicalJson(this.partitionIdentifier) ||
+          canonicalJson(current.sourceIdentifier) !==
+            canonicalJson(submission.sourceIdentifier))
+      ) {
+        throw new FhirExchangeError(
+          "source-key-collision",
+          "The source key resolves to a different schema, partition, or complete identifier.",
+        );
+      }
+
+      if (current !== undefined) {
+        const eventOrdering = compareEventSequences(
+          submission.eventSequence,
+          current.eventSequence,
+        );
+        if (eventOrdering < 0) {
+          return {
+            status: "rejected-older",
+            sourceKey,
+            currentEventSequence: current.eventSequence,
+          };
+        }
+        if (eventOrdering === 0) {
+          const currentBundleJson = await this.store.readObject(
+            current.bundleObject,
+          );
+          assertObjectReferenceContent(current.bundleObject, currentBundleJson);
+          if (
+            current.operation === submission.operation &&
+            current.sourceVersion === submission.sourceVersion &&
+            current.payloadDigest === payloadDigest &&
+            currentBundleJson === submission.bundleJson
+          ) {
+            return { status: "replayed", sourceKey, deliveryId };
+          }
+          throw new FhirExchangeError(
+            "event-sequence-conflict",
+            "The same event sequence was submitted with different content or source revision.",
+          );
+        }
+
+        if (
+          submission.operation === "delete" &&
+          submission.sourceVersion !== current.sourceVersion
+        ) {
+          throw new FhirExchangeError(
+            "deletion-source-version-mismatch",
+            "A deletion must retain the last journaled source version.",
+          );
+        }
+      }
+
+      let currentObservations: ParsedObservation[] | undefined;
+      if (current !== undefined && current.operation !== "delete") {
+        const manifestJson = await this.store.readObject(
+          current.manifestObject,
+        );
+        assertObjectReferenceContent(current.manifestObject, manifestJson);
+        currentObservations = observationsFromManifest(
+          current,
+          parseStoredManifest(manifestJson),
+        );
+      }
+      if (submission.operation === "delete") {
+        assertCompleteDeletionBundle(currentObservations, parsed.observations);
+      }
+      const invalidatedObservationCount =
+        submission.operation === "upsert" ?
+          assertCompleteReplacementBundle(
+            currentObservations,
+            parsed.observations,
+          )
+        : parsed.observations.length;
+      const nextObservations =
+        submission.operation === "upsert" ?
+          parsed.observations.filter(
+            (observation) => observation.resource.status !== "entered-in-error",
+          )
+        : [];
+      const activeObservations: StoredObservationIndex[] = nextObservations.map(
+        (observation) => ({
+          entryIndex: observation.entryIndex,
+          identifiers: observation.identifiers,
+          identifierKeys: observation.identifiers.map((identifier) =>
+            partitionedCompleteIdentifierKey(
+              this.partitionIdentifier,
+              identifier,
+              "fhir-observation-identifier-v2",
+            ),
+          ),
+        }),
+      );
+      const manifest: StoredFhirSourceManifest = {
+        schemaVersion: FHIR_EXCHANGE_SCHEMA_VERSION,
+        sourceKey,
+        generationId,
+        activeObservations,
+      };
+      const manifestJson = JSON.stringify(manifest);
+      if (Buffer.byteLength(manifestJson, "utf8") > MAX_FHIR_MANIFEST_BYTES) {
+        throw new FhirExchangeError(
+          "manifest-too-large",
+          `FHIR identity manifest exceeds ${MAX_FHIR_MANIFEST_BYTES} UTF-8 bytes.`,
+        );
+      }
+      const partitionKey = completeIdentifierKey(
+        this.partitionIdentifier,
+        "fhir-partition-v2",
+      );
+      const objectPrefix = `fhir-exchange/v2/${partitionKey}/${sourceKey}`;
+      const bundleCandidate = objectCandidate(
+        `${objectPrefix}/bundles/${generationId}-${payloadDigest}.json`,
+        submission.bundleJson,
+      );
+      const manifestCandidate = objectCandidate(
+        `${objectPrefix}/manifests/${generationId}-${sha256(manifestJson)}.json`,
+        manifestJson,
+      );
+      const staging: FhirBundleUploadStaging = {
+        schemaVersion: FHIR_EXCHANGE_SCHEMA_VERSION,
+        stagingId: deliveryId,
+        sourceKey,
+        generationId,
+        partitionIdentifier: this.partitionIdentifier,
+        sourceIdentifier: submission.sourceIdentifier,
+        sourceVersion: submission.sourceVersion,
+        eventSequence: submission.eventSequence,
+        operation: submission.operation,
+        payloadDigest,
+        bundleCandidate,
+        manifestCandidate,
+        state: "staging",
+        expiresAtMs: Math.min(
+          Number.MAX_SAFE_INTEGER,
+          receivedAtMs + this.uploadStagingLifetimeMs,
+        ),
+        garbageCollectionLeaseId: null,
+        garbageCollectionLeaseExpiresAtMs: null,
+        garbageCollectionAttempts: 0,
+        garbageCollectionLastErrorCode: null,
+        createdAtMs: receivedAtMs,
+        updatedAtMs: receivedAtMs,
+      };
+      if (serializedBytes(staging) > MAX_DELIVERY_METADATA_BYTES) {
+        throw new FhirExchangeError(
+          "staging-metadata-too-large",
+          `Upload staging metadata exceeds ${MAX_DELIVERY_METADATA_BYTES} UTF-8 bytes.`,
+        );
+      }
+      if (
+        !(await this.store.stageUpload({
+          expectedGenerationId: current?.generationId ?? null,
+          staging,
+        }))
+      ) {
+        continue;
+      }
+      if (bundleObject === undefined) {
+        bundleObject = await this.store.putStagedObject(
+          staging,
+          bundleCandidate,
+          submission.bundleJson,
+        );
+        assertObjectReferenceContent(bundleObject, submission.bundleJson);
+        manifestObject = await this.store.putStagedObject(
+          staging,
+          manifestCandidate,
+          manifestJson,
+        );
+        assertObjectReferenceContent(manifestObject, manifestJson);
+      }
+      if (manifestObject === undefined) {
+        throw new FhirExchangeError(
+          "missing-manifest-object",
+          "The immutable manifest object was not created.",
+        );
+      }
+      const claims = identifierClaims(
+        this.partitionIdentifier,
+        sourceKey,
+        generationId,
+        submission.sourceVersion,
+        submission.eventSequence,
+        nextObservations,
+        receivedAtMs,
+      );
+      const nextSource: StoredFhirSourceState = {
+        schemaVersion: FHIR_EXCHANGE_SCHEMA_VERSION,
+        sourceKey,
+        generationId,
+        partitionIdentifier: this.partitionIdentifier,
+        sourceIdentifier: submission.sourceIdentifier,
+        sourceVersion: submission.sourceVersion,
+        eventSequence: submission.eventSequence,
+        operation: submission.operation,
+        payloadDigest,
+        bundleObject,
+        manifestObject,
+        activeObservationCount: activeObservations.length,
+        activeIdentifierCount: claims.length,
+        updatedAtMs: receivedAtMs,
+      };
+      const newDelivery: FhirBundleDelivery = {
+        schemaVersion: FHIR_EXCHANGE_SCHEMA_VERSION,
+        deliveryId,
+        sourceKey,
+        partitionIdentifier: this.partitionIdentifier,
+        sourceIdentifier: submission.sourceIdentifier,
+        sourceVersion: submission.sourceVersion,
+        eventSequence: submission.eventSequence,
+        operation: submission.operation,
+        payloadDigest,
+        generationId,
+        bundleObject,
+        manifestObject,
+        state: "pending",
+        attempts: 0,
+        redriveCount: 0,
+        leaseId: null,
+        nextAttemptAtMs: receivedAtMs,
+        lastErrorCode: null,
+        retentionDurationMs: this.terminalRetentionMs,
+        retainUntilMs: null,
+        garbageCollectionLeaseId: null,
+        garbageCollectionLeaseExpiresAtMs: null,
+        garbageCollectionPreviousState: null,
+        garbageCollectionAttempts: 0,
+        garbageCollectionLastErrorCode: null,
+        createdAtMs: receivedAtMs,
+        updatedAtMs: receivedAtMs,
+      };
+      if (serializedBytes(newDelivery) > MAX_DELIVERY_METADATA_BYTES) {
+        throw new FhirExchangeError(
+          "delivery-metadata-too-large",
+          `Durable delivery metadata exceeds ${MAX_DELIVERY_METADATA_BYTES} UTF-8 bytes.`,
+        );
+      }
+      const reservationExpiresAtMs = Math.min(
+        Number.MAX_SAFE_INTEGER,
+        receivedAtMs + IDENTIFIER_RESERVATION_MS,
+      );
+      const committed = await this.store.commitSource({
+        expectedGenerationId: current?.generationId ?? null,
+        stagingId: staging.stagingId,
+        nextSource,
+        newDelivery,
+        identifierClaims: claims,
+        reservationExpiresAtMs,
+      });
+      if (committed) {
+        return {
+          status: "accepted",
+          sourceKey,
+          deliveryId,
+          invalidatedObservationCount,
+        };
+      }
+    }
+
+    throw new FhirExchangeError(
+      "source-contention",
+      "The source changed repeatedly while committing this event; retry it with identical bytes.",
+    );
+  }
+}
+
+function deliveryIdentifier(
+  sourceKey: string,
+  eventSequence: string,
+  operation: FhirBundleSubmission["operation"],
+  payloadDigest: string,
+): string {
+  return `delivery-v2-${sha256(
+    canonicalJson([sourceKey, eventSequence, operation, payloadDigest]),
+  )}`;
+}
+
+function safeErrorCode(error: unknown): string {
+  if (
+    typeof error === "object" &&
+    error !== null &&
+    "code" in error &&
+    typeof error.code === "string" &&
+    /^[A-Za-z0-9_.-]{1,128}$/.test(error.code)
+  ) {
+    return error.code;
+  }
+  return "delivery-failed";
+}
+
+export interface DeliveryBatchResult {
+  delivered: number;
+  scheduledForRetry: number;
+  deadLettered: number;
+}
+
+export interface HydratedFhirBundleDelivery extends FhirBundleDelivery {
+  /** Exact UTF-8 JSON loaded from the immutable object generation. */
+  bundleJson: string;
+}
+
+type DeliveryClaimResult =
+  | { status: "skipped" }
+  | { status: "dead-letter" }
+  | { status: "claimed"; delivery: FhirBundleDelivery };
+
+function terminalRetentionDeadline(
+  delivery: FhirBundleDelivery,
+  nowMs: number,
+): number {
+  if (
+    !Number.isSafeInteger(delivery.retentionDurationMs) ||
+    delivery.retentionDurationMs < 1 ||
+    delivery.retentionDurationMs > Number.MAX_SAFE_INTEGER / 2
+  ) {
+    throw new FhirExchangeError(
+      "corrupt-delivery",
+      `Delivery ${delivery.deliveryId} has an invalid retention duration.`,
+    );
+  }
+  return Math.min(
+    Number.MAX_SAFE_INTEGER,
+    nowMs + delivery.retentionDurationMs,
+  );
+}
+
+export class FhirBundleDeliveryWorker {
+  /**
+   * `deliver` must be idempotent by deliveryId and must atomically apply the
+   * highest eventSequence it has seen for each sourceKey. Independent retries
+   * can arrive out of order, and two workers may observe one pending record
+   * before either commits its result.
+   */
+  constructor(
+    private readonly store: FhirBundleStore,
+    private readonly deliver: (
+      delivery: HydratedFhirBundleDelivery,
+    ) => Promise<void>,
+    private readonly maximumAttempts = 5,
+    private readonly initialRetryDelayMs = 60_000,
+    private readonly leaseDurationMs = 5 * 60_000,
+  ) {
+    if (!Number.isSafeInteger(maximumAttempts) || maximumAttempts < 1) {
+      throw new FhirExchangeError(
+        "invalid-retry-policy",
+        "maximumAttempts must be a positive safe integer.",
+      );
+    }
+    if (
+      !Number.isSafeInteger(initialRetryDelayMs) ||
+      initialRetryDelayMs < 1 ||
+      initialRetryDelayMs > Number.MAX_SAFE_INTEGER / 2 ** 10
+    ) {
+      throw new FhirExchangeError(
+        "invalid-retry-policy",
+        "initialRetryDelayMs must be a bounded positive safe integer.",
+      );
+    }
+    if (
+      !Number.isSafeInteger(leaseDurationMs) ||
+      leaseDurationMs < 1 ||
+      leaseDurationMs > Number.MAX_SAFE_INTEGER / 2
+    ) {
+      throw new FhirExchangeError(
+        "invalid-retry-policy",
+        "leaseDurationMs must be a bounded positive safe integer.",
+      );
+    }
+  }
+
+  async processDue(nowMs: number, limit = 100): Promise<DeliveryBatchResult> {
+    if (!Number.isSafeInteger(nowMs) || nowMs < 0) {
+      throw new FhirExchangeError(
+        "invalid-worker-clock",
+        "Delivery worker time must be non-negative epoch milliseconds.",
+      );
+    }
+    if (!Number.isSafeInteger(limit) || limit < 1 || limit > 500) {
+      throw new FhirExchangeError(
+        "invalid-delivery-limit",
+        "Delivery query limit must be an integer from 1 through 500.",
+      );
+    }
+    const deliveries = await this.store.listDueDeliveries(nowMs, limit);
+    const result: DeliveryBatchResult = {
+      delivered: 0,
+      scheduledForRetry: 0,
+      deadLettered: 0,
+    };
+
+    for (const delivery of deliveries) {
+      const leaseId = randomUUID();
+      const claimed = await this.store.transactDelivery<DeliveryClaimResult>(
+        delivery.sourceKey,
+        delivery.deliveryId,
+        (current) => {
+          if (
+            current.state !== "pending" ||
+            current.nextAttemptAtMs === null ||
+            current.nextAttemptAtMs > nowMs
+          ) {
+            return {
+              result: { status: "skipped" as const },
+              nextDelivery: current,
+            };
+          }
+          if (current.attempts >= this.maximumAttempts) {
+            return {
+              result: { status: "dead-letter" as const },
+              nextDelivery: {
+                ...current,
+                state: "dead-letter" as const,
+                leaseId: null,
+                nextAttemptAtMs: null,
+                lastErrorCode: "delivery-attempt-abandoned",
+                retainUntilMs: terminalRetentionDeadline(current, nowMs),
+                updatedAtMs: nowMs,
+              },
+            };
+          }
+          const nextDelivery: FhirBundleDelivery = {
+            ...current,
+            attempts: current.attempts + 1,
+            leaseId,
+            nextAttemptAtMs: Math.min(
+              Number.MAX_SAFE_INTEGER,
+              nowMs + this.leaseDurationMs,
+            ),
+            lastErrorCode: null,
+            updatedAtMs: nowMs,
+          };
+          return {
+            result: { status: "claimed" as const, delivery: nextDelivery },
+            nextDelivery,
+          };
+        },
+      );
+      if (claimed.status === "skipped") {
+        continue;
+      }
+      if (claimed.status === "dead-letter") {
+        result.deadLettered += 1;
+        continue;
+      }
+      const claimedDelivery = claimed.delivery;
+      try {
+        const bundleJson = await this.store.readObject(
+          claimedDelivery.bundleObject,
+        );
+        assertObjectReferenceContent(claimedDelivery.bundleObject, bundleJson);
+        await this.deliver({ ...claimedDelivery, bundleJson });
+        const committed = await this.store.transactDelivery(
+          claimedDelivery.sourceKey,
+          claimedDelivery.deliveryId,
+          (current) => {
+            const ownsLease =
+              current.state === "pending" && current.leaseId === leaseId;
+            return {
+              result: ownsLease,
+              nextDelivery:
+                ownsLease ?
+                  {
+                    ...current,
+                    state: "delivered" as const,
+                    leaseId: null,
+                    nextAttemptAtMs: null,
+                    lastErrorCode: null,
+                    retainUntilMs: terminalRetentionDeadline(current, nowMs),
+                    updatedAtMs: nowMs,
+                  }
+                : current,
+            };
+          },
+        );
+        if (committed) {
+          result.delivered += 1;
+        }
+      } catch (error) {
+        const outcome = await this.store.transactDelivery(
+          claimedDelivery.sourceKey,
+          claimedDelivery.deliveryId,
+          (current) => {
+            if (current.state !== "pending" || current.leaseId !== leaseId) {
+              return { result: "superseded" as const, nextDelivery: current };
+            }
+            const exhausted = current.attempts >= this.maximumAttempts;
+            const retryDelay =
+              this.initialRetryDelayMs *
+              2 ** Math.min(current.attempts - 1, 10);
+            const state: FhirDeliveryState =
+              exhausted ? "dead-letter" : "pending";
+            return {
+              result: state,
+              nextDelivery: {
+                ...current,
+                state,
+                leaseId: null,
+                nextAttemptAtMs:
+                  exhausted ? null : (
+                    Math.min(Number.MAX_SAFE_INTEGER, nowMs + retryDelay)
+                  ),
+                lastErrorCode: safeErrorCode(error),
+                retainUntilMs:
+                  exhausted ? terminalRetentionDeadline(current, nowMs) : null,
+                updatedAtMs: nowMs,
+              },
+            };
+          },
+        );
+        if (outcome === "dead-letter") {
+          result.deadLettered += 1;
+        } else if (outcome === "pending") {
+          result.scheduledForRetry += 1;
+        }
+      }
+    }
+
+    return result;
+  }
+
+  async redriveDeadLetter(
+    sourceKey: string,
+    deliveryId: string,
+    nowMs: number,
+  ): Promise<FhirBundleDelivery> {
+    if (!Number.isSafeInteger(nowMs) || nowMs < 0) {
+      throw new FhirExchangeError(
+        "invalid-worker-clock",
+        "Delivery redrive time must be non-negative epoch milliseconds.",
+      );
+    }
+    return this.store.transactDelivery(sourceKey, deliveryId, (current) => {
+      if (current.state !== "dead-letter") {
+        throw new FhirExchangeError(
+          "delivery-not-dead-lettered",
+          `Delivery ${deliveryId} is not available for redrive.`,
+        );
+      }
+      if (
+        !Number.isSafeInteger(current.redriveCount) ||
+        current.redriveCount < 0 ||
+        current.redriveCount >= Number.MAX_SAFE_INTEGER
+      ) {
+        throw new FhirExchangeError(
+          "corrupt-delivery",
+          `Delivery ${deliveryId} has an invalid redrive count.`,
+        );
+      }
+      const nextDelivery: FhirBundleDelivery = {
+        ...current,
+        state: "pending",
+        attempts: 0,
+        redriveCount: current.redriveCount + 1,
+        leaseId: null,
+        nextAttemptAtMs: nowMs,
+        lastErrorCode: null,
+        retainUntilMs: null,
+        garbageCollectionLeaseId: null,
+        garbageCollectionLeaseExpiresAtMs: null,
+        garbageCollectionPreviousState: null,
+        garbageCollectionAttempts: 0,
+        garbageCollectionLastErrorCode: null,
+        updatedAtMs: nowMs,
+      };
+      return { result: nextDelivery, nextDelivery };
+    });
+  }
+}
+
+export interface GarbageCollectionBatchResult {
+  examined: number;
+  deleted: number;
+  deferredCurrent: number;
+  retiredIdentifierClaims: number;
+  deletedClaimPages: number;
+  failed: number;
+  quarantined: number;
+}
+
+/**
+ * Deletes expired upload staging and terminal delivery history without
+ * deleting the current source generation. The deployment chooses the terminal
+ * retention duration when it constructs the receiver; this worker enforces
+ * both that policy and the recorded staging-expiration boundary.
+ */
+export class FhirBundleRetentionWorker {
+  constructor(
+    private readonly store: FhirBundleStore,
+    private readonly leaseDurationMs = 5 * 60_000,
+    private readonly currentHeadRecheckMs = 24 * 60 * 60_000,
+    private readonly maximumAttempts = 5,
+    private readonly initialRetryDelayMs = 60_000,
+  ) {
+    for (const [label, value] of [
+      ["leaseDurationMs", leaseDurationMs],
+      ["currentHeadRecheckMs", currentHeadRecheckMs],
+    ] as const) {
+      if (
+        !Number.isSafeInteger(value) ||
+        value < 1 ||
+        value > Number.MAX_SAFE_INTEGER / 2
+      ) {
+        throw new FhirExchangeError(
+          "invalid-retention-policy",
+          `${label} must be a bounded positive safe integer.`,
+        );
+      }
+    }
+    if (!Number.isSafeInteger(maximumAttempts) || maximumAttempts < 1) {
+      throw new FhirExchangeError(
+        "invalid-retention-policy",
+        "maximumAttempts must be a positive safe integer.",
+      );
+    }
+    if (
+      !Number.isSafeInteger(initialRetryDelayMs) ||
+      initialRetryDelayMs < 1 ||
+      initialRetryDelayMs > Number.MAX_SAFE_INTEGER / 2 ** 10
+    ) {
+      throw new FhirExchangeError(
+        "invalid-retention-policy",
+        "initialRetryDelayMs must be a bounded positive safe integer.",
+      );
+    }
+  }
+
+  private retryAt(nowMs: number, attempts: number): number {
+    const delay =
+      this.initialRetryDelayMs * 2 ** Math.min(Math.max(attempts, 0), 10);
+    return Math.min(Number.MAX_SAFE_INTEGER, nowMs + delay);
+  }
+
+  async processExpired(
+    nowMs: number,
+    limit = 100,
+  ): Promise<GarbageCollectionBatchResult> {
+    if (!Number.isSafeInteger(nowMs) || nowMs < 0) {
+      throw new FhirExchangeError(
+        "invalid-worker-clock",
+        "Retention worker time must be non-negative epoch milliseconds.",
+      );
+    }
+    if (!Number.isSafeInteger(limit) || limit < 1 || limit > 500) {
+      throw new FhirExchangeError(
+        "invalid-delivery-limit",
+        "Retention query limit must be an integer from 1 through 500.",
+      );
+    }
+    const result: GarbageCollectionBatchResult = {
+      examined: 0,
+      deleted: 0,
+      deferredCurrent: 0,
+      retiredIdentifierClaims: 0,
+      deletedClaimPages: 0,
+      failed: 0,
+      quarantined: 0,
+    };
+    const stagedUploads = await this.store.listExpiredUploadStaging(
+      nowMs,
+      limit,
+    );
+    result.examined += stagedUploads.length;
+    for (const staging of stagedUploads) {
+      const leaseId = randomUUID();
+      const claim = await this.store.beginUploadStagingGarbageCollection(
+        staging.stagingId,
+        leaseId,
+        nowMs,
+        Math.min(Number.MAX_SAFE_INTEGER, nowMs + this.leaseDurationMs),
+      );
+      if (claim.status === "deferred-current") {
+        result.deferredCurrent += 1;
+        continue;
+      }
+      if (claim.status === "skipped") {
+        continue;
+      }
+      try {
+        const objectKeys = new Set<string>();
+        for (const candidate of claim.objects) {
+          const objectKey = `${candidate.path}\u0000${candidate.sha256}`;
+          if (!objectKeys.has(objectKey)) {
+            objectKeys.add(objectKey);
+            await this.store.deleteObjectCandidate(candidate);
+          }
+        }
+        if (
+          await this.store.completeUploadStagingGarbageCollection(
+            staging.stagingId,
+            leaseId,
+          )
+        ) {
+          result.deleted += 1;
+        }
+      } catch (error) {
+        result.failed += 1;
+        const outcome =
+          await this.store.recordUploadStagingGarbageCollectionFailure(
+            staging.stagingId,
+            leaseId,
+            nowMs,
+            this.maximumAttempts,
+            this.retryAt(nowMs, staging.garbageCollectionAttempts),
+            safeErrorCode(error),
+          );
+        if (outcome === "quarantined") {
+          result.quarantined += 1;
+        }
+      }
+    }
+
+    const deliveries = await this.store.listExpiredDeliveries(nowMs, limit);
+    result.examined += deliveries.length;
+    for (const delivery of deliveries) {
+      const leaseId = randomUUID();
+      const claim = await this.store.beginDeliveryGarbageCollection(
+        delivery.sourceKey,
+        delivery.deliveryId,
+        leaseId,
+        nowMs,
+        Math.min(Number.MAX_SAFE_INTEGER, nowMs + this.leaseDurationMs),
+        Math.min(Number.MAX_SAFE_INTEGER, nowMs + this.currentHeadRecheckMs),
+      );
+      if (claim.status === "deferred-current") {
+        result.deferredCurrent += 1;
+        continue;
+      }
+      if (claim.status === "skipped") {
+        continue;
+      }
+      try {
+        const objectKeys = new Set<string>();
+        for (const reference of claim.objects) {
+          const objectKey = `${reference.path}\u0000${reference.generation}`;
+          if (!objectKeys.has(objectKey)) {
+            objectKeys.add(objectKey);
+            await this.store.deleteObject(reference);
+          }
+        }
+        if (
+          await this.store.completeDeliveryGarbageCollection(
+            delivery.sourceKey,
+            delivery.deliveryId,
+            leaseId,
+          )
+        ) {
+          result.deleted += 1;
+        }
+      } catch (error) {
+        result.failed += 1;
+        const outcome = await this.store.recordDeliveryGarbageCollectionFailure(
+          delivery.sourceKey,
+          delivery.deliveryId,
+          leaseId,
+          nowMs,
+          this.maximumAttempts,
+          this.retryAt(nowMs, delivery.garbageCollectionAttempts),
+          safeErrorCode(error),
+        );
+        if (outcome === "quarantined") {
+          result.quarantined += 1;
+        }
+      }
+    }
+
+    const identifierKeys = await this.store.listRetirableIdentifierClaims(
+      nowMs,
+      limit,
+    );
+    result.examined += identifierKeys.length;
+    for (const identifierKey of identifierKeys) {
+      try {
+        const outcome = await this.store.retireIdentifierClaim(
+          identifierKey,
+          nowMs,
+          Math.min(Number.MAX_SAFE_INTEGER, nowMs + this.currentHeadRecheckMs),
+        );
+        if (outcome === "deleted") {
+          result.retiredIdentifierClaims += 1;
+        } else if (outcome === "deferred-current") {
+          result.deferredCurrent += 1;
+        }
+      } catch {
+        result.failed += 1;
+      }
+    }
+
+    const claimPageIds = await this.store.listExpiredIdentifierClaimPages(
+      nowMs,
+      limit,
+    );
+    result.examined += claimPageIds.length;
+    for (const pageId of claimPageIds) {
+      try {
+        if (await this.store.deleteExpiredIdentifierClaimPage(pageId, nowMs)) {
+          result.deletedClaimPages += 1;
+        }
+      } catch {
+        result.failed += 1;
+      }
+    }
+    return result;
+  }
+}
+
+export interface RetentionDrainResult extends GarbageCollectionBatchResult {
+  batches: number;
+  budgetExhausted: boolean;
+}
+
+/** Drains successive indexed pages while leaving time for a clean shutdown. */
+export async function drainFhirBundleRetention(
+  worker: FhirBundleRetentionWorker,
+  clock: () => number = Date.now,
+  batchSize = 500,
+  maximumExamined = 20_000,
+  runtimeBudgetMs = 8 * 60_000,
+): Promise<RetentionDrainResult> {
+  for (const [label, value, maximum] of [
+    ["batchSize", batchSize, 500],
+    ["maximumExamined", maximumExamined, Number.MAX_SAFE_INTEGER],
+    ["runtimeBudgetMs", runtimeBudgetMs, Number.MAX_SAFE_INTEGER / 2],
+  ] as const) {
+    if (!Number.isSafeInteger(value) || value < 1 || value > maximum) {
+      throw new FhirExchangeError(
+        "invalid-retention-policy",
+        `${label} must be a bounded positive safe integer.`,
+      );
+    }
+  }
+  const startedAtMs = clock();
+  if (!Number.isSafeInteger(startedAtMs) || startedAtMs < 0) {
+    throw new FhirExchangeError(
+      "invalid-worker-clock",
+      "Retention drain clock must return non-negative epoch milliseconds.",
+    );
+  }
+  const result: RetentionDrainResult = {
+    examined: 0,
+    deleted: 0,
+    deferredCurrent: 0,
+    retiredIdentifierClaims: 0,
+    deletedClaimPages: 0,
+    failed: 0,
+    quarantined: 0,
+    batches: 0,
+    budgetExhausted: false,
+  };
+  while (result.examined < maximumExamined) {
+    const nowMs = clock();
+    if (!Number.isSafeInteger(nowMs) || nowMs < startedAtMs) {
+      throw new FhirExchangeError(
+        "invalid-worker-clock",
+        "Retention drain clock must be monotonic epoch milliseconds.",
+      );
+    }
+    if (nowMs - startedAtMs >= runtimeBudgetMs) {
+      break;
+    }
+    const batch = await worker.processExpired(nowMs, batchSize);
+    result.batches += 1;
+    result.examined += batch.examined;
+    result.deleted += batch.deleted;
+    result.deferredCurrent += batch.deferredCurrent;
+    result.retiredIdentifierClaims += batch.retiredIdentifierClaims;
+    result.deletedClaimPages += batch.deletedClaimPages;
+    result.failed += batch.failed;
+    result.quarantined += batch.quarantined;
+    if (batch.examined === 0) {
+      break;
+    }
+  }
+  const finishedAtMs = clock();
+  if (!Number.isSafeInteger(finishedAtMs) || finishedAtMs < startedAtMs) {
+    throw new FhirExchangeError(
+      "invalid-worker-clock",
+      "Retention drain clock must be monotonic epoch milliseconds.",
+    );
+  }
+  result.budgetExhausted =
+    result.examined >= maximumExamined ||
+    finishedAtMs - startedAtMs >= runtimeBudgetMs;
+  return result;
+}
+
+/**
+ * A deterministic memory store for unit tests and local contract consumers.
+ * Production code should use the transactional Firestore implementation.
+ */
+export class MemoryFhirBundleStore implements FhirBundleStore {
+  readonly sources = new Map<string, StoredFhirSourceState>();
+  readonly deliveries = new Map<string, FhirBundleDelivery>();
+  readonly uploadStaging = new Map<string, FhirBundleUploadStaging>();
+  readonly observationIdentifiers = new Map<
+    string,
+    StoredFhirObservationIdentifier
+  >();
+  readonly objects = new Map<
+    string,
+    { reference: StoredFhirObjectReference; exactJson: string }
+  >();
+
+  putObject(
+    path: string,
+    exactJson: string,
+  ): Promise<StoredFhirObjectReference> {
+    const reference: StoredFhirObjectReference = {
+      path,
+      generation: `memory-${sha256(exactJson)}`,
+      sha256: sha256(exactJson),
+      utf8Bytes: Buffer.byteLength(exactJson, "utf8"),
+    };
+    const existing = this.objects.get(path);
+    if (existing !== undefined) {
+      if (existing.exactJson !== exactJson) {
+        throw new FhirExchangeError(
+          "immutable-object-conflict",
+          `Object ${path} already exists with different bytes.`,
+        );
+      }
+      return Promise.resolve(existing.reference);
+    }
+    this.objects.set(path, { reference, exactJson });
+    return Promise.resolve(reference);
+  }
+
+  readObject(reference: StoredFhirObjectReference): Promise<string> {
+    const stored = this.objects.get(reference.path);
+    if (
+      stored === undefined ||
+      canonicalJson(stored.reference) !== canonicalJson(reference)
+    ) {
+      throw new FhirExchangeError(
+        "missing-fhir-object",
+        `Immutable object ${reference.path} at generation ${reference.generation} is unavailable.`,
+      );
+    }
+    assertObjectReferenceContent(reference, stored.exactJson);
+    return Promise.resolve(stored.exactJson);
+  }
+
+  stageUpload(request: StageFhirBundleUploadRequest): Promise<boolean> {
+    const current = this.sources.get(request.staging.sourceKey);
+    if ((current?.generationId ?? null) !== request.expectedGenerationId) {
+      return Promise.resolve(false);
+    }
+    const existing = this.uploadStaging.get(request.staging.stagingId);
+    if (
+      existing !== undefined &&
+      canonicalJson(uploadStagingIdentity(existing)) !==
+        canonicalJson(uploadStagingIdentity(request.staging))
+    ) {
+      throw new FhirExchangeError(
+        "upload-staging-collision",
+        `Upload staging ${request.staging.stagingId} represents different content.`,
+      );
+    }
+    if (existing?.state === "garbage-collecting") {
+      throw new FhirExchangeError(
+        "upload-staging-expired",
+        `Upload staging ${request.staging.stagingId} is being collected; retry after it is removed.`,
+      );
+    }
+    this.uploadStaging.set(request.staging.stagingId, {
+      ...request.staging,
+      createdAtMs: existing?.createdAtMs ?? request.staging.createdAtMs,
+      expiresAtMs: Math.max(
+        existing?.expiresAtMs ?? 0,
+        request.staging.expiresAtMs,
+      ),
+      updatedAtMs: request.staging.updatedAtMs,
+    });
+    return Promise.resolve(true);
+  }
+
+  async putStagedObject(
+    staging: FhirBundleUploadStaging,
+    candidate: StagedFhirObjectCandidate,
+    exactJson: string,
+  ): Promise<StoredFhirObjectReference> {
+    assertObjectReferenceContent(candidate, exactJson);
+    const isRegisteredOrCommitted = (): boolean => {
+      const currentStaging = this.uploadStaging.get(staging.stagingId);
+      if (
+        currentStaging?.state === "staging" &&
+        canonicalJson(uploadStagingIdentity(currentStaging)) ===
+          canonicalJson(uploadStagingIdentity(staging))
+      ) {
+        return true;
+      }
+      const currentSource = this.sources.get(staging.sourceKey);
+      if (currentSource?.generationId !== staging.generationId) {
+        return false;
+      }
+      return (
+        stagingCandidateMatchesReference(
+          candidate,
+          currentSource.bundleObject,
+        ) ||
+        stagingCandidateMatchesReference(
+          candidate,
+          currentSource.manifestObject,
+        )
+      );
+    };
+    if (!isRegisteredOrCommitted()) {
+      throw new FhirExchangeError(
+        "missing-upload-staging",
+        `Object ${candidate.path} is not registered for upload.`,
+      );
+    }
+    const reference = await this.putObject(candidate.path, exactJson);
+    if (!isRegisteredOrCommitted()) {
+      await this.deleteObject(reference);
+      throw new FhirExchangeError(
+        "upload-staging-expired",
+        `Upload staging ${staging.stagingId} expired before object confirmation.`,
+      );
+    }
+    return reference;
+  }
+
+  commitSource(request: CommitFhirSourceRequest): Promise<boolean> {
+    const current = this.sources.get(request.nextSource.sourceKey);
+    if ((current?.generationId ?? null) !== request.expectedGenerationId) {
+      return Promise.resolve(false);
+    }
+    const staging = this.uploadStaging.get(request.stagingId);
+    const stagingSchemaVersion: unknown = staging?.schemaVersion;
+    if (
+      staging?.state !== "staging" ||
+      stagingSchemaVersion !== FHIR_EXCHANGE_SCHEMA_VERSION ||
+      staging.stagingId !== request.newDelivery.deliveryId ||
+      staging.sourceKey !== request.nextSource.sourceKey ||
+      staging.generationId !== request.nextSource.generationId ||
+      canonicalJson(staging.partitionIdentifier) !==
+        canonicalJson(request.nextSource.partitionIdentifier) ||
+      canonicalJson(staging.sourceIdentifier) !==
+        canonicalJson(request.nextSource.sourceIdentifier) ||
+      staging.sourceVersion !== request.nextSource.sourceVersion ||
+      staging.eventSequence !== request.nextSource.eventSequence ||
+      staging.operation !== request.nextSource.operation ||
+      staging.payloadDigest !== request.nextSource.payloadDigest ||
+      !stagingCandidateMatchesReference(
+        staging.bundleCandidate,
+        request.newDelivery.bundleObject,
+      ) ||
+      !stagingCandidateMatchesReference(
+        staging.manifestCandidate,
+        request.newDelivery.manifestObject,
+      )
+    ) {
+      throw new FhirExchangeError(
+        "missing-upload-staging",
+        `Upload staging ${request.stagingId} is absent or inconsistent.`,
+      );
+    }
+    const deliveryPath = this.deliveryPath(
+      request.nextSource.sourceKey,
+      request.newDelivery.deliveryId,
+    );
+    if (this.deliveries.has(deliveryPath)) {
+      throw new FhirExchangeError(
+        "duplicate-delivery",
+        `Delivery ${request.newDelivery.deliveryId} already exists.`,
+      );
+    }
+    for (const claim of request.identifierClaims) {
+      const existing = this.observationIdentifiers.get(claim.identifierKey);
+      if (
+        existing !== undefined &&
+        (canonicalJson(existing.partitionIdentifier) !==
+          canonicalJson(claim.partitionIdentifier) ||
+          canonicalJson(existing.identifier) !==
+            canonicalJson(claim.identifier))
+      ) {
+        throw new FhirExchangeError(
+          "identifier-key-collision",
+          `Identifier key ${claim.identifierKey} resolves to a different complete token.`,
+        );
+      }
+      if (
+        existing !== undefined &&
+        existing.sourceKey !== request.nextSource.sourceKey
+      ) {
+        throw new FhirExchangeError(
+          "observation-identifier-conflict",
+          "An Observation identifier is active for another source record.",
+        );
+      }
+    }
+    for (const [key, claim] of Array.from(
+      this.observationIdentifiers.entries(),
+    )) {
+      if (claim.sourceKey === request.nextSource.sourceKey) {
+        this.observationIdentifiers.delete(key);
+      }
+    }
+    for (const claim of request.identifierClaims) {
+      this.observationIdentifiers.set(claim.identifierKey, claim);
+    }
+    this.sources.set(request.nextSource.sourceKey, request.nextSource);
+    this.deliveries.set(deliveryPath, request.newDelivery);
+    this.uploadStaging.delete(request.stagingId);
+    return Promise.resolve(true);
+  }
+
+  getSource(sourceKey: string): Promise<StoredFhirSourceState | undefined> {
+    return Promise.resolve(this.sources.get(sourceKey));
+  }
+
+  listDueDeliveries(
+    nowMs: number,
+    limit: number,
+  ): Promise<FhirBundleDelivery[]> {
+    return Promise.resolve(
+      Array.from(this.deliveries.values())
+        .filter(
+          (delivery) =>
+            delivery.state === "pending" &&
+            delivery.nextAttemptAtMs !== null &&
+            delivery.nextAttemptAtMs <= nowMs,
+        )
+        .sort((left, right) =>
+          left.nextAttemptAtMs === right.nextAttemptAtMs ?
+            left.deliveryId.localeCompare(right.deliveryId)
+          : (left.nextAttemptAtMs ?? 0) - (right.nextAttemptAtMs ?? 0),
+        )
+        .slice(0, limit),
+    );
+  }
+
+  listExpiredDeliveries(
+    nowMs: number,
+    limit: number,
+  ): Promise<FhirBundleDelivery[]> {
+    return Promise.resolve(
+      Array.from(this.deliveries.values())
+        .filter(
+          (delivery) =>
+            (delivery.state === "delivered" ||
+              delivery.state === "dead-letter" ||
+              delivery.state === "garbage-collecting") &&
+            delivery.retainUntilMs !== null &&
+            delivery.retainUntilMs <= nowMs,
+        )
+        .sort((left, right) =>
+          left.retainUntilMs === right.retainUntilMs ?
+            left.deliveryId.localeCompare(right.deliveryId)
+          : (left.retainUntilMs ?? 0) - (right.retainUntilMs ?? 0),
+        )
+        .slice(0, limit),
+    );
+  }
+
+  listExpiredUploadStaging(
+    nowMs: number,
+    limit: number,
+  ): Promise<FhirBundleUploadStaging[]> {
+    return Promise.resolve(
+      Array.from(this.uploadStaging.values())
+        .filter(
+          (staging) =>
+            (staging.state === "staging" ||
+              staging.state === "garbage-collecting") &&
+            staging.expiresAtMs <= nowMs,
+        )
+        .sort((left, right) =>
+          left.expiresAtMs === right.expiresAtMs ?
+            left.stagingId.localeCompare(right.stagingId)
+          : left.expiresAtMs - right.expiresAtMs,
+        )
+        .slice(0, limit),
+    );
+  }
+
+  transactDelivery<Result>(
+    sourceKey: string,
+    deliveryId: string,
+    transition: (current: FhirBundleDelivery) => {
+      result: Result;
+      nextDelivery: FhirBundleDelivery;
+    },
+  ): Promise<Result> {
+    const path = this.deliveryPath(sourceKey, deliveryId);
+    const current = this.deliveries.get(path);
+    if (current === undefined) {
+      throw new FhirExchangeError(
+        "missing-delivery",
+        `Delivery ${deliveryId} does not exist.`,
+      );
+    }
+    const transaction = transition(current);
+    this.deliveries.set(path, transaction.nextDelivery);
+    return Promise.resolve(transaction.result);
+  }
+
+  beginDeliveryGarbageCollection(
+    sourceKey: string,
+    deliveryId: string,
+    leaseId: string,
+    nowMs: number,
+    leaseExpiresAtMs: number,
+    currentHeadRecheckAtMs: number,
+  ): Promise<
+    | { status: "claimed"; objects: StoredFhirObjectReference[] }
+    | { status: "deferred-current" }
+    | { status: "skipped" }
+  > {
+    const path = this.deliveryPath(sourceKey, deliveryId);
+    const delivery = this.deliveries.get(path);
+    if (delivery === undefined) {
+      return Promise.resolve({ status: "skipped" });
+    }
+    if (
+      delivery.retainUntilMs === null ||
+      delivery.retainUntilMs > nowMs ||
+      (delivery.state !== "delivered" &&
+        delivery.state !== "dead-letter" &&
+        delivery.state !== "garbage-collecting")
+    ) {
+      return Promise.resolve({ status: "skipped" });
+    }
+    const source = this.sources.get(sourceKey);
+    if (source?.generationId === delivery.generationId) {
+      if (delivery.state === "garbage-collecting") {
+        throw new FhirExchangeError(
+          "corrupt-delivery",
+          "The current source generation was already claimed for garbage collection.",
+        );
+      }
+      this.deliveries.set(path, {
+        ...delivery,
+        retainUntilMs: currentHeadRecheckAtMs,
+        garbageCollectionLeaseId: null,
+        garbageCollectionLeaseExpiresAtMs: null,
+        updatedAtMs: nowMs,
+      });
+      return Promise.resolve({ status: "deferred-current" });
+    }
+    if (
+      delivery.state === "garbage-collecting" &&
+      delivery.garbageCollectionLeaseId !== leaseId &&
+      (delivery.garbageCollectionLeaseExpiresAtMs ?? 0) > nowMs
+    ) {
+      this.deliveries.set(path, {
+        ...delivery,
+        retainUntilMs: delivery.garbageCollectionLeaseExpiresAtMs,
+      });
+      return Promise.resolve({ status: "skipped" });
+    }
+    this.deliveries.set(path, {
+      ...delivery,
+      state: "garbage-collecting",
+      garbageCollectionPreviousState:
+        delivery.state === "garbage-collecting" ?
+          delivery.garbageCollectionPreviousState
+        : delivery.state,
+      garbageCollectionLeaseId: leaseId,
+      garbageCollectionLeaseExpiresAtMs: leaseExpiresAtMs,
+      updatedAtMs: nowMs,
+    });
+    return Promise.resolve({
+      status: "claimed",
+      objects: [delivery.bundleObject, delivery.manifestObject],
+    });
+  }
+
+  deleteObject(reference: StoredFhirObjectReference): Promise<void> {
+    const stored = this.objects.get(reference.path);
+    if (stored === undefined) {
+      return Promise.resolve();
+    }
+    if (canonicalJson(stored.reference) !== canonicalJson(reference)) {
+      throw new FhirExchangeError(
+        "immutable-object-conflict",
+        `Object ${reference.path} exists at a different generation.`,
+      );
+    }
+    this.objects.delete(reference.path);
+    return Promise.resolve();
+  }
+
+  completeDeliveryGarbageCollection(
+    sourceKey: string,
+    deliveryId: string,
+    leaseId: string,
+  ): Promise<boolean> {
+    const path = this.deliveryPath(sourceKey, deliveryId);
+    const delivery = this.deliveries.get(path);
+    if (
+      delivery?.state !== "garbage-collecting" ||
+      delivery.garbageCollectionLeaseId !== leaseId
+    ) {
+      return Promise.resolve(false);
+    }
+    this.deliveries.delete(path);
+    return Promise.resolve(true);
+  }
+
+  recordDeliveryGarbageCollectionFailure(
+    sourceKey: string,
+    deliveryId: string,
+    leaseId: string,
+    nowMs: number,
+    maximumAttempts: number,
+    retryAtMs: number,
+    errorCode: string,
+  ): Promise<"retry" | "quarantined" | "skipped"> {
+    const path = this.deliveryPath(sourceKey, deliveryId);
+    const delivery = this.deliveries.get(path);
+    if (
+      delivery?.state !== "garbage-collecting" ||
+      delivery.garbageCollectionLeaseId !== leaseId
+    ) {
+      return Promise.resolve("skipped");
+    }
+    const attempts = delivery.garbageCollectionAttempts + 1;
+    const quarantined = attempts >= maximumAttempts;
+    this.deliveries.set(path, {
+      ...delivery,
+      state:
+        quarantined ?
+          "garbage-collection-failed"
+        : (delivery.garbageCollectionPreviousState ?? "dead-letter"),
+      retainUntilMs: quarantined ? null : retryAtMs,
+      garbageCollectionLeaseId: null,
+      garbageCollectionLeaseExpiresAtMs: null,
+      garbageCollectionPreviousState:
+        quarantined ? delivery.garbageCollectionPreviousState : null,
+      garbageCollectionAttempts: attempts,
+      garbageCollectionLastErrorCode: errorCode,
+      updatedAtMs: nowMs,
+    });
+    return Promise.resolve(quarantined ? "quarantined" : "retry");
+  }
+
+  beginUploadStagingGarbageCollection(
+    stagingId: string,
+    leaseId: string,
+    nowMs: number,
+    leaseExpiresAtMs: number,
+  ): Promise<
+    | { status: "claimed"; objects: StagedFhirObjectCandidate[] }
+    | { status: "deferred-current" }
+    | { status: "skipped" }
+  > {
+    const staging = this.uploadStaging.get(stagingId);
+    if (staging === undefined || staging.expiresAtMs > nowMs) {
+      return Promise.resolve({ status: "skipped" });
+    }
+    if (
+      this.sources.get(staging.sourceKey)?.generationId === staging.generationId
+    ) {
+      this.uploadStaging.delete(stagingId);
+      return Promise.resolve({ status: "deferred-current" });
+    }
+    if (
+      staging.state === "garbage-collecting" &&
+      staging.garbageCollectionLeaseId !== leaseId &&
+      (staging.garbageCollectionLeaseExpiresAtMs ?? 0) > nowMs
+    ) {
+      this.uploadStaging.set(stagingId, {
+        ...staging,
+        expiresAtMs: staging.garbageCollectionLeaseExpiresAtMs ?? nowMs,
+      });
+      return Promise.resolve({ status: "skipped" });
+    }
+    this.uploadStaging.set(stagingId, {
+      ...staging,
+      state: "garbage-collecting",
+      garbageCollectionLeaseId: leaseId,
+      garbageCollectionLeaseExpiresAtMs: leaseExpiresAtMs,
+      updatedAtMs: nowMs,
+    });
+    return Promise.resolve({
+      status: "claimed",
+      objects: [staging.bundleCandidate, staging.manifestCandidate],
+    });
+  }
+
+  deleteObjectCandidate(candidate: StagedFhirObjectCandidate): Promise<void> {
+    const stored = this.objects.get(candidate.path);
+    if (stored === undefined) {
+      return Promise.resolve();
+    }
+    if (!stagingCandidateMatchesReference(candidate, stored.reference)) {
+      throw new FhirExchangeError(
+        "immutable-object-conflict",
+        `Object ${candidate.path} does not match its registered upload candidate.`,
+      );
+    }
+    this.objects.delete(candidate.path);
+    return Promise.resolve();
+  }
+
+  completeUploadStagingGarbageCollection(
+    stagingId: string,
+    leaseId: string,
+  ): Promise<boolean> {
+    const staging = this.uploadStaging.get(stagingId);
+    if (
+      staging?.state !== "garbage-collecting" ||
+      staging.garbageCollectionLeaseId !== leaseId
+    ) {
+      return Promise.resolve(false);
+    }
+    this.uploadStaging.delete(stagingId);
+    return Promise.resolve(true);
+  }
+
+  recordUploadStagingGarbageCollectionFailure(
+    stagingId: string,
+    leaseId: string,
+    nowMs: number,
+    maximumAttempts: number,
+    retryAtMs: number,
+    errorCode: string,
+  ): Promise<"retry" | "quarantined" | "skipped"> {
+    const staging = this.uploadStaging.get(stagingId);
+    if (
+      staging?.state !== "garbage-collecting" ||
+      staging.garbageCollectionLeaseId !== leaseId
+    ) {
+      return Promise.resolve("skipped");
+    }
+    const attempts = staging.garbageCollectionAttempts + 1;
+    const quarantined = attempts >= maximumAttempts;
+    this.uploadStaging.set(stagingId, {
+      ...staging,
+      state: quarantined ? "garbage-collection-failed" : "staging",
+      expiresAtMs: quarantined ? Number.MAX_SAFE_INTEGER : retryAtMs,
+      garbageCollectionLeaseId: null,
+      garbageCollectionLeaseExpiresAtMs: null,
+      garbageCollectionAttempts: attempts,
+      garbageCollectionLastErrorCode: errorCode,
+      updatedAtMs: nowMs,
+    });
+    return Promise.resolve(quarantined ? "quarantined" : "retry");
+  }
+
+  listRetirableIdentifierClaims(
+    _nowMs: number,
+    _limit: number,
+  ): Promise<string[]> {
+    return Promise.resolve([]);
+  }
+
+  retireIdentifierClaim(
+    _identifierKey: string,
+    _nowMs: number,
+    _currentOwnerRecheckAtMs: number,
+  ): Promise<
+    "deleted" | "deferred-current" | "deferred-reservation" | "skipped"
+  > {
+    return Promise.resolve("skipped");
+  }
+
+  listExpiredIdentifierClaimPages(
+    _nowMs: number,
+    _limit: number,
+  ): Promise<string[]> {
+    return Promise.resolve([]);
+  }
+
+  deleteExpiredIdentifierClaimPage(
+    _pageId: string,
+    _nowMs: number,
+  ): Promise<boolean> {
+    return Promise.resolve(false);
+  }
+
+  private deliveryPath(sourceKey: string, deliveryId: string): string {
+    return `${sourceKey}/${deliveryId}`;
+  }
+}
