+  const matches = currentObservations.map((observation, observationIndex) => {
+    const matchingNext = new Set<number>();
+    for (const key of observation.identifierKeys) {
+      const currentOwners = currentOwnersByToken.get(key);
+      const nextOwners = nextOwnersByToken.get(key);
+      if (
+        currentOwners?.length === 1 &&
+        currentOwners[0] === observationIndex &&
+        nextOwners?.length === 1
+      ) {
+        matchingNext.add(nextOwners[0]);
+      }
+    }
+    if (matchingNext.size > 1) {
+      throw new FhirExchangeError(
+        "ambiguous-observation-replacement",
+        `A prior Observation matches ${matchingNext.size} replacement Observations.`,
+      );
+    }
+    return matchingNext.size === 1 ? Array.from(matchingNext)[0] : undefined;
+  });
