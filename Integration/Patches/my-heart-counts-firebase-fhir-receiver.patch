+      throw new FhirExchangeError(
+        "corrupt-fhir-object",
+        `Immutable object ${reference.path} failed its digest or size check.`,
+      );
+    }
+    return exactJson;
+  }
+
+  async stageUpload(request: StageFhirBundleUploadRequest): Promise<boolean> {
+    const sourceReference = this.firestore
+      .collection(SOURCE_COLLECTION)
+      .doc(request.staging.sourceKey);
+    const stagingReference = this.firestore
+      .collection(UPLOAD_STAGING_COLLECTION)
+      .doc(request.staging.stagingId);
+    return this.firestore.runTransaction(async (transaction) => {
+      const [sourceSnapshot, stagingSnapshot] = await transaction.getAll(
+        sourceReference,
+        stagingReference,
+      );
+      const currentGeneration =
+        sourceSnapshot.exists ?
+          (sourceSnapshot.data() as StoredFhirSourceState).generationId
+        : null;
+      if (currentGeneration !== request.expectedGenerationId) {
+        return false;
+      }
+      const existing =
+        stagingSnapshot.exists ?
+          (stagingSnapshot.data() as FhirBundleUploadStaging)
+        : undefined;
+      if (
+        existing !== undefined &&
+        canonicalValue(uploadStagingIdentity(existing)) !==
+          canonicalValue(uploadStagingIdentity(request.staging))
+      ) {
+        throw new FhirExchangeError(
+          "upload-staging-collision",
+          `Upload staging ${request.staging.stagingId} represents different content.`,
+        );
+      }
+      if (existing?.state === "garbage-collecting") {
+        throw new FhirExchangeError(
+          "upload-staging-expired",
+          `Upload staging ${request.staging.stagingId} is being collected; retry after it is removed.`,
+        );
+      }
+      transaction.set(stagingReference, {
+        ...request.staging,
+        createdAtMs: existing?.createdAtMs ?? request.staging.createdAtMs,
+        expiresAtMs: Math.max(
+          existing?.expiresAtMs ?? 0,
+          request.staging.expiresAtMs,
+        ),
+      });
+      return true;
+    });
+  }
+
+  async putStagedObject(
+    staging: FhirBundleUploadStaging,
+    candidate: StagedFhirObjectCandidate,
+    exactJson: string,
+  ): Promise<StoredFhirObjectReference> {
+    if (
+      candidate.sha256 !== sha256(exactJson) ||
+      candidate.utf8Bytes !== Buffer.byteLength(exactJson, "utf8") ||
+      !stagingContainsCandidate(staging, candidate)
+    ) {
+      throw new FhirExchangeError(
+        "invalid-upload-candidate",
+        `Object ${candidate.path} does not match its registered bytes or staging record.`,
+      );
+    }
+    if (!(await this.isCandidateRegisteredOrCommitted(staging, candidate))) {
+      throw new FhirExchangeError(
+        "missing-upload-staging",
+        `Object ${candidate.path} is not registered for upload.`,
+      );
+    }
+    const reference = await this.putObject(candidate.path, exactJson);
+    if (!(await this.isCandidateRegisteredOrCommitted(staging, candidate))) {
+      await this.deleteObject(reference);
+      throw new FhirExchangeError(
+        "upload-staging-expired",
+        `Upload staging ${staging.stagingId} expired before object confirmation.`,
+      );
+    }
+    return reference;
+  }
+
+  private async isCandidateRegisteredOrCommitted(
+    staging: FhirBundleUploadStaging,
+    candidate: StagedFhirObjectCandidate,
+  ): Promise<boolean> {
+    const [stagingSnapshot, sourceSnapshot] = await this.firestore.getAll(
+      this.firestore
+        .collection(UPLOAD_STAGING_COLLECTION)
+        .doc(staging.stagingId),
+      this.firestore.collection(SOURCE_COLLECTION).doc(staging.sourceKey),
+    );
+    if (stagingSnapshot.exists) {
+      const currentStaging = stagingSnapshot.data() as FhirBundleUploadStaging;
+      if (
+        currentStaging.state === "staging" &&
+        canonicalValue(uploadStagingIdentity(currentStaging)) ===
+          canonicalValue(uploadStagingIdentity(staging)) &&
+        stagingContainsCandidate(currentStaging, candidate)
+      ) {
+        return true;
+      }
+    }
+    if (!sourceSnapshot.exists) {
+      return false;
+    }
+    const source = sourceSnapshot.data() as StoredFhirSourceState;
+    return (
+      source.generationId === staging.generationId &&
+      (candidateMatchesReference(candidate, source.bundleObject) ||
+        candidateMatchesReference(candidate, source.manifestObject))
+    );
+  }
+
+  async commitSource(request: CommitFhirSourceRequest): Promise<boolean> {
+    const pages = this.claimPages(request);
+    try {
+      for (const page of pages) {
+        await this.stageClaimPage(request, page);
+      }
+    } catch (error) {
+      if (error instanceof StaleSourceGenerationError) {
+        return false;
+      }
+      throw error;
+    }
+
+    const sourceReference = this.firestore
+      .collection(SOURCE_COLLECTION)
+      .doc(request.nextSource.sourceKey);
+    const pageReferences = pages.map((page) =>
+      this.firestore.collection(CLAIM_PAGE_COLLECTION).doc(page.receipt.pageId),
+    );
+    const deliveryReference = sourceReference
+      .collection(DELIVERY_COLLECTION)
+      .doc(request.newDelivery.deliveryId);
+    const stagingReference = this.firestore
+      .collection(UPLOAD_STAGING_COLLECTION)
+      .doc(request.stagingId);
+    return this.firestore.runTransaction(async (transaction) => {
+      const snapshots = await transaction.getAll(
+        sourceReference,
+        stagingReference,
+        ...pageReferences,
+      );
+      const sourceSnapshot = snapshots[0];
+      const currentGeneration =
+        sourceSnapshot.exists ?
+          (sourceSnapshot.data() as StoredFhirSourceState).generationId
+        : null;
+      if (currentGeneration !== request.expectedGenerationId) {
+        return false;
+      }
+      const stagingSnapshot = snapshots[1];
+      if (!stagingSnapshot.exists) {
+        throw new FhirExchangeError(
+          "missing-upload-staging",
+          `Upload staging ${request.stagingId} is absent.`,
+        );
+      }
+      const staging = stagingSnapshot.data() as FhirBundleUploadStaging;
+      const stagingSchemaVersion: unknown = staging.schemaVersion;
+      if (
+        staging.state !== "staging" ||
+        stagingSchemaVersion !== FHIR_EXCHANGE_SCHEMA_VERSION ||
+        staging.stagingId !== request.newDelivery.deliveryId ||
+        staging.sourceKey !== request.nextSource.sourceKey ||
+        staging.generationId !== request.nextSource.generationId ||
+        canonicalValue(staging.partitionIdentifier) !==
+          canonicalValue(request.nextSource.partitionIdentifier) ||
+        canonicalValue(staging.sourceIdentifier) !==
+          canonicalValue(request.nextSource.sourceIdentifier) ||
+        staging.sourceVersion !== request.nextSource.sourceVersion ||
+        staging.eventSequence !== request.nextSource.eventSequence ||
+        staging.operation !== request.nextSource.operation ||
+        staging.payloadDigest !== request.nextSource.payloadDigest ||
+        !candidateMatchesReference(
+          staging.bundleCandidate,
+          request.newDelivery.bundleObject,
+        ) ||
+        !candidateMatchesReference(
+          staging.manifestCandidate,
+          request.newDelivery.manifestObject,
+        )
+      ) {
+        throw new FhirExchangeError(
+          "missing-upload-staging",
+          `Upload staging ${request.stagingId} is inconsistent.`,
+        );
+      }
+      pages.forEach((page, index) => {
+        const snapshot = snapshots[index + 2];
+        if (
+          !snapshot.exists ||
+          canonicalValue(snapshot.data()) !== canonicalValue(page.receipt)
+        ) {
+          throw new FhirExchangeError(
+            "incomplete-identifier-reservation",
+            `Identifier claim page ${page.receipt.pageId} is absent or inconsistent.`,
+          );
+        }
+      });
+      transaction.set(sourceReference, request.nextSource);
+      transaction.create(deliveryReference, request.newDelivery);
+      transaction.delete(stagingReference);
+      pageReferences.forEach((reference) => {
+        transaction.delete(reference);
+      });
+      return true;
+    });
+  }
+
+  private claimPages(request: CommitFhirSourceRequest): ClaimPageInput[] {
+    const pages: ClaimPageInput[] = [];
+    for (
+      let offset = 0;
+      offset < request.identifierClaims.length;
+      offset += CLAIM_PAGE_SIZE
+    ) {
+      const page = request.identifierClaims.slice(
+        offset,
+        offset + CLAIM_PAGE_SIZE,
+      );
+      const claimDigest = sha256(
+        canonicalValue(
+          page.map((claim) => ({
+            identifierKey: claim.identifierKey,
+            identifier: claim.identifier,
+            partitionIdentifier: claim.partitionIdentifier,
+            sourceKey: claim.sourceKey,
+            generationId: claim.generationId,
+            sourceVersion: claim.sourceVersion,
+            eventSequence: claim.eventSequence,
+            entryIndexes: claim.entryIndexes,
+          })),
+        ),
+      );
+      const pageIndex = offset / CLAIM_PAGE_SIZE;
+      const pageId = `claim-page-v2-${sha256(
+        canonicalValue([
+          request.nextSource.sourceKey,
+          request.nextSource.generationId,
+          pageIndex,
+          claimDigest,
+        ]),
+      )}`;
+      pages.push({
+        page,
+        receipt: {
+          schemaVersion: FHIR_EXCHANGE_SCHEMA_VERSION,
+          pageId,
+          sourceKey: request.nextSource.sourceKey,
+          generationId: request.nextSource.generationId,
+          claimDigest,
+          claimCount: page.length,
+          expiresAtMs: request.reservationExpiresAtMs,
+          createdAtMs: request.nextSource.updatedAtMs,
+        },
+      });
+    }
+    return pages;
+  }
+
+  private pendingClaimWasSuperseded(
+    pending: PendingIdentifierClaim,
+    owner: StoredFhirSourceState | undefined,
+  ): boolean {
+    return (
+      owner !== undefined &&
+      compareEventSequences(owner.eventSequence, pending.eventSequence) > 0
+    );
+  }
+
+  private async stageClaimPage(
+    request: CommitFhirSourceRequest,
+    page: ClaimPageInput,
+  ): Promise<void> {
+    const sourceReference = this.firestore
+      .collection(SOURCE_COLLECTION)
+      .doc(request.nextSource.sourceKey);
+    const tokenReferences = page.page.map((claim) =>
+      this.firestore.collection(IDENTIFIER_COLLECTION).doc(claim.identifierKey),
+    );
+    const pageReference = this.firestore
+      .collection(CLAIM_PAGE_COLLECTION)
+      .doc(page.receipt.pageId);
+    const nowMs = this.now();
+    if (!Number.isSafeInteger(nowMs) || nowMs < 0) {
+      throw new FhirExchangeError(
+        "invalid-store-clock",
+        "Firestore identifier reservation time must be non-negative epoch milliseconds.",
+      );
+    }
+
+    await this.firestore.runTransaction(async (transaction) => {
+      const initialSnapshots = await transaction.getAll(
+        sourceReference,
+        ...tokenReferences,
+      );
+      const sourceSnapshot = initialSnapshots[0];
+      const currentGeneration =
+        sourceSnapshot.exists ?
+          (sourceSnapshot.data() as StoredFhirSourceState).generationId
+        : null;
+      if (currentGeneration !== request.expectedGenerationId) {
+        throw new StaleSourceGenerationError();
+      }
+      const tokenSnapshots = initialSnapshots.slice(1);
+      const existingClaims = tokenSnapshots.map((snapshot) =>
+        snapshot.exists ?
+          (snapshot.data() as IdentifierClaimDocument)
+        : undefined,
+      );
+      const ownerSourceKeys = new Set<string>();
+      existingClaims.forEach((claim) => {
+        if (claim?.active !== null && claim?.active !== undefined) {
+          ownerSourceKeys.add(claim.active.sourceKey);
+        }
+        if (claim?.pending !== undefined && claim.pending !== null) {
+          ownerSourceKeys.add(claim.pending.sourceKey);
+        }
+      });
+      ownerSourceKeys.delete(request.nextSource.sourceKey);
+      const ownerReferences = Array.from(ownerSourceKeys).map((sourceKey) =>
+        this.firestore.collection(SOURCE_COLLECTION).doc(sourceKey),
+      );
+      const ownerSnapshots =
+        ownerReferences.length === 0 ?
+          []
+        : await transaction.getAll(...ownerReferences);
+      const sourceStateByKey = new Map<string, StoredFhirSourceState>();
+      if (sourceSnapshot.exists) {
+        sourceStateByKey.set(
+          request.nextSource.sourceKey,
+          sourceSnapshot.data() as StoredFhirSourceState,
+        );
+      }
+      ownerSnapshots.forEach((snapshot) => {
+        if (snapshot.exists) {
+          sourceStateByKey.set(
+            snapshot.id,
+            snapshot.data() as StoredFhirSourceState,
+          );
+        }
+      });
+
+      const previousPageReferences = new Map<string, DocumentReference>();
+      page.page.forEach((claim, index) => {
+        const existing = existingClaims[index];
+        const existingSchemaVersion: unknown = existing?.schemaVersion;
+        if (
+          existing !== undefined &&
+          (existingSchemaVersion !== FHIR_EXCHANGE_SCHEMA_VERSION ||
+            existing.identifierKey !== claim.identifierKey ||
+            canonicalValue(existing.identifier) !==
+              canonicalValue(claim.identifier) ||
+            canonicalValue(existing.partitionIdentifier) !==
+              canonicalValue(claim.partitionIdentifier))
+        ) {
+          throw new FhirExchangeError(
+            "identifier-key-collision",
+            `Identifier key ${claim.identifierKey} resolves to a different partition or complete token.`,
+          );
+        }
+        const committedSlots = [existing?.active, existing?.pending].filter(
+          (slot): slot is ActiveIdentifierClaim =>
+            slot !== null &&
+            slot !== undefined &&
+            sourceStateByKey.get(slot.sourceKey)?.generationId ===
+              slot.generationId,
+        );
+        const distinctCommitted = new Set(
+          committedSlots.map(
+            (slot) => `${slot.sourceKey}\u0000${slot.generationId}`,
+          ),
+        );
+        if (distinctCommitted.size > 1) {
+          throw new FhirExchangeError(
+            "corrupt-observation-index",
+            `Identifier ${claim.identifierKey} has multiple committed owners.`,
+          );
+        }
+        const effectiveActive =
+          committedSlots.length === 0 ? undefined : committedSlots[0];
+        if (
+          effectiveActive !== undefined &&
+          effectiveActive.sourceKey !== request.nextSource.sourceKey
+        ) {
+          throw new FhirExchangeError(
+            "observation-identifier-conflict",
+            "An Observation identifier is active for another source record.",
+          );
+        }
+        if (
+          existing?.pending !== undefined &&
+          existing.pending !== null &&
+          existing.pending.generationId !== request.nextSource.generationId &&
+          sourceStateByKey.get(existing.pending.sourceKey)?.generationId !==
+            existing.pending.generationId &&
+          !this.pendingClaimWasSuperseded(
+            existing.pending,
+            sourceStateByKey.get(existing.pending.sourceKey),
+          ) &&
+          existing.pending.reservationExpiresAtMs > nowMs
+        ) {
+          throw new FhirExchangeError(
+            "observation-identifier-reserved",
+            "An Observation identifier is reserved by another in-progress source event.",
+          );
+        }
+        if (
+          existing?.pending !== undefined &&
+          existing.pending !== null &&
+          existing.pending.pageId !== page.receipt.pageId
+        ) {
+          previousPageReferences.set(
+            existing.pending.pageId,
+            this.firestore
+              .collection(CLAIM_PAGE_COLLECTION)
+              .doc(existing.pending.pageId),
+          );
+        }
+        const nextClaim: IdentifierClaimDocument = {
+          schemaVersion: FHIR_EXCHANGE_SCHEMA_VERSION,
+          identifierKey: claim.identifierKey,
+          identifier: claim.identifier,
+          partitionIdentifier: claim.partitionIdentifier,
+          active:
+            effectiveActive === undefined ? null : (
+              {
+                sourceKey: effectiveActive.sourceKey,
+                generationId: effectiveActive.generationId,
+                sourceVersion: effectiveActive.sourceVersion,
+                eventSequence: effectiveActive.eventSequence,
+                entryIndexes: effectiveActive.entryIndexes,
+              }
+            ),
+          pending: {
+            sourceKey: request.nextSource.sourceKey,
+            generationId: request.nextSource.generationId,
+            sourceVersion: claim.sourceVersion,
+            eventSequence: claim.eventSequence,
+            entryIndexes: claim.entryIndexes,
+            pageId: page.receipt.pageId,
+            reservationExpiresAtMs: request.reservationExpiresAtMs,
+          },
+          retirementState: "eligible",
+          retireAfterMs: request.reservationExpiresAtMs,
+          retirementAttempts: 0,
+          retirementLastErrorCode: null,
+          updatedAtMs: nowMs,
+        };
+        transaction.set(tokenReferences[index], nextClaim);
+      });
+      previousPageReferences.forEach((reference) => {
+        transaction.delete(reference);
+      });
+      transaction.set(pageReference, page.receipt);
+    });
+  }
