+  path: string,
+): asserts identifier is CompleteFhirIdentifier {
+  if (!isJsonObject(identifier)) {
+    throw new FhirExchangeError(
+      "invalid-identifier",
+      `${path} must be an object with system and value.`,
+    );
+  }
+  assertNonEmptyString(identifier.system, `${path}.system`);
+  assertNonEmptyString(identifier.value, `${path}.value`);
+  assertWellFormedUnicode(identifier.system, `${path}.system`);
+  assertWellFormedUnicode(identifier.value, `${path}.value`);
+  if (
+    !/^[A-Za-z][A-Za-z0-9+.-]*:\S+$/.test(identifier.system) ||
+    Buffer.byteLength(identifier.system, "utf8") >
+      MAX_IDENTIFIER_SYSTEM_BYTES ||
+    Buffer.byteLength(identifier.value, "utf8") > MAX_IDENTIFIER_VALUE_BYTES
