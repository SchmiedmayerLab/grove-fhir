+  async recordDeliveryGarbageCollectionFailure(
+    sourceKey: string,
+    deliveryId: string,
+    leaseId: string,
+    nowMs: number,
+    maximumAttempts: number,
+    retryAtMs: number,
+    failureCode: string,
+  ): Promise<"retry" | "quarantined" | "skipped"> {
+    const deliveryReference = this.firestore
+      .collection(SOURCE_COLLECTION)
+      .doc(sourceKey)
+      .collection(DELIVERY_COLLECTION)
+      .doc(deliveryId);
+    return this.firestore.runTransaction(async (transaction) => {
+      const snapshot = await transaction.get(deliveryReference);
+      if (!snapshot.exists) {
+        return "skipped" as const;
+      }
+      const delivery = snapshot.data() as FhirBundleDelivery;
+      if (
+        delivery.state !== "garbage-collecting" ||
+        delivery.garbageCollectionLeaseId !== leaseId
+      ) {
+        return "skipped" as const;
+      }
+      const attempts = delivery.garbageCollectionAttempts + 1;
+      const quarantined = attempts >= maximumAttempts;
+      transaction.set(deliveryReference, {
+        ...delivery,
+        state:
+          quarantined ?
+            "garbage-collection-failed"
+          : (delivery.garbageCollectionPreviousState ?? "dead-letter"),
+        retainUntilMs: quarantined ? null : retryAtMs,
+        garbageCollectionLeaseId: null,
+        garbageCollectionLeaseExpiresAtMs: null,
+        garbageCollectionPreviousState:
+          quarantined ? delivery.garbageCollectionPreviousState : null,
+        garbageCollectionAttempts: attempts,
+        garbageCollectionLastErrorCode: failureCode,
+        updatedAtMs: nowMs,
+      } satisfies FhirBundleDelivery);
+      return quarantined ? "quarantined" : "retry";
+    });
+  }
+
+  async beginUploadStagingGarbageCollection(
+    stagingId: string,
+    leaseId: string,
+    nowMs: number,
+    leaseExpiresAtMs: number,
+  ): Promise<
+    | { status: "claimed"; objects: StagedFhirObjectCandidate[] }
+    | { status: "deferred-current" }
+    | { status: "skipped" }
+  > {
+    const stagingReference = this.firestore
+      .collection(UPLOAD_STAGING_COLLECTION)
+      .doc(stagingId);
+    return this.firestore.runTransaction(async (transaction) => {
+      const initialSnapshot = await transaction.get(stagingReference);
+      if (!initialSnapshot.exists) {
+        return { status: "skipped" as const };
+      }
+      const staging = initialSnapshot.data() as FhirBundleUploadStaging;
+      const sourceReference = this.firestore
+        .collection(SOURCE_COLLECTION)
+        .doc(staging.sourceKey);
+      const sourceSnapshot = await transaction.get(sourceReference);
+      const currentSource =
+        sourceSnapshot.exists ?
+          (sourceSnapshot.data() as StoredFhirSourceState)
+        : undefined;
+      if (staging.expiresAtMs > nowMs) {
+        return { status: "skipped" as const };
+      }
+      if (currentSource?.generationId === staging.generationId) {
+        transaction.delete(stagingReference);
+        return { status: "deferred-current" as const };
+      }
+      if (
+        staging.state === "garbage-collecting" &&
+        staging.garbageCollectionLeaseId !== leaseId &&
+        (staging.garbageCollectionLeaseExpiresAtMs ?? 0) > nowMs
+      ) {
+        transaction.set(stagingReference, {
+          ...staging,
+          expiresAtMs:
+            staging.garbageCollectionLeaseExpiresAtMs ?? leaseExpiresAtMs,
+        });
+        return { status: "skipped" as const };
+      }
+      transaction.set(stagingReference, {
+        ...staging,
+        state: "garbage-collecting",
+        garbageCollectionLeaseId: leaseId,
+        garbageCollectionLeaseExpiresAtMs: leaseExpiresAtMs,
+        updatedAtMs: nowMs,
+      });
+      return {
+        status: "claimed" as const,
+        objects: [staging.bundleCandidate, staging.manifestCandidate],
+      };
+    });
+  }
+
+  async deleteObjectCandidate(
+    candidate: StagedFhirObjectCandidate,
+  ): Promise<void> {
+    const file = this.bucket.file(candidate.path);
+    let metadata: { generation?: string | number };
+    try {
+      [metadata] = await file.getMetadata();
+    } catch (error) {
+      if ([404, "404"].includes(errorCode(error) ?? "")) {
+        return;
+      }
+      throw error;
+    }
+    if (
+      typeof metadata.generation !== "string" &&
+      typeof metadata.generation !== "number"
+    ) {
+      throw new FhirExchangeError(
+        "missing-object-generation",
+        `Object ${candidate.path} has no immutable generation.`,
+      );
+    }
+    const pinnedFile = this.bucket.file(candidate.path, {
+      generation: String(metadata.generation),
+    });
+    const [bytes] = await pinnedFile.download({ validation: "crc32c" });
+    if (
+      bytes.byteLength !== candidate.utf8Bytes ||
+      sha256(bytes.toString("utf8")) !== candidate.sha256
+    ) {
+      throw new FhirExchangeError(
+        "immutable-object-conflict",
+        `Object ${candidate.path} does not match its registered upload candidate.`,
+      );
+    }
+    await pinnedFile.delete({ ignoreNotFound: true });
+  }
