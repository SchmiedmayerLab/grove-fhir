+const SOURCE_COLLECTION = "fhirExchangeSources";
+const DELIVERY_COLLECTION = "fhirBundleDeliveries";
+const IDENTIFIER_COLLECTION = "fhirObservationIdentifiers";
+const CLAIM_PAGE_COLLECTION = "fhirIdentifierClaimPages";
+const UPLOAD_STAGING_COLLECTION = "fhirBundleUploadStaging";
+const CLAIM_PAGE_SIZE = 200;
+
+type FirebaseStorageBucket = ReturnType<
+  ReturnType<typeof getStorage>["bucket"]
+>;
+
+interface ActiveIdentifierClaim {
+  sourceKey: string;
+  generationId: string;
+  sourceVersion: string;
+  eventSequence: string;
+  entryIndexes: number[];
+}
+
+interface PendingIdentifierClaim extends ActiveIdentifierClaim {
+  pageId: string;
+  reservationExpiresAtMs: number;
+}
+
+interface IdentifierClaimDocument {
+  schemaVersion: typeof FHIR_EXCHANGE_SCHEMA_VERSION;
+  identifierKey: string;
+  identifier: CompleteFhirIdentifier;
+  partitionIdentifier: CompleteFhirIdentifier;
+  active: ActiveIdentifierClaim | null;
+  pending: PendingIdentifierClaim | null;
+  retirementState: "eligible" | "quarantined";
+  retireAfterMs: number;
+  retirementAttempts: number;
+  retirementLastErrorCode: string | null;
+  updatedAtMs: number;
+}
+
+interface IdentifierClaimPage {
+  schemaVersion: typeof FHIR_EXCHANGE_SCHEMA_VERSION;
+  pageId: string;
+  sourceKey: string;
+  generationId: string;
+  claimDigest: string;
+  claimCount: number;
+  expiresAtMs: number;
+  createdAtMs: number;
+}
+
+interface ClaimPageInput {
+  page: StoredFhirObservationIdentifier[];
+  receipt: IdentifierClaimPage;
+}
+
+const isActiveIdentifierClaim = (
+  value: unknown,
+): value is ActiveIdentifierClaim => {
+  if (typeof value !== "object" || value === null) {
+    return false;
+  }
+  const candidate = value as Partial<ActiveIdentifierClaim>;
+  return (
+    typeof candidate.sourceKey === "string" &&
+    typeof candidate.generationId === "string" &&
+    typeof candidate.sourceVersion === "string" &&
+    typeof candidate.eventSequence === "string" &&
+    Array.isArray(candidate.entryIndexes) &&
+    candidate.entryIndexes.every(
+      (entryIndex) => Number.isSafeInteger(entryIndex) && entryIndex >= 0,
+    )
+  );
+};
+
+const isPendingIdentifierClaim = (
+  value: unknown,
+): value is PendingIdentifierClaim => {
+  if (!isActiveIdentifierClaim(value)) {
+    return false;
+  }
+  const candidate = value as Partial<PendingIdentifierClaim>;
+  return (
+    typeof candidate.pageId === "string" &&
+    Number.isSafeInteger(candidate.reservationExpiresAtMs) &&
+    (candidate.reservationExpiresAtMs ?? -1) >= 0
+  );
+};
+
+class StaleSourceGenerationError extends Error {
+  constructor() {
+    super("The source generation changed while staging identifier claims.");
+    this.name = "StaleSourceGenerationError";
+    Object.setPrototypeOf(this, StaleSourceGenerationError.prototype);
+  }
+}
+
+const canonicalValue = (value: unknown): string => {
+  if (Array.isArray(value)) {
+    return `[${value.map(canonicalValue).join(",")}]`;
+  }
+  if (value !== null && typeof value === "object") {
+    const object = value as Record<string, unknown>;
+    return `{${Object.keys(object)
+      .sort()
+      .map((key) => `${JSON.stringify(key)}:${canonicalValue(object[key])}`)
+      .join(",")}}`;
+  }
+  return JSON.stringify(value);
+};
+
+const sha256 = (value: string): string => {
+  return createHash("sha256").update(value, "utf8").digest("hex");
+};
+
+const uploadStagingIdentity = (staging: FhirBundleUploadStaging): unknown => ({
+  schemaVersion: staging.schemaVersion,
+  stagingId: staging.stagingId,
+  sourceKey: staging.sourceKey,
+  generationId: staging.generationId,
+  partitionIdentifier: staging.partitionIdentifier,
+  sourceIdentifier: staging.sourceIdentifier,
+  sourceVersion: staging.sourceVersion,
+  eventSequence: staging.eventSequence,
+  operation: staging.operation,
+  payloadDigest: staging.payloadDigest,
+  bundleCandidate: staging.bundleCandidate,
+  manifestCandidate: staging.manifestCandidate,
+});
+
+const candidateMatchesReference = (
+  candidate: StagedFhirObjectCandidate,
+  reference: StoredFhirObjectReference,
+): boolean =>
+  candidate.path === reference.path &&
+  candidate.sha256 === reference.sha256 &&
+  candidate.utf8Bytes === reference.utf8Bytes;
+
+const stagingContainsCandidate = (
+  staging: FhirBundleUploadStaging,
+  candidate: StagedFhirObjectCandidate,
+): boolean =>
+  canonicalValue(staging.bundleCandidate) === canonicalValue(candidate) ||
+  canonicalValue(staging.manifestCandidate) === canonicalValue(candidate);
+
+const errorCode = (error: unknown): string | number | undefined => {
+  if (typeof error === "object" && error !== null && "code" in error) {
+    const code = error.code;
+    return typeof code === "string" || typeof code === "number" ?
+        code
+      : undefined;
+  }
+  return undefined;
+};
+
+/**
+ * Persists the receiver's current-source pointer and durable outbox atomically.
+ * Delivery documents are retained after success or retry exhaustion so no
+ * accepted source revision silently disappears.
+ */
+export class FirestoreFhirBundleStore implements FhirBundleStore {
+  constructor(
+    private readonly firestore: Firestore,
+    private readonly bucket: FirebaseStorageBucket,
+    private readonly now: () => number = Date.now,
+  ) {}
+
+  async putObject(
+    path: string,
+    exactJson: string,
+  ): Promise<StoredFhirObjectReference> {
+    const digest = sha256(exactJson);
+    const utf8Bytes = Buffer.byteLength(exactJson, "utf8");
+    const file = this.bucket.file(path);
+    let objectAlreadyExisted = false;
+    try {
+      await file.save(Buffer.from(exactJson, "utf8"), {
+        resumable: false,
+        validation: "crc32c",
+        preconditionOpts: { ifGenerationMatch: 0 },
+        metadata: {
+          contentType: "application/json; charset=utf-8",
+          cacheControl: "private, no-store",
+          metadata: { sha256: digest },
+        },
+      });
+    } catch (error) {
+      if (![409, 412, "409", "412"].includes(errorCode(error) ?? "")) {
+        throw error;
+      }
+      objectAlreadyExisted = true;
+    }
+    const [metadata] = await file.getMetadata();
+    if (typeof metadata.generation !== "string") {
+      throw new FhirExchangeError(
+        "missing-object-generation",
+        `Object ${path} has no immutable generation.`,
+      );
+    }
+    if (objectAlreadyExisted) {
