+export function completeIdentifierKey(
+  identifier: CompleteFhirIdentifier,
+  namespace = "fhir-identifier-v2",
+): string {
+  assertCompleteIdentifier(identifier, "identifier");
+  return `${namespace}-${sha256(canonicalJson([identifier.system, identifier.value]))}`;
