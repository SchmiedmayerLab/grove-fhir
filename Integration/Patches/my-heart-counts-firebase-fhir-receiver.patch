+
+export function partitionedCompleteIdentifierKey(
+  partitionIdentifier: CompleteFhirIdentifier,
+  identifier: CompleteFhirIdentifier,
+  namespace = "fhir-observation-identifier-v2",
+): string {
+  assertCompleteIdentifier(partitionIdentifier, "partitionIdentifier");
+  assertCompleteIdentifier(identifier, "identifier");
+  return `${namespace}-${sha256(
+    canonicalJson([
+      [partitionIdentifier.system, partitionIdentifier.value],
+      [identifier.system, identifier.value],
+    ]),
+  )}`;
