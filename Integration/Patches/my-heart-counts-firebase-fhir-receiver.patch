+// This source file belongs to the My Heart Counts Firebase project
+//
+// SPDX-FileCopyrightText: 2026 Stanford University and the project authors (see CONTRIBUTORS.md)
+// SPDX-License-Identifier: MIT
+
+import { getFirestore } from "firebase-admin/firestore";
+import { getStorage } from "firebase-admin/storage";
+import { logger } from "firebase-functions/v2";
+import { onSchedule } from "firebase-functions/v2/scheduler";
+import { privilegedServiceAccount } from "./helpers.js";
+import {
+  FhirBundleRetentionWorker,
+  drainFhirBundleRetention,
+} from "../services/fhirExchange/fhirBundleReceiver.js";
+import { FirestoreFhirBundleStore } from "../services/fhirExchange/firestoreFhirBundleStore.js";
+
+export const processFhirBundleRetentionScheduled = onSchedule(
+  {
+    schedule: "every 15 minutes",
+    timeZone: "UTC",
+    timeoutSeconds: 540,
+    serviceAccount: privilegedServiceAccount,
+  },
+  async () => {
+    const projectId = process.env.GCLOUD_PROJECT;
+    if (projectId === undefined || projectId.length === 0) {
+      throw new Error("GCLOUD_PROJECT is required for FHIR Bundle retention.");
+    }
+    const store = new FirestoreFhirBundleStore(
+      getFirestore(),
+      getStorage().bucket(`${projectId}.appspot.com`),
+    );
+    const result = await drainFhirBundleRetention(
+      new FhirBundleRetentionWorker(store),
+    );
+    logger.info("Processed expired FHIR Bundle delivery history.", result);
+  },
+);
