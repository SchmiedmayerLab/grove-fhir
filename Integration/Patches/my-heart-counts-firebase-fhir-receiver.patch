+      path,
+      generation: metadata.generation,
+      sha256: digest,
+      utf8Bytes,
+    };
+  }
+
+  async readObject(reference: StoredFhirObjectReference): Promise<string> {
+    const file = this.bucket.file(reference.path, {
+      generation: reference.generation,
+    });
+    const [bytes] = await file.download({ validation: "crc32c" });
+    const exactJson = bytes.toString("utf8");
+    if (
+      bytes.byteLength !== reference.utf8Bytes ||
+      sha256(exactJson) !== reference.sha256
