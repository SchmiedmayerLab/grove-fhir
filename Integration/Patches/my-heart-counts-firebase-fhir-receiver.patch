+  const scanValue = (path: string, depth: number): void => {
+    if (depth > MAX_JSON_DEPTH) {
+      throw new FhirExchangeError(
+        "invalid-json",
+        `FHIR JSON exceeds the maximum nesting depth at ${path}.`,
+      );
+    }
+    skipWhitespace();
+    if (exactJson[cursor] === '"') {
+      scanString();
+      return;
+    }
+    if (exactJson[cursor] === "[") {
+      cursor += 1;
+      skipWhitespace();
+      let index = 0;
+      while (exactJson[cursor] !== "]") {
+        scanValue(`${path}[${index}]`, depth + 1);
+        skipWhitespace();
+        if (exactJson[cursor] === ",") {
+          cursor += 1;
+          index += 1;
+          continue;
+        }
+        break;
+      }
+      cursor += 1;
+      return;
+    }
