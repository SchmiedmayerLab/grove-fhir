+    .map((key) => {
+      assertWellFormedUnicode(key, `${path} property name`);
+      return `${JSON.stringify(key)}:${canonicalJson(
+        object[key],
+        `${path}.${key}`,
+        depth + 1,
+      )}`;
+    })
+    .join(",")}}`;
