+  const scanString = (): string => {
+    const start = cursor;
+    cursor += 1;
+    let escaped = false;
+    while (cursor < exactJson.length) {
+      const character = exactJson[cursor];
+      cursor += 1;
+      if (escaped) {
+        escaped = false;
+      } else if (character === "\\") {
+        escaped = true;
+      } else if (character === '"') {
+        return JSON.parse(exactJson.slice(start, cursor)) as string;
+      }
+    }
+    throw new FhirExchangeError(
+      "invalid-json",
+      "bundleJson contains an unterminated JSON string.",
+    );
+  };
