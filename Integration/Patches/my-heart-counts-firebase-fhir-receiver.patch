+  sourceIdentifier: source.sourceIdentifier,
+  sourceVersion: source.sourceVersion,
+  eventSequence: source.eventSequence,
+  operation: source.operation,
+  payloadDigest: source.payloadDigest,
+  generationId: source.generationId,
+  bundleObject: source.bundleObject,
+  manifestObject: source.manifestObject,
+  state: "pending",
+  attempts: 0,
+  redriveCount: 0,
+  leaseId: null,
+  nextAttemptAtMs: 100,
+  lastErrorCode: null,
+  retentionDurationMs: 1_000,
+  retainUntilMs: null,
+  garbageCollectionLeaseId: null,
+  garbageCollectionLeaseExpiresAtMs: null,
+  garbageCollectionPreviousState: null,
+  garbageCollectionAttempts: 0,
+  garbageCollectionLastErrorCode: null,
+  createdAtMs: 100,
+  updatedAtMs: 100,
+});
