+    "operation",
+    "sourceIdentifier",
+    "sourceVersion",
+    "eventSequence",
+    "bundleJson",
+  ]);
+  const unsupportedFields = Object.keys(value).filter(
+    (field) => !expectedFields.has(field),
+  );
+  if (unsupportedFields.length > 0) {
+    throw new FhirExchangeError(
+      "invalid-submission",
+      `The FHIR exchange submission contains unsupported fields: ${unsupportedFields
+        .sort()
+        .join(", ")}.`,
+    );
+  }
+  assertCompleteIdentifier(value.sourceIdentifier, "sourceIdentifier");
+  const unsupportedIdentifierFields = Object.keys(
+    value.sourceIdentifier,
+  ).filter((field) => field !== "system" && field !== "value");
