+function parseObservationIdentifiers(
+  resource: JsonObject,
+  entryIndex: number,
+): CompleteFhirIdentifier[] {
+  const path = `Bundle.entry[${entryIndex}].resource.identifier`;
+  if (!Array.isArray(resource.identifier) || resource.identifier.length === 0) {
+    throw new FhirExchangeError(
+      "missing-observation-identifier",
+      `${path} must contain at least one complete identifier.`,
+    );
+  }
