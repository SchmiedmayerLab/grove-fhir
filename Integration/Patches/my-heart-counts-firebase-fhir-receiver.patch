+  payloadDigest: generationId.padEnd(64, "0").slice(0, 64),
+  bundleObject: objectReference(`bundle-${generationId}`),
+  manifestObject: objectReference(`manifest-${generationId}`),
+  activeObservationCount: operation === "upsert" ? 1 : 0,
