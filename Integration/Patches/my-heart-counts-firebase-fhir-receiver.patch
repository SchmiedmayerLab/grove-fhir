+  async transactDelivery<Result>(
+    sourceKey: string,
+    deliveryId: string,
+    transition: (current: FhirBundleDelivery) => {
+      result: Result;
+      nextDelivery: FhirBundleDelivery;
+    },
+  ): Promise<Result> {
+    const deliveryReference = this.firestore
+      .collection(SOURCE_COLLECTION)
+      .doc(sourceKey)
+      .collection(DELIVERY_COLLECTION)
+      .doc(deliveryId);
+
+    return this.firestore.runTransaction(async (transaction) => {
+      const snapshot = await transaction.get(deliveryReference);
+      if (!snapshot.exists) {
+        throw new FhirExchangeError(
+          "missing-delivery",
+          `Delivery ${deliveryId} does not exist.`,
+        );
+      }
+      const current = snapshot.data() as FhirBundleDelivery;
+      const change = transition(current);
+      transaction.set(deliveryReference, change.nextDelivery);
+      return change.result;
+    });
+  }
+
+  async beginDeliveryGarbageCollection(
+    sourceKey: string,
+    deliveryId: string,
+    leaseId: string,
+    nowMs: number,
+    leaseExpiresAtMs: number,
+    currentHeadRecheckAtMs: number,
+  ): Promise<
+    | { status: "claimed"; objects: StoredFhirObjectReference[] }
+    | { status: "deferred-current" }
+    | { status: "skipped" }
+  > {
+    const sourceReference = this.firestore
+      .collection(SOURCE_COLLECTION)
+      .doc(sourceKey);
+    const deliveryReference = sourceReference
+      .collection(DELIVERY_COLLECTION)
+      .doc(deliveryId);
+    return this.firestore.runTransaction(async (transaction) => {
+      const [sourceSnapshot, deliverySnapshot] = await transaction.getAll(
+        sourceReference,
+        deliveryReference,
+      );
+      if (!deliverySnapshot.exists) {
+        return { status: "skipped" as const };
+      }
+      const delivery = deliverySnapshot.data() as FhirBundleDelivery;
+      if (
+        delivery.retainUntilMs === null ||
+        delivery.retainUntilMs > nowMs ||
+        (delivery.state !== "delivered" &&
+          delivery.state !== "dead-letter" &&
+          delivery.state !== "garbage-collecting")
+      ) {
+        return { status: "skipped" as const };
+      }
+      const source =
+        sourceSnapshot.exists ?
+          (sourceSnapshot.data() as StoredFhirSourceState)
+        : undefined;
+      if (source?.generationId === delivery.generationId) {
+        transaction.set(deliveryReference, {
+          ...delivery,
+          state:
+            delivery.state === "garbage-collecting" ?
+              (delivery.garbageCollectionPreviousState ?? "dead-letter")
+            : delivery.state,
+          retainUntilMs: currentHeadRecheckAtMs,
+          garbageCollectionLeaseId: null,
+          garbageCollectionLeaseExpiresAtMs: null,
+          garbageCollectionPreviousState: null,
+          updatedAtMs: nowMs,
+        });
+        return { status: "deferred-current" as const };
+      }
+      if (
+        delivery.state === "garbage-collecting" &&
+        delivery.garbageCollectionLeaseId !== leaseId &&
+        (delivery.garbageCollectionLeaseExpiresAtMs ?? 0) > nowMs
+      ) {
+        transaction.set(deliveryReference, {
+          ...delivery,
+          retainUntilMs:
+            delivery.garbageCollectionLeaseExpiresAtMs ?? leaseExpiresAtMs,
+        });
+        return { status: "skipped" as const };
+      }
+      transaction.set(deliveryReference, {
+        ...delivery,
+        state: "garbage-collecting",
+        garbageCollectionPreviousState:
+          delivery.state === "garbage-collecting" ?
+            delivery.garbageCollectionPreviousState
+          : delivery.state,
+        garbageCollectionLeaseId: leaseId,
+        garbageCollectionLeaseExpiresAtMs: leaseExpiresAtMs,
+        updatedAtMs: nowMs,
+      });
+      return {
+        status: "claimed" as const,
+        objects: [delivery.bundleObject, delivery.manifestObject],
+      };
+    });
+  }
