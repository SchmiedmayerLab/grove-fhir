+  const observations = manifest.activeObservations.map((index) => {
+    if (
+      !Number.isSafeInteger(index.entryIndex) ||
+      index.entryIndex < 0 ||
+      seenEntryIndexes.has(index.entryIndex) ||
+      index.identifiers.length === 0 ||
+      index.identifiers.length !== index.identifierKeys.length
+    ) {
+      throw new FhirExchangeError(
+        "corrupt-source-manifest",
+        "The stored source manifest contains an invalid Observation index.",
+      );
+    }
+    seenEntryIndexes.add(index.entryIndex);
+    const identifiers = index.identifiers.map((identifier, identifierIndex) => {
+      assertCompleteIdentifier(
+        identifier,
+        `manifest.activeObservations[${index.entryIndex}].identifiers[${identifierIndex}]`,
+      );
+      return copyCompleteIdentifier(identifier);
+    });
