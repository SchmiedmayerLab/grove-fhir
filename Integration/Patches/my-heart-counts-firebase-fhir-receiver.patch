@@ -0,0 +1,885 @@
+// This source file belongs to the My Heart Counts Firebase project
+//
+// SPDX-FileCopyrightText: 2026 Stanford University and the project authors (see CONTRIBUTORS.md)
+// SPDX-License-Identifier: MIT
+
+import { expect } from "chai";
+import { type Firestore } from "firebase-admin/firestore";
+import { type getStorage } from "firebase-admin/storage";
+import { describe, it } from "mocha";
+import {
+  FHIR_EXCHANGE_SCHEMA_VERSION,
+  FhirExchangeError,
+  type CommitFhirSourceRequest,
+  type CompleteFhirIdentifier,
+  type FhirBundleDelivery,
+  type FhirBundleUploadStaging,
+  type StoredFhirObjectReference,
+  type StoredFhirObservationIdentifier,
+  type StoredFhirSourceState,
+} from "./fhirBundleReceiver.js";
+import { FirestoreFhirBundleStore } from "./firestoreFhirBundleStore.js";
+
+type FirebaseStorageBucket = ReturnType<
+  ReturnType<typeof getStorage>["bucket"]
+>;
+
+interface FakeSnapshot {
+  exists: boolean;
+  id: string;
+  data: () => Record<string, unknown> | undefined;
+}
+
+interface FakeStoredObject {
+  bytes: Buffer;
+  generation: string;
+}
+
+interface FakeSaveOptions {
+  resumable?: boolean;
+  validation?: string;
+  preconditionOpts?: { ifGenerationMatch?: number };
+  metadata?: {
+    contentType?: string;
+    cacheControl?: string;
+    metadata?: { sha256?: string };
+  };
+}
+
+interface FakeDeleteOptions {
+  ignoreNotFound?: boolean;
+}
+
+class FakeStorageFile {
+  constructor(
+    private readonly bucket: FakeBucket,
+    private readonly path: string,
+    private readonly requestedGeneration?: string,
+  ) {}
+
+  save(bytes: Buffer, options: FakeSaveOptions): Promise<void> {
+    if (
+      options.preconditionOpts?.ifGenerationMatch === 0 &&
+      this.bucket.objects.has(this.path)
+    ) {
+      return Promise.reject(
+        Object.assign(new Error("The immutable object already exists."), {
+          code: 412,
+        }),
+      );
+    }
+    const generation = this.bucket.nextGeneration.toString();
+    this.bucket.nextGeneration += 1;
+    this.bucket.objects.set(this.path, {
+      bytes: Buffer.from(bytes),
+      generation,
+    });
+    this.bucket.lastSaveOptions = structuredClone(options);
+    return Promise.resolve();
+  }
+
+  download(): Promise<[Buffer]> {
+    const object = this.bucket.objects.get(this.path);
+    if (
+      object === undefined ||
+      (this.requestedGeneration !== undefined &&
+        object.generation !== this.requestedGeneration)
+    ) {
+      return Promise.reject(new Error("The object generation is unavailable."));
+    }
+    return Promise.resolve([Buffer.from(object.bytes)]);
+  }
+
+  getMetadata(): Promise<[{ generation: string }]> {
+    const object = this.bucket.objects.get(this.path);
+    if (object === undefined) {
+      return Promise.reject(new Error("The object is unavailable."));
+    }
+    return Promise.resolve([{ generation: object.generation }]);
+  }
+
+  delete(options: FakeDeleteOptions = {}): Promise<[unknown]> {
+    const object = this.bucket.objects.get(this.path);
+    if (object === undefined) {
+      if (options.ignoreNotFound === true) {
+        return Promise.resolve([{}]);
+      }
+      return Promise.reject(new Error("The object is unavailable."));
+    }
+    if (
+      this.requestedGeneration !== undefined &&
+      object.generation !== this.requestedGeneration
+    ) {
+      return Promise.reject(new Error("The object generation is unavailable."));
+    }
+    this.bucket.objects.delete(this.path);
+    return Promise.resolve([{}]);
+  }
+}
+
+class FakeBucket {
+  readonly objects = new Map<string, FakeStoredObject>();
+  nextGeneration = 1;
+  lastSaveOptions: FakeSaveOptions | undefined;
+
+  file(path: string, options?: { generation?: string }): FakeStorageFile {
+    return new FakeStorageFile(this, path, options?.generation);
+  }
+}
+
+class FakeDocumentReference {
+  constructor(
+    readonly firestore: FakeFirestore,
+    readonly path: string,
+  ) {}
+
+  get id(): string {
+    return this.path.split("/").at(-1) ?? "";
+  }
+
+  collection(name: string): FakeCollectionReference {
+    return new FakeCollectionReference(this.firestore, `${this.path}/${name}`);
+  }
+
+  get(): Promise<FakeSnapshot> {
+    return Promise.resolve(this.firestore.snapshot(this));
+  }
+}
+
+class FakeCollectionReference {
+  constructor(
+    private readonly firestore: FakeFirestore,
+    private readonly path: string,
+  ) {}
+
+  doc(id: string): FakeDocumentReference {
+    return new FakeDocumentReference(this.firestore, `${this.path}/${id}`);
+  }
+}
+
+type FakeWrite =
+  | { operation: "set"; reference: FakeDocumentReference; value: unknown }
+  | { operation: "create"; reference: FakeDocumentReference; value: unknown }
+  | { operation: "delete"; reference: FakeDocumentReference };
+
+class FakeTransaction {
+  readonly writes: FakeWrite[] = [];
+
+  constructor(private readonly firestore: FakeFirestore) {}
+
+  getAll(...references: FakeDocumentReference[]): Promise<FakeSnapshot[]> {
+    return Promise.resolve(
+      references.map((reference) => this.firestore.snapshot(reference)),
+    );
+  }
+
+  get(reference: FakeDocumentReference): Promise<FakeSnapshot> {
+    return Promise.resolve(this.firestore.snapshot(reference));
+  }
+
+  set(reference: FakeDocumentReference, value: unknown): void {
+    this.writes.push({ operation: "set", reference, value });
+  }
+
+  create(reference: FakeDocumentReference, value: unknown): void {
+    this.writes.push({ operation: "create", reference, value });
+  }
+
+  delete(reference: FakeDocumentReference): void {
+    this.writes.push({ operation: "delete", reference });
+  }
+}
+
+class FakeFirestore {
+  readonly documents = new Map<string, unknown>();
+  readonly committedWriteCounts: number[] = [];
+  afterNextTransactionCommit: (() => Promise<void>) | undefined;
+
+  collection(name: string): FakeCollectionReference {
+    return new FakeCollectionReference(this, name);
+  }
+
+  async runTransaction<Result>(
+    update: (transaction: FakeTransaction) => Promise<Result>,
+  ): Promise<Result> {
+    const transaction = new FakeTransaction(this);
+    const result = await update(transaction);
+    for (const write of transaction.writes) {
+      if (
+        write.operation === "create" &&
+        this.documents.has(write.reference.path)
+      ) {
+        throw new Error(`Document ${write.reference.path} already exists.`);
+      }
+      if (write.operation === "delete") {
+        this.documents.delete(write.reference.path);
+      } else {
+        this.documents.set(write.reference.path, structuredClone(write.value));
+      }
+    }
+    this.committedWriteCounts.push(transaction.writes.length);
+    const afterCommit = this.afterNextTransactionCommit;
+    this.afterNextTransactionCommit = undefined;
+    if (afterCommit !== undefined) {
+      await afterCommit();
+    }
+    return result;
+  }
+
+  snapshot(reference: FakeDocumentReference): FakeSnapshot {
+    const value = this.documents.get(reference.path);
+    return {
+      exists: value !== undefined,
+      id: reference.id,
+      data: () =>
+        value === undefined ? undefined : (
+          (structuredClone(value) as Record<string, unknown>)
+        ),
+    };
+  }
+}
