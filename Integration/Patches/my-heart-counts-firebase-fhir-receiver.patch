+      entryIndex: index.entryIndex,
+      resource: { resourceType: "Observation", status: "final" },
+      identifiers,
+      identifierKeys: identifiers.map((identifier) =>
+        completeIdentifierKey(identifier),
+      ),
+    };
+  });
