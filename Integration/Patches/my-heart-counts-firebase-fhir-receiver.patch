+function matchedNextObservationIndexes(
+  currentObservations: ParsedObservation[],
+  nextObservations: ParsedObservation[],
+): Array<number | undefined> {
+  const currentOwnersByToken = ownersByToken(currentObservations);
+  const nextOwnersByToken = ownersByToken(nextObservations);
