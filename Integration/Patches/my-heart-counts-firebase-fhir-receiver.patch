+  private assertRetentionQuery(nowMs: number, limit: number): void {
+    if (!Number.isSafeInteger(nowMs) || nowMs < 0) {
+      throw new FhirExchangeError(
+        "invalid-worker-clock",
+        "Retention query time must be non-negative epoch milliseconds.",
+      );
+    }
+    if (!Number.isSafeInteger(limit) || limit < 1 || limit > 500) {
