+  const identifiers = resource.identifier.map((value, identifierIndex) => {
+    if (!isJsonObject(value)) {
+      throw new FhirExchangeError(
+        "invalid-observation-identifier",
+        `${path}[${identifierIndex}] must be an object.`,
+      );
+    }
+    const identifier = {
+      system: value.system,
+      value: value.value,
+    } as CompleteFhirIdentifier;
+    assertCompleteIdentifier(identifier, `${path}[${identifierIndex}]`);
+    return identifier;
+  });
