+          throw new FhirExchangeError(
+            "duplicate-json-property",
+            `FHIR JSON repeats property ${JSON.stringify(key)} at ${path}.`,
+          );
+        }
+        keys.add(key);
+        skipWhitespace();
+        cursor += 1;
+        scanValue(`${path}.${key}`, depth + 1);
+        skipWhitespace();
+        if (exactJson[cursor] === ",") {
+          cursor += 1;
+          skipWhitespace();
+          continue;
+        }
+        break;
+      }
+      cursor += 1;
+      return;
+    }
+    while (
+      cursor < exactJson.length &&
+      exactJson[cursor] !== "," &&
+      exactJson[cursor] !== "]" &&
+      exactJson[cursor] !== "}" &&
+      exactJson[cursor] !== " " &&
+      exactJson[cursor] !== "\n" &&
+      exactJson[cursor] !== "\r" &&
+      exactJson[cursor] !== "\t"
+    ) {
+      cursor += 1;
+    }
+  };
