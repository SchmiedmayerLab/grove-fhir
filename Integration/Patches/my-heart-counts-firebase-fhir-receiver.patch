+    throw new FhirExchangeError(
+      "invalid-event-sequence",
+      "eventSequence must be a canonical decimal string.",
+    );
+  }
+  if (value.operation === "upsert") {
+    if (typeof value.bundleJson !== "string") {
+      throw new FhirExchangeError(
+        "invalid-json",
+        "An upsert must provide bundleJson as an exact JSON string.",
+      );
+    }
+    return {
+      operation: "upsert",
+      sourceIdentifier,
+      sourceVersion: value.sourceVersion,
+      eventSequence: value.eventSequence,
+      bundleJson: value.bundleJson,
+    };
+  }
+  if (value.operation === "delete") {
+    if (typeof value.bundleJson !== "string") {
+      throw new FhirExchangeError(
+        "invalid-json",
+        "A deletion must provide its exact entered-in-error Bundle JSON.",
+      );
+    }
