+    while (
+      exactJson[cursor] === " " ||
+      exactJson[cursor] === "\n" ||
+      exactJson[cursor] === "\r" ||
+      exactJson[cursor] === "\t"
+    ) {
+      cursor += 1;
+    }
+  };
