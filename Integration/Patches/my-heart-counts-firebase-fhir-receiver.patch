+  const matches = matchedNextObservationIndexes(
+    currentObservations,
+    submittedObservations,
+  );
+  const currentIndexBySubmitted = new Map<number, number>();
+  matches.forEach((submittedIndex, currentIndex) => {
+    if (submittedIndex !== undefined) {
+      currentIndexBySubmitted.set(submittedIndex, currentIndex);
+    }
+  });
