+function compareCanonicalDecimal(
+  left: string,
+  right: string,
+  errorCode: string,
+  label: string,
+): number {
+  if (
+    left.length > MAX_SOURCE_VERSION_DIGITS ||
+    right.length > MAX_SOURCE_VERSION_DIGITS ||
+    !VERSION_PATTERN.test(left) ||
+    !VERSION_PATTERN.test(right)
+  ) {
+    throw new FhirExchangeError(
+      errorCode,
+      `${label} must be canonical non-negative decimal strings.`,
+    );
+  }
+  if (left.length !== right.length) {
+    return left.length < right.length ? -1 : 1;
+  }
+  if (left === right) {
+    return 0;
+  }
+  return left < right ? -1 : 1;
+}
+
+export function compareSourceVersions(left: string, right: string): number {
+  return compareCanonicalDecimal(
+    left,
+    right,
+    "invalid-source-version",
+    "Source versions",
+  );
+}
+
+export function compareEventSequences(left: string, right: string): number {
+  if (left === "0" || right === "0") {
+    throw new FhirExchangeError(
+      "invalid-event-sequence",
+      "Event sequences must be positive canonical decimal strings.",
+    );
+  }
+  return compareCanonicalDecimal(
+    left,
+    right,
+    "invalid-event-sequence",
+    "Event sequences",
+  );
