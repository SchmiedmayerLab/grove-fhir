+const claims = (
+  source: StoredFhirSourceState,
+  count: number,
+): StoredFhirObservationIdentifier[] =>
+  Array.from({ length: count }, (_, index) => ({
+    schemaVersion: FHIR_EXCHANGE_SCHEMA_VERSION,
+    identifierKey: `identifier-${index.toString().padStart(4, "0")}`,
+    identifier: {
+      system: "https://example.org/fhir/NamingSystem/output",
