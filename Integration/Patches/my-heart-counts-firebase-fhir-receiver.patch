+  const matchedCurrentByNext = new Map<number, number>();
+  matches.forEach((nextIndex, currentIndex) => {
+    if (nextIndex === undefined) {
+      return;
+    }
+    const priorCurrentIndex = matchedCurrentByNext.get(nextIndex);
+    if (priorCurrentIndex !== undefined) {
+      throw new FhirExchangeError(
+        "ambiguous-observation-replacement",
+        `Replacement Observation ${nextIndex} merges prior Observations ${priorCurrentIndex} and ${currentIndex}.`,
