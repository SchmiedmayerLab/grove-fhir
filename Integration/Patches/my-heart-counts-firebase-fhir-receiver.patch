+// This source file belongs to the My Heart Counts Firebase project
+//
+// SPDX-FileCopyrightText: 2026 Stanford University and the project authors (see CONTRIBUTORS.md)
+// SPDX-License-Identifier: MIT
+
+import { randomUUID } from "node:crypto";
+import { expect } from "chai";
+import {
+  FhirBundleDeliveryWorker,
+  FhirBundleRetentionWorker,
+  FhirBundleReceiver,
+  FhirExchangeError,
+  drainFhirBundleRetention,
+  type CommitFhirSourceRequest,
+  type CompleteFhirIdentifier,
+  type FhirBundleUploadStaging,
+} from "./fhirBundleReceiver.js";
+import { FirestoreFhirBundleStore } from "./firestoreFhirBundleStore.js";
+import { describeWithEmulators } from "../../tests/functions/testEnvironment.js";
+
+const bundle = (
+  sourceIdentifier: CompleteFhirIdentifier,
+  outputValues: string[],
+): string =>
+  JSON.stringify({
+    resourceType: "Bundle",
+    type: "collection",
+    entry: [
+      {
+        fullUrl: "urn:uuid:00000000-0000-4000-8000-000000000001",
+        resource: {
+          resourceType: "Device",
+          meta: {
+            profile: [
+              "https://example.org/fhir/StructureDefinition/converter-device",
+            ],
+          },
+          extension: [
+            {
+              url: "https://example.org/fhir/StructureDefinition/source-note",
+              valueString: "preserve this companion resource exactly",
+            },
+          ],
+        },
+      },
+      ...outputValues.map((value, index) => ({
+        fullUrl: `urn:uuid:${index.toString().padStart(8, "0")}-0000-4000-8000-000000000002`,
+        resource: {
+          resourceType: "Observation",
+          identifier: [
+            sourceIdentifier,
+            {
+              system: "https://example.org/fhir/NamingSystem/output",
+              value,
+            },
+          ],
+          status: "final",
+          code: { text: "Emulator concurrency fixture" },
+        },
+      })),
+    ],
+  });
+
+const deletionBundle = (bundleJson: string): string => {
+  const parsed = JSON.parse(bundleJson) as {
+    entry: Array<{ resource: { resourceType: string; status?: string } }>;
+  };
+  parsed.entry = parsed.entry.map((entry) => ({
+    ...entry,
+    resource:
+      entry.resource.resourceType === "Observation" ?
+        { ...entry.resource, status: "entered-in-error" }
+      : entry.resource,
+  }));
+  return JSON.stringify(parsed);
+};
+
+describeWithEmulators("FHIR Bundle Firestore/Storage integration", (env) => {
+  it("atomically commits a paged source and rejects a concurrent token claim", async () => {
+    const testId = randomUUID();
+    const partitionIdentifier: CompleteFhirIdentifier = {
+      system: "https://example.org/fhir/NamingSystem/test-partition",
+      value: testId,
+    };
+    const firstSource: CompleteFhirIdentifier = {
+      system: "https://example.org/fhir/NamingSystem/test-source",
+      value: `first-${testId}`,
+    };
+    const secondSource: CompleteFhirIdentifier = {
+      system: firstSource.system,
+      value: `second-${testId}`,
+    };
+    const projectId =
+      process.env.GCLOUD_PROJECT ?? "myheart-counts-development";
+    const bucket = env.storage.bucket(`${projectId}.appspot.com`);
+    const store = new FirestoreFhirBundleStore(
+      env.firestore,
+      bucket,
+      () => 1_000,
+    );
+    const firstReceiver = new FhirBundleReceiver(
+      store,
+      partitionIdentifier,
+      24 * 60 * 60_000,
+      () => 1_000,
+    );
+    const secondReceiver = new FhirBundleReceiver(
+      store,
+      partitionIdentifier,
+      24 * 60 * 60_000,
+      () => 1_000,
+    );
+    const firstBundleJson = bundle(
+      firstSource,
+      Array.from({ length: 201 }, (_, index) => `shared-output-${index}`),
+    );
+    const secondBundleJson = bundle(secondSource, ["shared-output-0"]);
+
+    const results = await Promise.allSettled([
+      firstReceiver.receive({
+        operation: "upsert",
+        sourceIdentifier: firstSource,
+        sourceVersion: "1",
+        eventSequence: "1",
+        bundleJson: firstBundleJson,
+      }),
+      secondReceiver.receive({
+        operation: "upsert",
+        sourceIdentifier: secondSource,
+        sourceVersion: "1",
+        eventSequence: "1",
+        bundleJson: secondBundleJson,
+      }),
+    ]);
+    const accepted = results.filter(
+      (
+        result,
+      ): result is PromiseFulfilledResult<
+        Awaited<ReturnType<FhirBundleReceiver["receive"]>>
+      > => result.status === "fulfilled",
+    );
+    const rejected = results.filter(
+      (result): result is PromiseRejectedResult => result.status === "rejected",
+    );
+
+    expect(accepted).to.have.length(1);
+    expect(rejected).to.have.length(1);
+    expect(rejected[0].reason).to.be.instanceOf(FhirExchangeError);
+    expect((rejected[0].reason as FhirExchangeError).code).to.be.oneOf([
+      "observation-identifier-conflict",
+      "observation-identifier-reserved",
+    ]);
+
+    const acceptedResult = accepted[0].value;
+    expect(acceptedResult.status).to.equal("accepted");
+    const source = await store.getSource(acceptedResult.sourceKey);
+    expect(source).to.not.equal(undefined);
+    const exactBundleJson =
+      source === undefined ? undefined : (
+        await store.readObject(source.bundleObject)
+      );
+    expect(exactBundleJson).to.be.oneOf([firstBundleJson, secondBundleJson]);
+    if (exactBundleJson === firstBundleJson) {
+      expect(source?.activeObservationCount).to.equal(201);
+      expect(source?.activeIdentifierCount).to.equal(202);
+    } else {
+      expect(source?.activeObservationCount).to.equal(1);
+      expect(source?.activeIdentifierCount).to.equal(2);
+    }
+
+    if (source === undefined || acceptedResult.status !== "accepted") {
+      throw new Error("The accepted source head is unavailable.");
+    }
+    expect(
+      await new FhirBundleReceiver(
+        store,
+        partitionIdentifier,
+        24 * 60 * 60_000,
+        () => 1_001,
+      ).receive({
+        operation: "upsert",
+        sourceIdentifier: source.sourceIdentifier,
+        sourceVersion: source.sourceVersion,
+        eventSequence: "2",
+        bundleJson: exactBundleJson,
+      }),
+    ).to.include({ status: "accepted" });
+    const deliveryWorker = new FhirBundleDeliveryWorker(store, () =>
+      Promise.resolve(),
+    );
+    expect(await deliveryWorker.processDue(1_001)).to.include({ delivered: 2 });
+    const retentionWorker = new FhirBundleRetentionWorker(store, 100, 100);
+    expect(
+      await retentionWorker.processExpired(24 * 60 * 60_000 + 1_001),
+    ).to.include({
+      deleted: 2,
+      failed: 0,
+    });
+    const retainedSource = await store.getSource(acceptedResult.sourceKey);
+    expect(
+      retainedSource === undefined ? undefined : (
+        await store.readObject(retainedSource.bundleObject)
+      ),
+    ).to.equal(exactBundleJson);
+
+    class CrashBeforeCommitStore extends FirestoreFhirBundleStore {
+      override commitSource(
+        _request: CommitFhirSourceRequest,
+      ): Promise<boolean> {
+        return Promise.reject(new Error("simulated crash before source CAS"));
+      }
+    }
+    const crashedSource: CompleteFhirIdentifier = {
+      system: firstSource.system,
+      value: `crashed-${testId}`,
+    };
+    const crashedStore = new CrashBeforeCommitStore(
+      env.firestore,
+      bucket,
+      () => 2_000,
+    );
+    let crashFailure: unknown;
+    try {
+      await new FhirBundleReceiver(
+        crashedStore,
+        partitionIdentifier,
+        24 * 60 * 60_000,
+        () => 2_000,
+        10,
+      ).receive({
+        operation: "upsert",
+        sourceIdentifier: crashedSource,
+        sourceVersion: "1",
+        eventSequence: "1",
+        bundleJson: bundle(crashedSource, ["crash-output"]),
+      });
+    } catch (error) {
+      crashFailure = error;
+    }
+    expect(crashFailure).to.be.instanceOf(Error);
+    const stagingSnapshot = await env.firestore
+      .collection("fhirBundleUploadStaging")
+      .get();
+    const crashedStaging = stagingSnapshot.docs
+      .map((document) => document.data() as FhirBundleUploadStaging)
+      .find(
+        (staging) => staging.sourceIdentifier.value === crashedSource.value,
+      );
+    expect(crashedStaging).to.not.equal(undefined);
+    if (crashedStaging === undefined) {
+      throw new Error("The crashed upload staging record is unavailable.");
+    }
+    expect(
+      await bucket.file(crashedStaging.bundleCandidate.path).exists(),
+    ).to.deep.equal([true]);
+    expect(
+      await bucket.file(crashedStaging.manifestCandidate.path).exists(),
+    ).to.deep.equal([true]);
+    expect(
+      await new FhirBundleRetentionWorker(
+        crashedStore,
+        100,
+        100,
+      ).processExpired(2_010),
+    ).to.include({ deleted: 1, failed: 0 });
+    expect(
+      await bucket.file(crashedStaging.bundleCandidate.path).exists(),
+    ).to.deep.equal([false]);
+    expect(
+      await bucket.file(crashedStaging.manifestCandidate.path).exists(),
+    ).to.deep.equal([false]);
+  }).timeout(30_000);
+
+  it("retires a replaced high-cardinality identifier set safely under concurrent sweepers", async () => {
+    const testId = randomUUID();
+    const partitionIdentifier: CompleteFhirIdentifier = {
+      system: "https://example.org/fhir/NamingSystem/test-partition",
+      value: `retirement-${testId}`,
+    };
+    const sourceIdentifier: CompleteFhirIdentifier = {
+      system: "https://example.org/fhir/NamingSystem/test-source",
+      value: `large-${testId}`,
+    };
+    const projectId =
+      process.env.GCLOUD_PROJECT ?? "myheart-counts-development";
+    const storeAt = (nowMs: number): FirestoreFhirBundleStore =>
+      new FirestoreFhirBundleStore(
+        env.firestore,
+        env.storage.bucket(`${projectId}.appspot.com`),
+        () => nowMs,
+      );
+    const exactBundleJson = bundle(
+      sourceIdentifier,
+      Array.from({ length: 201 }, (_, index) => `retirement-output-${index}`),
+    );
+    const terminalRetentionMs = 24 * 60 * 60_000;
+    expect(
+      await new FhirBundleReceiver(
+        storeAt(1_000),
+        partitionIdentifier,
+        terminalRetentionMs,
+        () => 1_000,
+      ).receive({
+        operation: "upsert",
+        sourceIdentifier,
+        sourceVersion: "1000000001",
+        eventSequence: "1",
+        bundleJson: exactBundleJson,
+      }),
+    ).to.include({ status: "accepted" });
+    expect(
+      await new FhirBundleReceiver(
+        storeAt(1_001),
+        partitionIdentifier,
+        terminalRetentionMs,
+        () => 1_001,
+      ).receive({
+        operation: "upsert",
+        sourceIdentifier,
+        sourceVersion: "1000000001",
+        eventSequence: "2",
+        bundleJson: exactBundleJson,
+      }),
+    ).to.include({ status: "accepted" });
+    expect(
+      await new FhirBundleReceiver(
+        storeAt(1_002),
+        partitionIdentifier,
+        terminalRetentionMs,
+        () => 1_002,
+      ).receive({
+        operation: "delete",
+        sourceIdentifier,
+        sourceVersion: "1000000001",
+        eventSequence: "3",
+        bundleJson: deletionBundle(exactBundleJson),
+      }),
+    ).to.include({ status: "accepted", invalidatedObservationCount: 201 });
+
+    const claimsBefore = (
+      await env.firestore.collection("fhirObservationIdentifiers").get()
+    ).docs.filter(
+      (document) =>
+        (document.data() as { partitionIdentifier?: CompleteFhirIdentifier })
+          .partitionIdentifier?.value === partitionIdentifier.value,
+    );
+    expect(claimsBefore).to.have.length(202);
+    const cleanupAtMs = 31 * 60_000;
+    const workers = [
+      new FhirBundleRetentionWorker(storeAt(cleanupAtMs), 100, 100),
+      new FhirBundleRetentionWorker(storeAt(cleanupAtMs), 100, 100),
+    ];
+    await Promise.all(
+      workers.map((worker) =>
+        drainFhirBundleRetention(worker, () => cleanupAtMs, 50, 2_000, 10_000),
+      ),
+    );
+
+    const claimsAfter = (
+      await env.firestore.collection("fhirObservationIdentifiers").get()
+    ).docs.filter(
+      (document) =>
+        (document.data() as { partitionIdentifier?: CompleteFhirIdentifier })
+          .partitionIdentifier?.value === partitionIdentifier.value,
+    );
+    expect(claimsAfter).to.have.length(0);
+  }).timeout(30_000);
+});
