+    matches.some((index) => index === undefined) ||
+    matchedDeletionIndexes.size !== deletionObservations.length
+  ) {
+    throw new FhirExchangeError(
+      "incomplete-deletion-bundle",
+      "The deletion Bundle must cover every active Observation exactly once.",
+    );
+  }
+  matches.forEach((deletionIndex, currentIndex) => {
