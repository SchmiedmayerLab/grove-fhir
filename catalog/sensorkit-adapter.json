  "statusVocabulary": [
    "supported",
    "mapped-standard",
    "provider-specific",
    "deferred",
    "intentionally-unsupported"
  ],
  "statusDefinitions": {
    "supported": "Version 0.2.0 defines a lossless structured mapping to the listed source-neutral Sensor profile plus the SensorKit adapter profile. A row may require the listed linked native Recording Document when exact source fields cannot be carried in the structured projection alone.",
    "mapped-standard": "Version 0.2.0 admits the stream as the listed source-neutral Sensor Recording Document and does not invent a structured scalar or waveform meaning.",
    "provider-specific": "Version 0.2.0 defines the listed SensorKit-only structured profile because no exact source-neutral or international profile represents the source semantics.",
    "deferred": "The platform stream is inventoried, but version 0.2.0 publishes no admitted output contract.",
    "intentionally-unsupported": "Version 0.2.0 deliberately refuses the stream because any available representation would create a misleading or unsafe meaning."
  },
  "sourceEvidence": {
    "platform": "Apple SensorKit",
    "sdkBaseline": {
      "platform": "iPhoneOS",
      "version": "27.0",
      "xcodeVersion": "27.0",
      "xcodeBuild": "27A5237l"
    },
    "accessed": "2026-08-20",
    "appleSensorInventory": "https://developer.apple.com/documentation/sensorkit/srsensor",
    "appleFrameworkDocumentation": "https://developer.apple.com/documentation/sensorkit",
    "scope": "The exact 24 public Apple SRSensor symbols frozen by the v0.2.0 catalog, with stable and beta availability represented per row."
  },
  "inventoryScopes": {
    "catalog-baseline": "One of the 20 platform symbols in the initial closed v0.2.0 catalog baseline.",
    "stable-addition": "A stable platform symbol added to complete the stated SDK baseline.",
    "beta-addition": "A beta platform symbol present in the stated SDK baseline."
  },
  "profileClaims": {
    "sharedObservation": {
      "rule": "exactly two direct meta.profile claims: the listed source-neutral Sensor semantic profile and the SensorKit adapter profile",
      "adapterProfile": "https://grovealliance.org/fhir/sensorkit/StructureDefinition/sensorkit-observation"
    },
    "hybridObservation": {
      "rule": "exactly two direct meta.profile claims: the listed source-neutral Sensor semantic profile and the exact SensorKit hybrid adapter child; one linked exact native Recording Document is mandatory",
      "adapterProfile": "https://grovealliance.org/fhir/sensorkit/StructureDefinition/sensorkit-ecg-observation"
    },
    "recordingDocument": {
      "rule": "exactly two direct meta.profile claims: the source-neutral Sensor Recording Document profile and the SensorKit Recording Document adapter profile",
      "sourceNeutralProfile": "https://grovealliance.org/fhir/sensor/StructureDefinition/grove-sensor-recording-document",
      "adapterProfile": "https://grovealliance.org/fhir/sensorkit/StructureDefinition/sensorkit-recording-document",
      "defaultOutputDiscriminator": "native-recording",
      "defaultRule": "Every admitted raw representation uses this profile pair and output discriminator unless its row explicitly replaces them."
    },
    "providerSpecificObservation": {
      "rule": "exactly one direct meta.profile claim: the listed SensorKit-only profile, which inherits the adapter envelope"
    },
    "conversionProvenance": {
      "profile": "https://grovealliance.org/fhir/sensorkit/StructureDefinition/sensorkit-conversion-provenance",
      "rule": "The adapter-specific Provenance targets every structured and raw output from the source record and carries that exact source-record Identifier as its sole source entity."
    }
  },
  "rawPayloadAdmission": {
    "contract": "https://grovealliance.org/fhir/sensor#recording-document.payloadAdmission",
    "allowedAssertions": [
      "caller-authorized-opaque-payload",
      "verified-sanitized-input"
    ],
    "failureRule": "The producer fails closed before emission unless the caller supplies exactly one assertion.",
    "notFHIRAuthorization": true
  },
