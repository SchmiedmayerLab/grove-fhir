  "statusVocabulary": [
    "supported",
    "mapped-standard",
    "platform-exclusive",
    "unmodeled",
    "deferred",
    "intentionally-unsupported"
  ],
  "statusDefinitions": {
    "supported": "Version 0.5.0 defines a lossless structured mapping to the listed source-neutral Sensor profile plus the SensorKit adapter profile. A row may require the listed linked native Recording Document when exact source fields cannot be carried in the structured projection alone.",
    "mapped-standard": "Version 0.5.0 admits the stream as the listed source-neutral Sensor Recording Document and does not invent a structured scalar or waveform meaning.",
    "platform-exclusive": "Version 0.5.0 defines the listed platform-exclusive SensorKit structured profile because no exact source-neutral or international profile exists.",
    "unmodeled": "The platform stream is inventoried, but no shared or SensorKit-scoped profile models it and no output is admitted.",
    "deferred": "The platform stream is inventoried, but version 0.5.0 publishes no admitted output contract.",
    "intentionally-unsupported": "Version 0.5.0 deliberately refuses the stream because any available representation would create a misleading or unsafe meaning."
  },
  "sourceEvidence": {
    "platform": "Apple SensorKit",
    "sdkBaseline": {
      "platform": "iPhoneOS",
      "version": "26.5",
      "xcodeVersion": "26.6",
      "xcodeBuild": "17F113"
    },
    "accessed": "2026-08-20",
    "appleSensorInventory": "https://developer.apple.com/documentation/sensorkit/srsensor",
    "appleFrameworkDocumentation": "https://developer.apple.com/documentation/sensorkit",
    "scope": "The exact 22 public Apple SRSensor symbols frozen by the v0.3.0 catalog."
  },
  "inventoryScopes": {
    "catalog-baseline": "One of the 20 platform symbols in the initial closed v0.3.0 catalog baseline.",
    "stable-addition": "A stable platform symbol added to complete the stated SDK baseline."
  },
  "profileClaims": {
    "sharedObservation": {
      "rule": "exactly two direct meta.profile claims: the listed source-neutral Sensor semantic profile and the SensorKit adapter profile",
      "adapterProfile": "https://grovealliance.org/fhir/sensorkit/StructureDefinition/sensorkit-observation"
    },
    "hybridObservation": {
      "rule": "exactly two direct meta.profile claims: the listed source-neutral Sensor semantic profile and the exact SensorKit hybrid adapter child; one linked exact native Recording Document is mandatory",
      "adapterProfile": "https://grovealliance.org/fhir/sensorkit/StructureDefinition/sensorkit-ecg-observation"
    },
    "recordingDocument": {
      "rule": "exactly two direct meta.profile claims: the source-neutral Sensor Recording Document profile and the SensorKit Recording Document adapter profile",
      "sourceNeutralProfile": "https://grovealliance.org/fhir/sensor/StructureDefinition/grove-sensor-recording-document",
      "adapterProfile": "https://grovealliance.org/fhir/sensorkit/StructureDefinition/sensorkit-recording-document",
      "defaultOutputDiscriminator": "native-recording",
      "defaultRule": "Every admitted raw representation uses this profile pair and output discriminator unless its row explicitly replaces them."
    },
    "providerSpecificObservation": {
      "rule": "exactly one direct meta.profile claim: the listed SensorKit-only profile, which inherits the adapter envelope"
    },
    "conversionProvenance": {
      "profile": "https://grovealliance.org/fhir/sensorkit/StructureDefinition/sensorkit-conversion-provenance",
      "rule": "The adapter-specific Provenance targets every structured and raw output from the source record and carries that exact source-record Identifier as its sole source entity."
    }
  },
  "rawPayloadAdmission": {
    "contract": "https://grovealliance.org/fhir/sensor#recording-document.payloadAdmission",
    "allowedAssertions": [
      "caller-authorized-opaque-payload",
      "verified-sanitized-input"
    ],
    "failureRule": "The producer fails closed before emission unless the caller supplies exactly one assertion.",
    "notFHIRAuthorization": true
  },
  "identity": {
    "sourceRecord": {
      "system": "https://grovealliance.org/fhir/sensorkit/NamingSystem/sensorkit-record-id",
      "assignmentRule": "The SensorKit-facing producer assigns one stable lowercase UUID to one exact source stream record. Re-fetching unchanged content must reuse it; changed content or a distinct source record must use a different value. Cross-producer equality is not asserted because SensorKit supplies no durable sample identifier."
    },
    "output": {
      "system": "https://grovealliance.org/fhir/sensorkit/NamingSystem/sensorkit-output-id",
      "algorithm": "The scheme version v1:, the source record identifier's value and the outputDiscriminator, joined by vertical bars. No component may contain a vertical bar; a value carrying one is rejected rather than escaped. Nothing is hashed.",
      "rule": "Use the exact outputDiscriminator on the admitted structured or raw representation; there is no fallback.",
