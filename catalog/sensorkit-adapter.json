    {
      "sourceToken": "SRSensor.siriSpeechMetrics",
      "symbol": "SRSensorSiriSpeechMetrics",
      "identifier": "com.apple.SensorKit.speechMetrics.siri",
      "sourceTypeCode": "siri-speech-metrics",
      "title": "Siri speech metrics",
      "documentation": "https://developer.apple.com/documentation/sensorkit/srsensor/sirispeechmetrics",
      "minimumIOS": "15.0",
      "scope": "catalog-baseline",
      "status": "mapped-standard",
      "structured": {
        "status": "deferred",
        "reason": "Speech metrics have no reviewed source-neutral clinical Observation representation in version 0.5.0."
      },
      "raw": {
        "status": "mapped-standard",
        "profile": "https://grovealliance.org/fhir/sensorkit/StructureDefinition/sensorkit-recording-document",
        "outputDiscriminator": "native-recording",
        "encoding": "caller-supplied exact bytes",
        "formats": [
          "native-recording"
        ],
        "jsonSchema": {
          "schemaId": "sensorkit-speech-metrics-json",
          "structure": "UTF-8; one JSON array of speech-metrics records in source order; every declared field present; absent values encode as null; timestamps are seconds since the Unix epoch; CMTimeRange encodes as {\"start\": number s, \"duration\": number s}.",
          "fields": [
            {
              "name": "timestamp",
              "type": "number",
              "unit": "s (Unix epoch)",
              "optional": false,
              "meaning": "Fetch-record delivery instant (SRFetchResult.timestamp); always present on every supported OS."
            },
            {
              "name": "speechTimestamp",
              "type": "number|null",
              "unit": "s (Unix epoch)",
              "optional": true,
              "meaning": "When the speech occurs (SRSpeechMetrics.timestamp); null on records from OS versions before its introduction."
            },
            {
              "name": "sessionIdentifier",
              "type": "string|null",
              "optional": true,
              "meaning": "Audio session identifier; null before its introduction."
            },
            {
              "name": "sessionFlags",
              "type": "array(string)|null",
              "optional": true,
              "meaning": "Active SessionFlags option names; closed domain currently exactly [\"bypassVoiceProcessing\"]; null before its introduction."
            },
            {
              "name": "timeSinceAudioStart",
              "type": "number",
              "unit": "s",
              "optional": false,
              "meaning": "Seconds since the audio stream start."
            },
            {
              "name": "audioLevel",
              "type": "object|null",
              "optional": true,
              "meaning": "{timeRange: {start s, duration s}, loudness: number (decibels, no Apple-defined reference level)}."
            },
            {
              "name": "speechExpression",
              "type": "object|null",
              "optional": true,
              "meaning": "{timeRange, version: string, confidence, mood, valence, activation, dominance: dimensionless model scores}."
            },
            {
              "name": "speechRecognitionMetadata",
              "type": "object|null",
              "optional": true,
              "meaning": "{speakingRate: number (words per minute), averagePauseDuration: number s, speechStartTimestamp: number s, speechDuration: number s, voiceAnalytics: {voicing, pitch, jitter, shimmer: each {frameDuration: number s, values: [number]}}|null} — the content-free projection of SFSpeechRecognitionResult.speechRecognitionMetadata."
            },
            {
              "name": "soundClassification",
              "type": "object|null",
              "optional": true,
              "meaning": "{timeRange, classifications: [{identifier: string, confidence: number}]} — model labels, not audio."
            }
          ]
        }
      }
    },
