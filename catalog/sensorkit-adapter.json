          ],
          "identifierValue": "v1:879d9ea2-21cb-4527-b59b-2831dc4c84ab|visit-summary"
        },
        {
          "outputDiscriminator": "native-\n\"\\résumé\u0001",
          "components": [
            "879d9ea2-21cb-4527-b59b-2831dc4c84ab",
            "native-\n\"\\résumé\u0001"
          ],
          "identifierValue": "v1:879d9ea2-21cb-4527-b59b-2831dc4c84ab|native-\n\"\\résumé\u0001"
        },
        {
          "outputDiscriminator": "native|recording",
          "components": [
            "879d9ea2-21cb-4527-b59b-2831dc4c84ab",
            "native|recording"
          ],
          "identifierValue": null,
          "note": "A discriminator carrying the separator has no representation here and is rejected, never escaped."
        }
      ],
      "separator": "|",
      "versionPrefix": "v1"
    },
    "valuePattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
    "contentRule": "Every source field represented in the structured resource or native recording must participate in the producer's stable identity input; Resource.id, repository ids, subject references, and processing timestamps must not participate. The recording-device identity in exchange-identity.json is the one exception: a wearable belongs to a person, so its key admits the subject reference to keep one participant's recorder distinct from another's identical model.",
    "resourceIdPolicy": "Resource.id is optional and repository-assigned. SensorKit source-record and output identifiers are complete business Identifiers and are never copied into Resource.id."
  },
