{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grovealliance.org/fhir/catalog/schemas/release-evidence.schema.json",
  "title": "Grove FHIR release machine-contract index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "kind",
    "releaseVersion",
    "fhirVersion",
    "sourceRevision",
    "artifacts"
  ],
  "properties": {
    "$schema": {
      "const": "https://grovealliance.org/fhir/catalog/schemas/release-evidence.schema.json"
    },
    "schemaVersion": {"const": 1},
    "kind": {"const": "machine-contract-index"},
    "releaseVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "fhirVersion": {"const": "4.0.1"},
    "sourceRevision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "artifacts": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^(?:catalog|Conformance/corpora|questionnaire/fixtures)/(?:[A-Za-z0-9_-]+/)*[A-Za-z0-9._-]+\\.json$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sha256", "size"],
        "properties": {
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "size": {"type": "integer", "minimum": 1}
        }
      }
    }
  }
}
