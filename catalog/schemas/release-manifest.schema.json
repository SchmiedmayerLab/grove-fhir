{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grovealliance.org/fhir/catalog/schemas/release-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "releaseVersion", "fhirVersion", "canonicalRoot", "toolchain", "publication", "guides", "normativeCatalogs"],
  "properties": {
    "$schema": {"const": "https://grovealliance.org/fhir/catalog/schemas/release-manifest.schema.json"},
    "schemaVersion": {"const": 0},
    "releaseVersion": {"const": "0.8.0"},
    "fhirVersion": {"const": "4.0.1"},
    "canonicalRoot": {"const": "https://grovealliance.org/fhir"},
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["igPublisher", "fhirValidator", "sushi", "template"],
      "properties": {
        "igPublisher": {"$ref": "#/$defs/checksummedTool"},
        "fhirValidator": {"$ref": "#/$defs/checksummedTool"},
        "sushi": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version"],
          "properties": {
            "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}
          }
        },
        "template": {
          "type": "object",
          "additionalProperties": false,
          "required": ["packageId", "version", "sha256"],
          "properties": {
            "packageId": {"type": "string", "pattern": "^[a-z0-9.-]+$"},
            "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        }
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "$comment": "previewMode is the one publication scalar with a reader; the release policy itself lives in PUBLICATION.md.",
      "required": ["previewMode"],
      "properties": {
        "previewMode": {"const": "ci-build-only"}
      }
    },
    "guides": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "packageId", "canonical", "directDependencies"],
        "properties": {
          "source": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "packageId": {"type": "string", "pattern": "^org\\.grovealliance\\.fhir\\.[a-z0-9-]+$"},
          "canonical": {"type": "string", "format": "uri", "pattern": "^https://grovealliance\\.org/fhir/"},
          "directDependencies": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[a-z0-9.-]+#[0-9]+\\.[0-9]+\\.[0-9]+$"}
          }
        },
        "oneOf": [
          {"properties": {"source": {"const": "mobile"}, "packageId": {"const": "org.grovealliance.fhir.mobile"}, "canonical": {"const": "https://grovealliance.org/fhir/mobile"}}},
          {"properties": {"source": {"const": "questionnaire"}, "packageId": {"const": "org.grovealliance.fhir.questionnaire"}, "canonical": {"const": "https://grovealliance.org/fhir/questionnaire"}}},
          {"properties": {"source": {"const": "sensor"}, "packageId": {"const": "org.grovealliance.fhir.sensor"}, "canonical": {"const": "https://grovealliance.org/fhir/sensor"}}},
          {"properties": {"source": {"const": "sensorkit"}, "packageId": {"const": "org.grovealliance.fhir.sensorkit"}, "canonical": {"const": "https://grovealliance.org/fhir/sensorkit"}}},
          {"properties": {"source": {"const": "healthkit"}, "packageId": {"const": "org.grovealliance.fhir.healthkit"}, "canonical": {"const": "https://grovealliance.org/fhir/healthkit"}}},
          {"properties": {"source": {"const": "health-connect"}, "packageId": {"const": "org.grovealliance.fhir.health-connect"}, "canonical": {"const": "https://grovealliance.org/fhir/health-connect"}}},
          {"properties": {"source": {"const": "providers"}, "packageId": {"const": "org.grovealliance.fhir.providers"}, "canonical": {"const": "https://grovealliance.org/fhir/providers"}}},
          {"properties": {"source": {"const": "withings"}, "packageId": {"const": "org.grovealliance.fhir.withings"}, "canonical": {"const": "https://grovealliance.org/fhir/withings"}}},
          {"properties": {"source": {"const": "oura"}, "packageId": {"const": "org.grovealliance.fhir.oura"}, "canonical": {"const": "https://grovealliance.org/fhir/oura"}}},
          {"properties": {"source": {"const": "google-health"}, "packageId": {"const": "org.grovealliance.fhir.google-health"}, "canonical": {"const": "https://grovealliance.org/fhir/google-health"}}}
        ]
      }
    },
    "normativeCatalogs": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "schema", "schemaVersion"],
        "properties": {
          "path": {"type": "string", "pattern": "^catalog/[a-z0-9-]+\\.json$"},
          "schema": {"type": "string", "pattern": "^catalog/schemas/[a-z0-9-]+\\.schema\\.json$"},
          "schemaVersion": {"type": "integer", "minimum": 0}
        },
        "oneOf": [
          {"const": {"path": "catalog/exchange-protocol.json", "schema": "catalog/schemas/exchange-protocol.schema.json", "schemaVersion": 0}},
          {"const": {"path": "catalog/measurement-catalog.json", "schema": "catalog/schemas/measurement-catalog.schema.json", "schemaVersion": 0}},
          {"const": {"path": "catalog/package-graph.json", "schema": "catalog/schemas/package-graph.schema.json", "schemaVersion": 0}},
          {"const": {"path": "catalog/format-registry.json", "schema": "catalog/schemas/catalog-contracts.schema.json", "schemaVersion": 0}},
          {"const": {"path": "catalog/health-connect-adapter.json", "schema": "catalog/schemas/catalog-contracts.schema.json", "schemaVersion": 0}},
          {"const": {"path": "catalog/healthkit-adapter.json", "schema": "catalog/schemas/catalog-contracts.schema.json", "schemaVersion": 0}},
          {"const": {"path": "catalog/providers-adapter.json", "schema": "catalog/schemas/catalog-contracts.schema.json", "schemaVersion": 0}},
          {"const": {"path": "catalog/sensor-catalog.json", "schema": "catalog/schemas/catalog-contracts.schema.json", "schemaVersion": 0}},
          {"const": {"path": "catalog/sensorkit-adapter.json", "schema": "catalog/schemas/catalog-contracts.schema.json", "schemaVersion": 0}},
          {"const": {"path": "catalog/profile-claims.json", "schema": "catalog/schemas/catalog-contracts.schema.json", "schemaVersion": 0}}
        ]
      }
    }
  },
  "$defs": {
    "checksummedTool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "sha256"],
      "properties": {
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
