{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grovealliance.org/fhir/catalog/schemas/exchange-protocol.schema.json",
  "title": "Grove FHIR exchange protocol",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "version",
    "protocolVersion",
    "releaseVersion",
    "fhirVersion",
    "profiles",
    "extensions",
    "codeSystems",
    "conformanceLevels",
    "producerDiagnostics",
    "event",
    "opaqueIdentity",
    "governedSourceIdentifier",
    "entryIdentity",
    "lifecycle",
    "referencePolicy",
    "outputModes",
    "outputCountRules",
    "recordingDevice",
    "payload",
    "testVectors"
  ],
  "properties": {
    "$schema": { "const": "https://grovealliance.org/fhir/catalog/schemas/exchange-protocol.schema.json" },
    "schemaVersion": { "const": 0 },
    "version": { "const": "0.6.0" },
    "protocolVersion": { "const": 0 },
    "releaseVersion": { "const": "0.6.0" },
    "fhirVersion": { "const": "4.0.1" },
    "profiles": { "$ref": "#/$defs/profiles" },
    "extensions": { "$ref": "#/$defs/extensions" },
    "codeSystems": { "$ref": "#/$defs/codeSystems" },
    "conformanceLevels": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/conformanceLevel" }
    },
    "producerDiagnostics": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/producerDiagnostic" }
    },
    "event": { "$ref": "#/$defs/event" },
    "opaqueIdentity": { "$ref": "#/$defs/opaqueIdentity" },
    "governedSourceIdentifier": { "$ref": "#/$defs/governedSourceIdentifier" },
    "entryIdentity": { "$ref": "#/$defs/entryIdentity" },
    "lifecycle": { "$ref": "#/$defs/lifecycle" },
    "referencePolicy": { "$ref": "#/$defs/referencePolicy" },
    "outputModes": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/codeMeaning" }
    },
    "outputCountRules": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z]+(?:-[a-z]+)*$" }
    },
    "recordingDevice": { "$ref": "#/$defs/recordingDevice" },
    "payload": { "$ref": "#/$defs/payload" },
    "testVectors": { "$ref": "#/$defs/testVectors" }
  },
  "$defs": {
    "nonempty": { "type": "string", "minLength": 1 },
    "uri": { "type": "string", "pattern": "^https?://[^\\s]+$" },
    "code": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
    "producerDiagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "reason", "emittedBy"],
      "properties": {
        "code": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(?:[.][a-z][a-z0-9-]*)+$" },
        "reason": { "$ref": "#/$defs/nonempty" },
        "emittedBy": { "enum": ["conformance-kit", "client"] }
      }
    },
    "profiles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["activeBundle", "conversionProvenance", "retractionBundle", "retractionProvenance"],
      "properties": {
        "activeBundle": { "$ref": "#/$defs/uri" },
        "conversionProvenance": { "$ref": "#/$defs/uri" },
        "retractionBundle": { "$ref": "#/$defs/uri" },
        "retractionProvenance": { "$ref": "#/$defs/uri" }
      }
    },
    "extensions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entryNodeKey", "retractionTargetRole", "retractionTargetNativeIdentifier", "writerRecordVersion"],
      "properties": {
        "entryNodeKey": { "$ref": "#/$defs/uri" },
        "retractionTargetRole": { "$ref": "#/$defs/uri" },
        "retractionTargetNativeIdentifier": { "$ref": "#/$defs/uri" },
        "writerRecordVersion": { "$ref": "#/$defs/uri" }
      }
    },
    "codeSystems": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identifierRole", "lifecycleEvent", "retractionTargetRole"],
      "properties": {
        "identifierRole": { "$ref": "#/$defs/uri" },
        "lifecycleEvent": { "$ref": "#/$defs/uri" },
        "retractionTargetRole": { "$ref": "#/$defs/uri" }
      }
    },
    "conformanceLevel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "authority", "validator"],
      "properties": {
        "code": { "enum": ["fhir-r4", "grove-profile", "grove-producer"] },
        "authority": { "$ref": "#/$defs/nonempty" },
        "validator": { "$ref": "#/$defs/nonempty" }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["semanticUnit", "bundleIdentifier", "times", "retry", "transport"],
      "properties": {
        "semanticUnit": { "$ref": "#/$defs/nonempty" },
        "bundleIdentifier": {
          "type": "object",
          "additionalProperties": false,
          "required": ["system", "valueForm", "soleEventBusinessIdentifier"],
          "properties": {
            "system": { "$ref": "#/$defs/nonempty" },
            "valueForm": { "$ref": "#/$defs/nonempty" },
            "soleEventBusinessIdentifier": { "const": true }
          }
        },
        "times": {
          "type": "object",
          "additionalProperties": false,
          "required": ["occurred", "recorded", "assembled"],
          "properties": {
            "occurred": { "$ref": "#/$defs/nonempty" },
            "recorded": { "$ref": "#/$defs/nonempty" },
            "assembled": { "$ref": "#/$defs/nonempty" }
          }
        },
        "retry": { "$ref": "#/$defs/nonempty" },
        "transport": { "$ref": "#/$defs/nonempty" }
      }
    },
    "opaqueIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "domain", "preimage", "valueForm", "identifierSystem", "keyRequirements", "componentRequirements", "privacy", "informationPreservation", "rotation", "identityKinds"],
      "properties": {
        "algorithm": { "const": "HMAC-SHA-256" },
        "domain": { "const": "org.grovealliance.fhir.identity.v0" },
        "preimage": { "$ref": "#/$defs/nonempty" },
        "valueForm": { "$ref": "#/$defs/nonempty" },
        "identifierSystem": { "$ref": "#/$defs/nonempty" },
        "keyRequirements": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minimumBytes", "managedSecret", "testKeysProhibited"],
          "properties": {
            "minimumBytes": { "type": "integer", "minimum": 32 },
            "managedSecret": { "const": true },
            "testKeysProhibited": { "const": true }
          }
        },
        "componentRequirements": {
          "type": "object",
          "additionalProperties": false,
          "required": ["valueType", "nonEmpty", "arity"],
          "properties": {
            "valueType": { "const": "unicode-scalar-string" },
            "nonEmpty": { "const": true },
            "arity": { "const": "exactly-kind-components" }
          }
        },
        "privacy": { "$ref": "#/$defs/nonempty" },
        "informationPreservation": {
          "type": "object", "additionalProperties": false,
          "required": ["hmacGuarantee", "reversible", "exactNativeRoundTrip", "potentiallyInternalCoordinates", "internalCoordinateRule", "semanticSourceFactRule"],
          "properties": {
            "hmacGuarantee": { "const": "equality-and-reconciliation" },
            "reversible": { "const": false },
            "exactNativeRoundTrip": { "const": "optional-governed-source-identifier-on-catalog-designated-primary" },
            "potentiallyInternalCoordinates": { "const": ["output-role", "output-discriminator", "child-index"] },
            "internalCoordinateRule": { "$ref": "#/$defs/nonempty" },
            "semanticSourceFactRule": { "$ref": "#/$defs/nonempty" }
          }
        },
        "rotation": { "$ref": "#/$defs/nonempty" },
        "identityKinds": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/identityKind" }
        }
      }
    },
    "identityKind": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "identifierRole", "components"],
      "properties": {
        "kind": { "$ref": "#/$defs/code" },
        "identifierRole": { "$ref": "#/$defs/code" },
        "components": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/code" }
        }
      }
    },
    "governedSourceIdentifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["purpose", "placement", "system", "value", "type", "prohibitions", "closedProfiles", "validation"],
      "properties": {
        "purpose": { "$ref": "#/$defs/nonempty" },
        "placement": { "$ref": "#/$defs/nonempty" },
        "system": { "$ref": "#/$defs/nonempty" },
        "value": { "$ref": "#/$defs/nonempty" },
        "type": { "$ref": "#/$defs/nonempty" },
        "prohibitions": { "$ref": "#/$defs/nonempty" },
        "closedProfiles": { "$ref": "#/$defs/nonempty" },
        "validation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["optionality", "designatedNode", "identifier", "forbiddenIdentityUses", "forbiddenIdentityUseEnforcement", "duplicateElsewhereInEventAllowed", "neverResourceTypes", "neverProfiles", "healthConnectChildCountRules", "healthConnectChildGraphRules", "recordingDocumentRule"],
          "properties": {
            "optionality": { "const": "optional" },
            "designatedNode": {
              "type": "object", "additionalProperties": false,
              "required": ["lifecycle", "r4Element", "designationMode", "maxPerPrimaryOutput", "maxPrimaryOutputsPerEvent", "ambiguityRule", "outputModeRules", "adapterSelectors"],
              "properties": {
                "lifecycle": { "const": "active" },
                "r4Element": { "const": "Resource.identifier" },
                "designationMode": { "const": "catalog-output-selector" },
                "maxPerPrimaryOutput": { "const": 1 },
                "maxPrimaryOutputsPerEvent": { "const": 1 },
                "ambiguityRule": { "const": "omit-native-identifier" },
                "outputModeRules": {
                  "const": {
                    "semantic-only": "sole-source-derived-output",
                    "source-only": "sole-document-reference-output",
                    "hybrid-required": "one-structured-primary-never-companion-artifact",
                    "choice": "one-selected-one-to-one-output"
                  }
                },
                "adapterSelectors": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["healthkit", "health-connect", "providers", "sensorkit"],
                  "properties": {
                    "healthkit": { "$ref": "#/$defs/governedHealthKitSelector" },
                    "health-connect": { "$ref": "#/$defs/governedHealthConnectSelector" },
                    "providers": { "$ref": "#/$defs/governedProviderSelector" },
                    "sensorkit": { "$ref": "#/$defs/governedSensorKitSelector" }
                  }
                }
              }
            },
            "identifier": {
              "type": "object", "additionalProperties": false,
              "required": ["classification", "system", "value", "type"],
              "properties": {
                "classification": { "const": {"activeOutputNonGroveIdentifier": "governed-source-identifier", "supportNodeIdentifier": "profile-defined-non-source-identifier", "supportLeakageDetection": "exact-system-and-value-pair-match-to-active-governed-identifier"} },
                "system": { "const": {"required": true, "absoluteUri": true, "scope": "deployment-or-exact-source-authority-key-space"} },
                "value": { "const": {"required": true, "nonEmpty": true, "exactSourceValue": true} },
                "type": {
                  "const": {
                    "required": false,
                    "textOnlyAllowed": true,
                    "coding": {
                      "systemRequired": true,
                      "systemAbsoluteUri": true,
                      "codeRequired": true,
                      "codeLexicalForm": "fhir-code",
                      "groveRoleCodingAllowed": false
                    }
                  }
                }
              }
            },
            "forbiddenIdentityUses": {
              "const": ["resource-id", "bundle-entry-key", "retraction-address", "observation-component", "untyped-metadata", "attachment-title", "attachment-url"]
            },
            "forbiddenIdentityUseEnforcement": {
              "const": {
                "exactIdentifierPair": {"r4Paths": ["**.Identifier"], "matchRule": "exact-system-and-value", "enforcement": "event-validator"},
                "resourceId": {"r4Paths": ["**.Resource.id"], "matchRule": "no-value-only-heuristic", "enforcement": "producer-obligation-and-profile-review"},
                "bundleEntryKey": {"r4Paths": ["Bundle.entry.fullUrl", "Bundle.entry.extension.valueIdentifier.value"], "matchRule": "identifier-pair-structural-validation; no-fullUrl-value-heuristic", "enforcement": "exchange-entry-key-validator-and-producer-obligation"},
                "retractionAddress": {"r4Paths": ["Provenance.target.reference", "Provenance.target.identifier.value"], "matchRule": "identifier-pair-structural-validation; no-reference-value-heuristic", "enforcement": "retraction-profile-validator-and-producer-obligation"},
                "observationComponent": {"r4Paths": ["Observation.component.value[x]"], "matchRule": "no-value-only-heuristic", "enforcement": "closed-adapter-component-semantics-and-producer-obligation"},
                "untypedMetadata": {"r4Paths": [], "matchRule": "no-generic-carrier-admitted", "enforcement": "closed-adapter-metadata-allowlists-and-no-grove-generic-extension"},
                "attachmentPresentation": {"r4Paths": ["DocumentReference.content.attachment.title", "DocumentReference.content.attachment.url"], "matchRule": "no-substring-heuristic", "enforcement": "deployment-governance-and-producer-obligation"}
              }
            },
            "duplicateElsewhereInEventAllowed": { "const": false },
            "neverResourceTypes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/nonempty" } },
            "neverProfiles": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/uri" } },
            "healthConnectChildCountRules": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/code" } },
            "healthConnectChildGraphRules": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/code" } },
            "recordingDocumentRule": { "$ref": "#/$defs/nonempty" }
          }
        }
      }
    },
    "governedExtensionMarker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "url", "valueElement"],
      "properties": {
        "kind": { "const": "extension" },
        "url": { "$ref": "#/$defs/uri" },
        "valueElement": { "const": "valueCode" }
      }
    },
    "governedHealthKitSelector": {
      "type": "object", "additionalProperties": false,
      "required": ["catalog", "rowCollection", "rowKey", "sourceMarker", "strategy", "excludedProfiles"],
      "properties": {
        "catalog": { "const": "catalog/healthkit-adapter.json" }, "rowCollection": { "const": "rows" }, "rowKey": { "const": "sourceTypeIdentifier" },
        "sourceMarker": { "$ref": "#/$defs/governedExtensionMarker" },
        "strategy": { "const": "unique-output-intersecting-source-row-profiles" },
        "excludedProfiles": { "const": ["https://grovealliance.org/fhir/healthkit/StructureDefinition/healthkit-ecg-average-heart-rate-observation", "https://grovealliance.org/fhir/mobile/StructureDefinition/grove-mobile-workout-segment"] }
      }
    },
    "governedHealthConnectSelector": {
      "type": "object", "additionalProperties": false,
      "required": ["catalog", "rowCollection", "rowKey", "sourceMarker", "strategy", "eligibleCountRules", "eligibleGraphRules", "excludedResourceTypes"],
      "properties": {
        "catalog": { "const": "catalog/health-connect-adapter.json" }, "rowCollection": { "const": "recordTypes" }, "rowKey": { "const": "token" },
        "sourceMarker": { "$ref": "#/$defs/governedExtensionMarker" },
        "strategy": { "const": "unique-output-selected-by-source-row-output-contract" },
        "eligibleCountRules": { "const": ["exactly-one"] },
        "eligibleGraphRules": { "const": ["exactly-one-admitted-specimen-output"] },
        "excludedResourceTypes": { "const": ["Specimen"] }
      }
    },
    "governedProviderSelector": {
      "type": "object", "additionalProperties": false,
      "required": ["catalog", "rowCollection", "rowKey", "sourceMarker", "providerMarker", "strategy"],
      "properties": {
        "catalog": { "const": "catalog/providers-adapter.json" }, "rowCollection": { "const": "providers.sourceTypes" }, "rowKey": { "const": "provider-id+token" },
        "sourceMarker": { "$ref": "#/$defs/governedExtensionMarker" }, "providerMarker": { "$ref": "#/$defs/governedExtensionMarker" },
        "strategy": { "const": "unique-supported-measurement-or-sole-source-document" }
      }
    },
    "governedSensorKitSelector": {
      "type": "object", "additionalProperties": false,
      "required": ["catalog", "rowCollection", "rowKey", "sourceMarker", "strategy"],
      "properties": {
        "catalog": { "const": "catalog/sensorkit-adapter.json" }, "rowCollection": { "const": "entries" }, "rowKey": { "const": "sourceTypeCode" },
        "sourceMarker": { "$ref": "#/$defs/governedExtensionMarker" },
        "strategy": { "const": "unique-structured-row-profile-or-sole-source-document" }
      }
    },
    "entryIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selection", "resourceIdentifierPriority", "entryNode", "fullUrl"],
      "properties": {
        "selection": { "$ref": "#/$defs/nonempty" },
        "resourceIdentifierPriority": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/code" }
        },
        "entryNode": {
          "type": "object",
          "additionalProperties": false,
          "required": ["system", "domain", "components", "ordinal", "valueForm", "digest"],
          "properties": {
            "system": { "$ref": "#/$defs/nonempty" },
            "domain": { "const": "org.grovealliance.fhir.entry-node.v0" },
            "components": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": { "$ref": "#/$defs/code" }
            },
            "ordinal": { "$ref": "#/$defs/nonempty" },
            "valueForm": { "$ref": "#/$defs/nonempty" },
            "digest": { "$ref": "#/$defs/nonempty" }
          }
        },
        "fullUrl": {
          "type": "object",
          "additionalProperties": false,
          "required": ["algorithm", "namespace", "output", "privacy"],
          "properties": {
            "algorithm": { "$ref": "#/$defs/nonempty" },
            "namespace": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-5[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
            "output": { "$ref": "#/$defs/nonempty" },
            "privacy": { "$ref": "#/$defs/nonempty" }
          }
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["active", "retraction"],
      "properties": {
        "active": { "$ref": "#/$defs/lifecycleShape" },
        "retraction": {
          "type": "object",
          "additionalProperties": false,
          "required": ["activitySystem", "activityCode", "codingCardinality", "meaning", "target", "nativeRecordIdentifier", "targetRoles", "sink"],
          "properties": {
            "activitySystem": { "$ref": "#/$defs/uri" },
            "activityCode": { "const": "source-record-retracted" },
            "codingCardinality": { "$ref": "#/$defs/nonempty" },
            "meaning": { "$ref": "#/$defs/nonempty" },
            "target": { "$ref": "#/$defs/nonempty" },
            "nativeRecordIdentifier": {
              "type": "object",
              "additionalProperties": false,
              "required": ["optionality", "extension", "valueType", "maxPerTarget", "systemAuthority", "system", "value", "disclosurePolicy", "prohibitions"],
              "properties": {
                "optionality": { "const": "optional" },
                "extension": { "const": "https://grovealliance.org/fhir/mobile/StructureDefinition/grove-retraction-target-native-identifier" },
                "valueType": { "const": "Identifier" },
                "maxPerTarget": { "const": 1 },
                "systemAuthority": { "const": "per-adapter" },
                "system": { "$ref": "#/$defs/nonempty" },
                "value": { "$ref": "#/$defs/nonempty" },
                "disclosurePolicy": { "const": "governedSourceIdentifier" },
                "prohibitions": { "$ref": "#/$defs/nonempty" }
              }
            },
            "targetRoles": {
              "type": "object",
              "additionalProperties": false,
              "required": ["primary-output", "source-artifact", "child-output", "specimen", "device-snapshot"],
              "properties": {
                "primary-output": { "const": { "identifierRole": "source-output", "resourceTypes": ["Observation", "VisionPrescription", "MedicationAdministration", "MedicationStatement"] } },
                "source-artifact": { "const": { "identifierRole": "source-output", "resourceTypes": ["DocumentReference"] } },
                "child-output": { "const": { "identifierRole": "source-output", "resourceTypes": ["Observation"] } },
                "specimen": { "const": { "identifierRole": "source-output", "resourceTypes": ["Specimen"] } },
                "device-snapshot": { "const": { "identifierRole": "device-snapshot", "resourceTypes": ["Device"] } }
              }
            },
            "sink": { "$ref": "#/$defs/nonempty" }
          }
        }
      }
    },
    "lifecycleShape": {
      "type": "object",
      "additionalProperties": false,
      "required": ["activitySystem", "activityCode", "codingCardinality", "shape", "entryResourcePolicy", "adapterOnlyOutputProfileClaims"],
      "properties": {
        "activitySystem": { "$ref": "#/$defs/uri" },
        "activityCode": { "const": "transform" },
        "codingCardinality": { "$ref": "#/$defs/nonempty" },
        "shape": { "$ref": "#/$defs/nonempty" },
        "entryResourcePolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["outputResourceTypes", "supportingResourceTypes", "lifecycleResourceType", "otherResourceTypesAllowed", "containedResourcesAllowed", "supportingResourcesMustBeConnected", "profileClaimAuthority", "rule"],
          "properties": {
            "outputResourceTypes": { "const": ["Observation", "DocumentReference", "Specimen", "VisionPrescription", "MedicationAdministration", "MedicationStatement"] },
            "supportingResourceTypes": { "const": ["Patient", "Device", "ResearchStudy", "ResearchSubject", "PlanDefinition", "QuestionnaireResponse"] },
            "lifecycleResourceType": { "const": "Provenance" },
            "otherResourceTypesAllowed": { "const": false },
            "containedResourcesAllowed": { "const": false },
            "supportingResourcesMustBeConnected": { "const": true },
            "profileClaimAuthority": { "const": "catalog/profile-claims.json" },
            "rule": { "$ref": "#/$defs/nonempty" }
          }
        },
        "adapterOnlyOutputProfileClaims": {
          "type": "object",
          "additionalProperties": false,
          "required": ["authority", "resourceTypes", "rule"],
          "properties": {
            "authority": { "const": "catalog/profile-claims.json" },
            "resourceTypes": { "const": ["Specimen", "VisionPrescription", "MedicationAdministration", "MedicationStatement"] },
            "rule": { "$ref": "#/$defs/nonempty" }
          }
        }
      }
    },
    "referencePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["literalClosure", "declaredType", "governedShape", "identifierOnlyPatient", "paths", "extensionTargets"],
      "properties": {
        "literalClosure": { "$ref": "#/$defs/nonempty" },
        "declaredType": { "$ref": "#/$defs/nonempty" },
        "governedShape": { "$ref": "#/$defs/nonempty" },
        "identifierOnlyPatient": { "$ref": "#/$defs/identifierOnlyPatient" },
        "paths": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/referencePath" }
        },
        "extensionTargets": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/extensionTarget" }
        }
      }
    },
    "identifierOnlyPatient": {
      "type": "object",
      "additionalProperties": false,
      "required": ["systemRule", "valueRule", "reservedSystems"],
      "properties": {
        "systemRule": { "$ref": "#/$defs/nonempty" },
        "valueRule": { "$ref": "#/$defs/nonempty" },
        "reservedSystems": {
          "const": [
            "https://grovealliance.org/fhir/mobile/CodeSystem/grove-identifier-role",
            "https://grovealliance.org/fhir/mobile/CodeSystem/grove-lifecycle-event",
            "https://grovealliance.org/fhir/mobile/CodeSystem/grove-retraction-target-role"
          ]
        }
      }
    },
    "referencePath": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resourceType", "path", "repeating", "targetTypes"],
      "properties": {
        "resourceType": { "type": "string", "pattern": "^[A-Z][A-Za-z]+$" },
        "path": { "type": "string", "pattern": "^[a-z][A-Za-z]+$" },
        "repeating": { "type": "boolean" },
        "targetTypes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Z][A-Za-z]+$" }
        }
      }
    },
    "extensionTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "targetTypes"],
      "properties": {
        "url": { "$ref": "#/$defs/uri" },
        "targetTypes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Z][A-Za-z]+$" }
        }
      }
    },
    "codeMeaning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "meaning"],
      "properties": {
        "code": { "enum": ["semantic-only", "source-only", "hybrid-required", "choice"] },
        "meaning": { "$ref": "#/$defs/nonempty" }
      }
    },
    "recordingDevice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instanceRule", "unknownInstance", "snapshots", "roles"],
      "properties": {
        "instanceRule": { "$ref": "#/$defs/nonempty" },
        "unknownInstance": { "$ref": "#/$defs/nonempty" },
        "snapshots": { "$ref": "#/$defs/nonempty" },
        "roles": { "$ref": "#/$defs/nonempty" }
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attachmentSize", "attachmentHash", "semanticComparison", "byteComparison"],
      "properties": {
        "attachmentSize": { "$ref": "#/$defs/nonempty" },
        "attachmentHash": { "$ref": "#/$defs/nonempty" },
        "semanticComparison": { "$ref": "#/$defs/nonempty" },
        "byteComparison": { "$ref": "#/$defs/nonempty" }
      }
    },
    "testVectors": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keyHex", "keyId", "epoch", "warning", "identitySystems", "measurementExamples", "identities", "invalidIdentities", "event", "entryNode", "fullUrls"],
      "properties": {
        "keyHex": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "keyId": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
        "epoch": { "type": "string", "pattern": "^[1-9][0-9]*$" },
        "warning": { "$ref": "#/$defs/nonempty" },
        "identitySystems": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "items": { "$ref": "#/$defs/exampleIdentitySystem" }
        },
        "measurementExamples": { "$ref": "#/$defs/measurementExamples" },
        "identities": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/identityVector" }
        },
        "invalidIdentities": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/invalidIdentityVector" }
        },
        "event": { "$ref": "#/$defs/eventVector" },
        "entryNode": { "$ref": "#/$defs/entryNodeVector" },
        "fullUrls": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/fullUrlVector" }
        }
      }
    },
    "measurementExamples": {
      "type": "object",
      "additionalProperties": false,
      "required": ["effectiveInstant", "effectivePeriodStart", "effectivePeriodEnd", "healthConnectLastModifiedTime", "nativeRecordPrefix", "repositoryScope", "providerScope", "globalProviderScope", "coordinates"],
      "properties": {
        "effectiveInstant": { "type": "string", "format": "date-time" },
        "effectivePeriodStart": { "type": "string", "format": "date-time" },
        "effectivePeriodEnd": { "type": "string", "format": "date-time" },
        "healthConnectLastModifiedTime": { "type": "string", "format": "date-time" },
        "nativeRecordPrefix": { "$ref": "#/$defs/nonempty" },
        "repositoryScope": { "$ref": "#/$defs/exampleScope" },
        "providerScope": { "$ref": "#/$defs/exampleScope" },
        "globalProviderScope": { "$ref": "#/$defs/exampleScope" },
        "coordinates": {
          "type": "object",
          "additionalProperties": false,
          "required": ["canonicalInstant", "canonicalPeriodStart", "canonicalPeriodEnd", "occurrence", "sleepStageToken", "exerciseSegmentToken"],
          "properties": {
            "canonicalInstant": { "$ref": "#/$defs/nonempty" },
            "canonicalPeriodStart": { "$ref": "#/$defs/nonempty" },
            "canonicalPeriodEnd": { "$ref": "#/$defs/nonempty" },
            "occurrence": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" },
            "sleepStageToken": { "$ref": "#/$defs/nonempty" },
            "exerciseSegmentToken": { "$ref": "#/$defs/nonempty" }
          }
        }
      }
    },
    "exampleScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system", "value"],
      "properties": {
        "system": { "$ref": "#/$defs/uri" },
        "value": { "$ref": "#/$defs/nonempty" }
      }
    },
    "exampleIdentitySystem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identityKind", "system"],
      "properties": {
        "identityKind": { "enum": ["source-record", "source-output", "writer-record", "provider-record", "provider-output", "source-artifact", "provider-artifact", "source-context", "recording-device", "device-snapshot"] },
        "system": { "$ref": "#/$defs/uri" }
      }
    },
    "identityVector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "identityKind", "components", "value"],
      "properties": {
        "id": { "$ref": "#/$defs/code" },
        "identityKind": { "$ref": "#/$defs/code" },
        "components": { "type": "array", "items": { "$ref": "#/$defs/nonempty" } },
        "value": { "type": "string", "pattern": "^v0:[A-Za-z0-9._-]+:[1-9][0-9]*:[A-Za-z0-9_-]{43}$" }
      }
    },
    "invalidIdentityVector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "identityKind", "components", "expectedError"],
      "properties": {
        "id": { "$ref": "#/$defs/code" },
        "identityKind": { "$ref": "#/$defs/code" },
        "components": { "type": "array", "items": { "type": "string" } },
        "expectedError": { "enum": ["empty-component", "provider-kind-required"] }
      }
    },
    "eventVector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system", "producerInstance", "sequence", "value"],
      "properties": {
        "system": { "$ref": "#/$defs/uri" },
        "producerInstance": { "type": "string", "pattern": "^[0-9a-f-]{36}$" },
        "sequence": { "type": "string", "pattern": "^[1-9][0-9]*$" },
        "value": { "type": "string", "pattern": "^e0:[0-9a-f-]{36}:[1-9][0-9]*$" }
      }
    },
    "entryNodeVector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system", "role", "ordinal", "value", "fullUrl"],
      "properties": {
        "system": { "$ref": "#/$defs/uri" },
        "role": { "$ref": "#/$defs/code" },
        "ordinal": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" },
        "value": { "type": "string", "pattern": "^n0:[a-z][a-z0-9-]*:(0|[1-9][0-9]*):[A-Za-z0-9_-]{43}$" },
        "fullUrl": { "type": "string", "pattern": "^urn:uuid:[0-9a-f-]{36}$" }
      }
    },
    "fullUrlVector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "system", "value", "fullUrl"],
      "properties": {
        "id": { "$ref": "#/$defs/code" },
        "system": { "$ref": "#/$defs/uri" },
        "value": { "$ref": "#/$defs/nonempty" },
        "fullUrl": { "type": "string", "pattern": "^urn:uuid:[0-9a-f-]{36}$" }
      }
    }
  }
}
