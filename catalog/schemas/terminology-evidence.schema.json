{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grovealliance.org/fhir/catalog/schemas/terminology-evidence.schema.json",
  "title": "Grove FHIR online terminology validation evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "releaseVersion",
    "fhirVersion",
    "sourceRevision",
    "validationDate",
    "endpoint",
    "terminologyEditions",
    "policy",
    "tool",
    "packages",
    "result"
  ],
  "properties": {
    "$schema": {
      "const": "https://grovealliance.org/fhir/catalog/schemas/terminology-evidence.schema.json"
    },
    "schemaVersion": {"const": 1},
    "releaseVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "fhirVersion": {"const": "4.0.1"},
    "sourceRevision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "validationDate": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "software", "version"],
      "properties": {
        "url": {"type": "string", "pattern": "^https://[^/?#\\s]+(?:/[^?#\\s]*)?$"},
        "software": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "terminologyEditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["system", "edition", "version", "authority"],
        "properties": {
          "system": {"type": "string", "pattern": "^https?://\\S+$"},
          "edition": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "authority": {"type": "string", "minLength": 1}
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identifier",
        "version",
        "sha256",
        "licensedContentAuthorized",
        "cacheMode",
        "warningDisposition"
      ],
      "properties": {
        "identifier": {"type": "string", "pattern": "^https://\\S+$"},
        "version": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "licensedContentAuthorized": {"const": true},
        "cacheMode": {"enum": ["cold", "checksum-bound-warm"]},
        "warningDisposition": {"enum": ["fail", "reviewed"]}
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "sha256", "arguments"],
      "properties": {
        "name": {"const": "HL7 FHIR Validator"},
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "arguments": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["packageId", "version", "sha256"],
        "properties": {
          "packageId": {
            "type": "string",
            "pattern": "^org\\.grovealliance\\.fhir\\.[a-z0-9-]+$"
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "validatedResourceCount",
        "errorCount",
        "warningCount",
        "completedAt",
        "summary",
        "report"
      ],
      "properties": {
        "status": {"const": "passed"},
        "validatedResourceCount": {"type": "integer", "minimum": 1},
        "errorCount": {"const": 0},
        "warningCount": {"type": "integer", "minimum": 0},
        "completedAt": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
        },
        "summary": {"type": "string", "minLength": 1},
        "report": {
          "type": "object",
          "additionalProperties": false,
          "required": ["file", "mediaType", "sha256"],
          "properties": {
            "file": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*\\.json$"
            },
            "mediaType": {"enum": ["application/json", "application/fhir+json"]},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        }
      }
    }
  }
}
