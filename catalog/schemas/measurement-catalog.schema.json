{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grovealliance.org/fhir/catalog/schemas/measurement-catalog.schema.json",
  "title": "Grove source-neutral measurement catalog",
  "description": "The normative measurement catalog for every shared profile, example, and language contract. Its closed schema keeps those projections consistent across guides and implementations.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "fhirVersion",
    "version",
    "canonicalRoot",
    "statusVocabulary",
    "sources",
    "effectiveCanonicalization",
    "measurements"
  ],
  "properties": {
    "$schema": {
      "const": "https://grovealliance.org/fhir/catalog/schemas/measurement-catalog.schema.json"
    },
    "schemaVersion": {
      "const": 0
    },
    "fhirVersion": {
      "const": "4.0.1"
    },
    "version": {
      "const": "0.6.0"
    },
    "canonicalRoot": {
      "const": "https://grovealliance.org/fhir/mobile/StructureDefinition"
    },
    "statusVocabulary": {
      "$comment": "Its keys are the vocabulary; a separate name list would be a second place to forget.",
      "type": "object",
      "additionalProperties": false,
      "required": ["supported", "mapped-standard", "platform-exclusive", "unmodeled", "deferred", "intentionally-unsupported"],
      "properties": {
        "supported": {"type": "string", "minLength": 1},
        "mapped-standard": {"type": "string", "minLength": 1},
        "platform-exclusive": {"type": "string", "minLength": 1},
        "unmodeled": {"type": "string", "minLength": 1},
        "deferred": {"type": "string", "minLength": 1},
        "intentionally-unsupported": {"type": "string", "minLength": 1}
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "kind": {
            "enum": ["adapter", "provider", "instrument"]
          },
          "catalog": {
            "type": "string",
            "pattern": "^catalog/[a-z0-9-]+\\.json$"
          },
          "guide": {
            "type": "string",
            "description": "The guide that defines this instrument source; an instrument has no adapter inventory to point at.",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "ownerAdapter": {
            "type": "string",
            "description": "The adapter guide that publishes this provider's profiles.",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          }
        },
        "allOf": [
          {
            "if": {"properties": {"kind": {"const": "provider"}}, "required": ["kind"]},
            "then": {"required": ["ownerAdapter"], "properties": {"ownerAdapter": {"const": "providers"}}},
            "else": {"not": {"required": ["ownerAdapter"]}}
          },
          {
            "if": {"properties": {"kind": {"const": "instrument"}}, "required": ["kind"]},
            "then": {"required": ["guide"], "properties": {"guide": {"type": "string"}, "catalog": false}},
            "else": {"required": ["catalog"], "properties": {"catalog": {"type": "string"}, "guide": false}}
          }
        ]
      }
    },
    "effectiveCanonicalization": {
      "type": "object",
      "description": "How every exchanged timestamp is normalised. A silent typo here changes a normative contract, so the shape is closed and the two mechanical fields are enumerated.",
      "additionalProperties": false,
      "required": [
        "scope",
        "precision",
        "rounding",
        "epoch",
        "offsetPolicy"
      ],
      "properties": {
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "precision": {
          "enum": [
            "second",
            "millisecond",
            "microsecond"
          ]
        },
        "rounding": {
          "enum": [
            "half-even",
            "half-up",
            "truncate"
          ]
        },
        "epoch": {
          "const": "1970-01-01T00:00:00Z"
        },
        "offsetPolicy": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "measurements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/measurement"
      }
    }
  },
  "$defs": {
    "status": {
      "enum": [
        "supported",
        "mapped-standard",
        "platform-exclusive",
        "unmodeled",
        "deferred",
        "intentionally-unsupported"
      ]
    },
    "coding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system",
        "code"
      ],
      "properties": {
        "system": {
          "type": "string",
          "format": "uri"
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "display": {
          "type": "string",
          "minLength": 1
        },
        "definition": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "requiredCoding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slice",
        "system",
        "code"
      ],
      "properties": {
        "slice": {
          "type": "string",
          "pattern": "^[a-z][A-Za-z0-9]*$"
        },
        "system": {
          "type": "string",
          "format": "uri"
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "display": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "numericBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "inclusive"
      ],
      "properties": {
        "value": {
          "type": "number"
        },
        "inclusive": {
          "type": "boolean"
        }
      }
    },
    "quantityValueDomain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum",
        "integerOnly"
      ],
      "properties": {
        "minimum": {
          "$ref": "#/$defs/numericBoundary"
        },
        "maximum": {
          "$ref": "#/$defs/numericBoundary"
        },
        "integerOnly": {
          "type": "boolean"
        }
      }
    },
    "quantity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system",
        "code",
        "unit",
        "example",
        "dimension"
      ],
      "properties": {
        "system": {
          "const": "http://unitsofmeasure.org"
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "example": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "A physiologically plausible value, so a generated example never reads as a placeholder."
        },
        "dimension": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "m": {"type": "integer"},
            "s": {"type": "integer"},
            "g": {"type": "integer"},
            "K": {"type": "integer"},
            "C": {"type": "integer"}
          }
        },
        "valueDomain": {
          "$ref": "#/$defs/quantityValueDomain"
        },
        "unitMustSupport": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "code": {
                "const": "%"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "required": [
              "valueDomain"
            ],
            "properties": {
              "example": {
                "type": "number",
                "maximum": 100
              },
              "valueDomain": {
                "allOf": [
                  {
                    "$ref": "#/$defs/quantityValueDomain"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "minimum": {
                        "const": { "value": 0, "inclusive": true }
                      },
                      "maximum": {
                        "const": { "value": 100, "inclusive": true }
                      },
                      "integerOnly": {
                        "const": false
                      }
                    },
                    "required": [
                      "minimum",
                      "maximum",
                      "integerOnly"
                    ]
                  }
                ]
              }
            }
          }
        }
      ]
    },
    "resultCode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "display"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "display": {
          "type": "string",
          "minLength": 1
        },
        "definition": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "component": {
      "type": "object",
      "required": [
        "id",
        "system",
        "code"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9-]*$"
        },
        "system": {
          "type": "string",
          "format": "uri"
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "display": {
          "type": "string",
          "minLength": 1
        },
        "quantity": {
          "$ref": "#/$defs/quantity"
        },
        "valueSet": {
          "type": "string",
          "format": "uri"
        },
        "resultCodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resultCode"
          }
        },
        "cardinality": {
          "type": "string",
          "pattern": "^[0-9]+\\.\\.([0-9]+|\\*)$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "definition": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "profile",
        "standardProfile",
        "title",
        "description",
        "code",
        "valueKind",
        "quantity",
        "effective",
        "generation",
        "coverage"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "profile": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "standardProfile": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "enum": [
            "mobile",
            "healthkit",
            "health-connect",
            "providers",
            "withings",
            "oura",
            "google-health"
          ]
        },
        "code": {
          "$ref": "#/$defs/coding"
        },
        "requiredCodings": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/requiredCoding"
          }
        },
        "category": {
          "$ref": "#/$defs/coding"
        },
        "valueKind": {
          "enum": [
            "quantity",
            "codeableConcept",
            "dateTime",
            "components",
            "grouping"
          ]
        },
        "quantity": {
          "oneOf": [
            {
              "$ref": "#/$defs/quantity"
            },
            {
              "type": "null"
            }
          ]
        },
        "effective": {
          "enum": [
            "Period",
            "dateTime",
            "dateTime-or-Period"
          ]
        },
        "forbiddenElements": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "specimen"
            ]
          }
        },
        "generation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "emit"
          ],
          "properties": {
            "emit": {
              "type": "boolean"
            }
          }
        },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["healthkit", "health-connect", "sensorkit", "google-health-api", "oura", "withings", "questionnaire"],
          "properties": {
            "healthkit": {"$ref": "#/$defs/status"},
            "health-connect": {"$ref": "#/$defs/status"},
            "sensorkit": {"$ref": "#/$defs/status"},
            "google-health-api": {"$ref": "#/$defs/status"},
            "oura": {"$ref": "#/$defs/status"},
            "withings": {"$ref": "#/$defs/status"},
            "questionnaire": {"$ref": "#/$defs/status"}
          }
        },
        "coverageDetails": {
          "type": "object",
          "description": "Per-source notes explaining a coverage status that needs more than its label.",
          "additionalProperties": false,
          "properties": {
            "healthkit": {"$ref": "#/$defs/coverageDetail"},
            "health-connect": {"$ref": "#/$defs/coverageDetail"},
            "sensorkit": {"$ref": "#/$defs/coverageDetail"},
            "google-health-api": {"$ref": "#/$defs/coverageDetail"},
            "oura": {"$ref": "#/$defs/coverageDetail"},
            "withings": {"$ref": "#/$defs/coverageDetail"}
          }
        },
        "valueSet": {
          "type": "string",
          "format": "uri"
        },
        "resultCodeSystem": {
          "type": "string",
          "format": "uri"
        },
        "allowedValues": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "resultCodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/resultCode"
          }
        },
        "method": {
          "$ref": "#/$defs/resultCode"
        },
        "methodChoice": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string"
          }
        },
        "components": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/component"
          }
        },
        "hasMember": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "obeys": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exampleMembers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Literal references a grouping measurement's example carries as members."
        },
        "example": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "valueKind": {
                "const": "codeableConcept"
              },
              "exampleMembers": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Literal references a grouping measurement's example carries as members."
              }
            },
            "required": [
              "valueKind"
            ]
          },
          "then": {
            "required": [
              "valueSet"
            ],
            "properties": {
              "valueSet": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "valueKind": {
                "const": "components"
              },
              "exampleMembers": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Literal references a grouping measurement's example carries as members."
              }
            },
            "required": [
              "valueKind"
            ]
          },
          "then": {
            "required": [
              "components"
            ],
            "properties": {
              "components": {
                "type": "array"
              }
            }
          }
        },
        {
          "if": {"properties": {"valueKind": {"const": "quantity"}}, "required": ["valueKind"]},
          "then": {"properties": {"quantity": {"$ref": "#/$defs/quantity"}}},
          "else": {"properties": {"quantity": {"type": "null"}}}
        },
        {
          "$comment": "Observation-based extraction has only QuestionnaireResponse.authored to offer, so a measurement whose profile demands a Period can never carry questionnaire coverage.",
          "if": {
            "properties": {"coverage": {"type": "object", "properties": {"questionnaire": {"const": "supported"}}, "required": ["questionnaire"]}},
            "required": ["coverage"]
          },
          "then": {"properties": {"effective": {"enum": ["dateTime", "dateTime-or-Period"]}}}
        }
      ]
    },
    "coverageDetail": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceTokens", "alternateRepresentation", "reason"],
      "properties": {
        "sourceTokens": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "alternateRepresentation": {"type": "string", "format": "uri"},
        "reason": {"type": "string", "minLength": 1}
      }
    }
  }
}
