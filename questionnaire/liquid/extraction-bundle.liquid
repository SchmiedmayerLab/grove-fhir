<div class="panel panel-default">
  <div class="panel-heading">
    <strong>Resulting Grove exchange Bundle</strong>
  </div>
  <div class="panel-body">
    <p>
      This Grove Mobile collection Bundle represents the completed exchange after
      projection. It is distinct from the transaction Bundle returned directly by
      SDC <code>$extract</code>.
    </p>
    <dl class="dl-horizontal">
      <dt>Bundle type</dt>
      <dd><code>{{ $this.type }}</code></dd>
      <dt>Event identifier</dt>
      <dd><code>{{ $this.identifier.value }}</code></dd>
      <dt>Bundle timestamp</dt>
      <dd><code>{{ $this.timestamp }}</code></dd>
      <dt>Entries</dt>
      <dd>{{ $this.entry.count() }}</dd>
    </dl>
  </div>
  <div class="table-responsive">
    <table class="table table-striped table-condensed">
      <caption class="sr-only">Resources in the resulting Grove exchange Bundle</caption>
      <thead>
        <tr>
          <th scope="col">Entry</th>
          <th scope="col">FHIR resource</th>
          <th scope="col">Role in this exchange</th>
          <th scope="col">Declared profile</th>
          <th scope="col">Entry fullUrl</th>
        </tr>
      </thead>
      <tbody>
      {% for entry in $this.entry %}
        <tr>
          <th scope="row">{{ forloop.index }}</th>
          <td>
            <code>{{ entry.resource.resourceType }}{% if entry.resource.id %}/{{ entry.resource.id }}{% endif %}</code>
          </td>
          <td>
            {% if entry.resource.resourceType = 'Patient' %}Subject of the response and projected measurements.{% endif %}
            {% if entry.resource.resourceType = 'QuestionnaireResponse' %}Source response from which the measurements were extracted.{% endif %}
            {% if entry.resource.resourceType = 'Device' %}Event-time snapshot of the capturing application or its host.{% endif %}
            {% if entry.resource.resourceType = 'Observation' %}
              Projected measurement
              {% for coding in entry.resource.code.coding %}
                {% if coding.display %}: {{ coding.display }} (<code>{{ coding.code }}</code>){% endif %}
              {% endfor %}
            {% endif %}
            {% if entry.resource.resourceType = 'Provenance' %}Record of the response-to-FHIR transformation.{% endif %}
          </td>
          <td>
          {% if entry.resource.meta.profile %}
            {% for profile in entry.resource.meta.profile %}
              <code>{{ profile }}</code><br />
            {% endfor %}
          {% else %}
            Base FHIR R4 resource
          {% endif %}
          </td>
          <td><code>{{ entry.fullUrl }}</code></td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
</div>
