<div class="panel panel-default">
  <div class="panel-heading">
    <strong>QuestionnaireResponse: Home Vitals</strong>
  </div>
  <div class="panel-body">
    <dl class="dl-horizontal">
      <dt>Questionnaire</dt>
      <dd><code>{{ $this.questionnaire }}</code></dd>
      <dt>Status</dt>
      <dd><code>{{ $this.status }}</code></dd>
      <dt>Subject</dt>
      <dd><code>{{ $this.subject.reference }}</code></dd>
      <dt>Author</dt>
      <dd><code>{{ $this.author.reference }}</code></dd>
      <dt>Authored</dt>
      <dd><code>{{ $this.authored }}</code></dd>
    </dl>
  </div>
  <div class="table-responsive">
    <table class="table table-striped table-condensed">
      <caption class="sr-only">Questionnaire response items and answers</caption>
      <thead>
        <tr>
          <th scope="col">Response item</th>
          <th scope="col">Answer</th>
          <th scope="col">FHIR representation</th>
        </tr>
      </thead>
      <tbody>
      {% for item in $this.item %}
        {% if item.answer %}
          {% for answer in item.answer %}
          <tr>
            <th scope="row"><code>{{ item.linkId }}</code></th>
            <td>
              {% if answer.valueQuantity %}{{ answer.valueQuantity.value }} {{ answer.valueQuantity.unit }}{% endif %}
              {% if answer.valueInteger %}{{ answer.valueInteger }}{% endif %}
            </td>
            <td>
              {% if answer.valueQuantity %}<code>valueQuantity</code> with UCUM <code>{{ answer.valueQuantity.code }}</code>{% endif %}
              {% if answer.valueInteger %}<code>valueInteger</code>{% endif %}
            </td>
          </tr>
          {% endfor %}
        {% else %}
          <tr>
            <th scope="row"><code>{{ item.linkId }}</code></th>
            <td colspan="2"><em>Group</em></td>
          </tr>
        {% endif %}
        {% for child in item.item %}
          {% for answer in child.answer %}
          <tr>
            <th scope="row"><span class="sr-only">Child item: </span><span aria-hidden="true">&#8627;&nbsp;</span><code>{{ child.linkId }}</code></th>
            <td>
              {% if answer.valueQuantity %}{{ answer.valueQuantity.value }} {{ answer.valueQuantity.unit }}{% endif %}
              {% if answer.valueInteger %}{{ answer.valueInteger }}{% endif %}
            </td>
            <td>
              {% if answer.valueQuantity %}<code>valueQuantity</code> with UCUM <code>{{ answer.valueQuantity.code }}</code>{% endif %}
              {% if answer.valueInteger %}<code>valueInteger</code>{% endif %}
            </td>
          </tr>
          {% endfor %}
        {% endfor %}
      {% endfor %}
      </tbody>
    </table>
  </div>
  <div class="panel-body">
    <h5>Capturing application and host</h5>
    <dl class="dl-horizontal">
    {% for extension in $this.extension %}
      {% if extension.url = 'https://grovealliance.org/fhir/questionnaire/StructureDefinition/grove-questionnaire-writer-context' %}
        {% for fact in extension.extension %}
          <dt><code>{{ fact.url }}</code></dt>
          <dd>
            {% if fact.valueString %}{{ fact.valueString }}{% endif %}
            {% if fact.valueIdentifier %}<code>{{ fact.valueIdentifier.system }}|{{ fact.valueIdentifier.value }}</code>{% endif %}
          </dd>
        {% endfor %}
      {% endif %}
    {% endfor %}
    </dl>
  </div>
</div>
